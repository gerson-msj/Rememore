{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/api/index.ts",
    "host": "bun --hot src/api/index.ts --intranet",
    "build": "bun build ./src/web/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "build:pages": "bun build ./src/web/index.html --outdir=dist-pages --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --public-path=./",
    "build:server": "bun build --target=bun --production --outdir=dist/server ./src/api/index.ts",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "typecheck": "bun check"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "fake-indexeddb": "^6.2.8"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
