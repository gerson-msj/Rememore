@inject EstadoAutenticacaoProvider Autenticacao
@inject EstadoTema Tema

@if (!Autenticacao.Inicializado)
{
    <main class="estado-inicializacao" aria-busy="true" aria-label="Verificando sessão"></main>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <RotaComGuarda RouteData="@routeData" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (primeiroRender)
        {
            await Tema.InicializarAsync();
            await Autenticacao.InicializarAsync();
            StateHasChanged();
        }
    }
}
