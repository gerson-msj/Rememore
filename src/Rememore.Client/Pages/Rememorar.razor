@page "/rememorar"
@attribute [Authorize]
@inject NavigationManager Navegacao

<PageTitle>Rememorar</PageTitle>

<main class="pagina-rememorar">
    <CabecalhoAmbiente Titulo="Rememorar" MostrarRetorno AoRetornar="VoltarPrincipal" />

    <section class="rememorar-controles" aria-label="Período e ordenação">
        <div class="rememorar-controles__conteudo">
            <JanelaTemporal Modelo="@modelo" />
            <div class="rememorar-ordenacao">
                <span class="rememorar-ordenacao__rotulo">Ordenar por</span>
                <div class="rememorar-ordenacao__acoes" role="group" aria-label="Ordenar categorias">
                    <button type="button" class="rememorar-ordenacao__acao @(criterio == Criterio.Representatividade ? "rememorar-ordenacao__acao--ativa" : string.Empty)"
                            aria-pressed="@(criterio == Criterio.Representatividade ? "true" : "false")"
                            @onclick="() => criterio = Criterio.Representatividade">Representatividade @(criterio == Criterio.Representatividade ? "+" : string.Empty)</button>
                    <button type="button" class="rememorar-ordenacao__acao @(criterio == Criterio.Tom ? "rememorar-ordenacao__acao--ativa" : string.Empty)"
                            aria-pressed="@(criterio == Criterio.Tom ? "true" : "false")"
                            @onclick="AlternarTom">Tom @IndicadorTom</button>
                </div>
            </div>
        </div>
    </section>

    <section class="rememorar-lista" aria-label="Categorias do panorama">
        <ul class="rememorar-lista__itens">
            @foreach (var categoria in amostras)
            {
                <li @key="categoria.Id">
                    <CategoriaPanorama Identificador="@categoria.Id" Nome="@categoria.Nome"
                                       Representatividade="@categoria.Representatividade" Tom="@categoria.Tom"
                                       RotuloTom="@categoria.RotuloTom" Aparencia="@AparenciaTom.ObterPrecisao(categoria.Tom)"
                                       AnimarApresentacao="true" AoSelecionar="SelecionarCategoria" />
                </li>
            }
        </ul>
        <p class="is-sr-only" aria-live="polite">@mensagemSelecao</p>
    </section>
</main>

@code {
    private readonly ModeloJanelaTemporal modelo = new(
    [
        new DateOnly(2025, 1, 2), new DateOnly(2025, 1, 5), new DateOnly(2025, 1, 12),
        new DateOnly(2025, 1, 19), new DateOnly(2025, 1, 26), new DateOnly(2025, 2, 2)
    ]);
    private readonly AmostraCategoria[] amostras =
    [
        new("rotina", "Rotina", 74, 1, "Tom positivo, 74"),
        new("projetos", "Projetos e ideias", -48, .82, "Tom negativo, menos 48"),
        new("familia", "Família", 61, .68, "Tom positivo, 61"),
        new("saude", "Saúde e bem-estar", 0, .54, "Tom neutro, 0"),
        new("estudos", "Estudos", -72, .43, "Tom negativo, menos 72"),
        new("criatividade", "Criatividade", 36, .32, "Tom positivo, 36"),
        new("casa", "Casa", null, .25, "Sem Tom definido"),
        new("amizades", "Amizades", 19, .18, "Tom positivo, 19"),
        new("financas", "Finanças", -25, .12, "Tom negativo, menos 25"),
        new("longa", "Uma categoria com um nome propositalmente longo para conferir truncamento e acesso ao rótulo completo", null, .07, "Sem Tom definido"),
        new("lazer", "Lazer", 88, .045, "Tom positivo, 88"),
        new("pausa", "Pausas", -8, .02, "Tom negativo, menos 8"),
        new("trabalho", "Trabalho", 42, .73, "Tom positivo, 42"),
        new("alimentacao", "Alimentação", -31, .61, "Tom negativo, menos 31"),
        new("leituras", "Leituras", 0, .52, "Tom neutro, 0"),
        new("viagens", "Viagens e lugares", 79, .46, "Tom positivo, 79"),
        new("conversas", "Conversas importantes", null, .39, "Sem Tom definido"),
        new("natureza", "Natureza", 55, .34, "Tom positivo, 55"),
        new("decisoes", "Decisões difíceis", -63, .28, "Tom negativo, menos 63"),
        new("aprendizado", "Aprendizado cotidiano", 24, .23, "Tom positivo, 24"),
        new("celebracoes", "Celebrações", 96, .17, "Tom positivo, 96"),
        new("mudancas", "Mudanças", -5, .11, "Tom negativo, menos 5"),
        new("planos", "Planos para o futuro", null, .06, "Sem Tom definido"),
        new("pequenas_coisas", "Pequenas coisas boas", 12, .035, "Tom positivo, 12")
    ];
    private Criterio criterio = Criterio.Representatividade;
    private SentidoTom sentidoTom = SentidoTom.Positivo;
    private string mensagemSelecao = "";
    private string IndicadorTom => sentidoTom switch { SentidoTom.Positivo => "+", SentidoTom.Negativo => "−", _ => "∅" };

    private void AlternarTom()
    {
        if (criterio != Criterio.Tom) { criterio = Criterio.Tom; sentidoTom = SentidoTom.Positivo; return; }
        sentidoTom = sentidoTom switch { SentidoTom.Positivo => SentidoTom.Negativo, SentidoTom.Negativo => SentidoTom.Nulo, _ => SentidoTom.Positivo };
    }

    private void SelecionarCategoria(string id) => mensagemSelecao = $"Categoria selecionada: {id}";
    private void VoltarPrincipal() => Navegacao.NavigateTo("principal");

    private sealed record AmostraCategoria(string Id, string Nome, double? Tom, double Representatividade, string RotuloTom);
    private enum Criterio { Representatividade, Tom }
    private enum SentidoTom { Positivo, Negativo, Nulo }
}
