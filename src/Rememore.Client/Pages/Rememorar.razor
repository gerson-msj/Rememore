@page "/rememorar"
@attribute [Authorize]
@using System.Globalization
@using Rememore.Client.Infraestrutura.Rememorar
@inject NavigationManager Navegacao
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject SincronizadorProjecaoPanorama Sincronizador

<PageTitle>Rememorar</PageTitle>

<main class="pagina-rememorar">
    <CabecalhoAmbiente Titulo="Rememorar" MostrarRetorno AoRetornar="VoltarPrincipal" />

    @if (carregando)
    {
        <p class="rememorar-estado" aria-busy="true" role="status">Preparando o Panorama…</p>
    }
    else if (falhaPreparacao)
    {
        <div class="notification elemento-falha-recuperavel rememorar-estado" role="alert" aria-atomic="true">
            <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <div class="elemento-falha-recuperavel__conteudo">
                <p class="elemento-falha-recuperavel__mensagem"><strong>Não foi possível preparar os dados do Panorama. Tente novamente.</strong></p>
                <button class="button is-link elemento-botao-com-icone mt-3" type="button" @onclick="PrepararAsync">
                    <span>Tentar novamente</span>
                </button>
            </div>
        </div>
    }
    else if (modelo is null)
    {
        <p class="rememorar-estado" role="status">Ainda não há dois dias preservados para formar um período.</p>
    }
    else
    {
        <section class="rememorar-controles" aria-label="Período e ordenação">
            <div class="rememorar-controles__conteudo">
                <JanelaTemporal Modelo="@modelo" TomPreciso="@resultado.TomMedioJanela" AoAtualizar="AtualizarPanoramaAsync" />
                <div class="rememorar-ordenacao">
                    <span class="rememorar-ordenacao__rotulo">Ordenar por</span>
                    <div class="rememorar-ordenacao__acoes" role="group" aria-label="Ordenar categorias">
                        <button type="button" class="rememorar-ordenacao__acao @(criterio == Criterio.Representatividade ? "rememorar-ordenacao__acao--ativa" : string.Empty)"
                                aria-pressed="@(criterio == Criterio.Representatividade ? "true" : "false")"
                                @onclick="() => criterio = Criterio.Representatividade">Representatividade @(criterio == Criterio.Representatividade ? "+" : string.Empty)</button>
                        <button type="button" class="rememorar-ordenacao__acao @(criterio == Criterio.Tom ? "rememorar-ordenacao__acao--ativa" : string.Empty)"
                                aria-pressed="@(criterio == Criterio.Tom ? "true" : "false")"
                                @onclick="AlternarTom">Tom @IndicadorTom</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="rememorar-lista" aria-label="Categorias do panorama">
            @if (resultado.Categorias.Count == 0)
            {
                <p role="status">Nenhuma categoria possui associações neste período.</p>
            }
            else
            {
                <ul class="rememorar-lista__itens">
                    @foreach (var categoria in resultado.Categorias)
                    {
                        <li @key="categoria.Identidade">
                            <CategoriaPanorama Identificador="@categoria.Identidade" Nome="@categoria.Nome"
                                               Representatividade="@categoria.Representatividade" Tom="@categoria.TomMedio"
                                               RotuloTom="@RotuloTom(categoria.TomMedio)" Aparencia="@AparenciaTom.ObterPrecisao(categoria.TomMedio)"
                                               AnimarApresentacao="true" AoSelecionar="SelecionarCategoria" />
                        </li>
                    }
                </ul>
            }
            <p class="is-sr-only" aria-live="polite">@mensagemSelecao</p>
        </section>
    }
</main>

@code {
    private readonly CultureInfo culturaPtBr = CultureInfo.GetCultureInfo("pt-BR");
    private IReadOnlyList<BlocoDiaPanoramaRemoto> dias = [];
    private IReadOnlyList<Rememore.Client.Infraestrutura.Categorias.CategoriaPreservadaRemota> categoriasCatalogo = [];
    private ModeloJanelaTemporal? modelo;
    private ResultadoCalculoPanorama resultado = new([], null);
    private IntervaloJanelaTemporal? intervaloCalculado;
    private bool carregando = true;
    private bool falhaPreparacao;
    private Criterio criterio = Criterio.Representatividade;
    private SentidoTom sentidoTom = SentidoTom.Positivo;
    private string mensagemSelecao = string.Empty;
    private string IndicadorTom => sentidoTom switch { SentidoTom.Positivo => "+", SentidoTom.Negativo => "−", _ => "∅" };

    protected override async Task OnInitializedAsync() => await PrepararAsync();

    private async Task PrepararAsync()
    {
        carregando = true;
        falhaPreparacao = false;
        modelo = null;
        dias = [];
        categoriasCatalogo = [];
        resultado = new([], null);

        try
        {
            if (EstadoAutenticacao.IdentidadeConta is not { } identidadeConta)
            {
                falhaPreparacao = true;
                return;
            }

            var preparacao = await Sincronizador.PrepararAsync(identidadeConta);
            if (!preparacao.Disponivel)
            {
                falhaPreparacao = true;
                return;
            }

            dias = preparacao.Dias.OrderBy(dia => dia.Data, StringComparer.Ordinal).ToArray();
            categoriasCatalogo = preparacao.Categorias;
            var datas = dias.Select(dia => DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture)).ToArray();
            if (datas.Length < 2) return;

            modelo = new ModeloJanelaTemporal(datas);
            intervaloCalculado = null;
            AtualizarResultado(modelo.Estado.IntervaloValidoAtual);
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException or ArgumentException)
        {
            falhaPreparacao = true;
        }
        finally
        {
            carregando = false;
        }
    }

    private Task AtualizarPanoramaAsync()
    {
        AtualizarResultado(modelo?.Estado.IntervaloValidoAtual);
        return Task.CompletedTask;
    }

    private void AtualizarResultado(IntervaloJanelaTemporal? intervalo)
    {
        if (intervalo is null || intervalo == intervaloCalculado) return;
        resultado = CalculosPanorama.Calcular(dias, categoriasCatalogo, intervalo.DataInicio, intervalo.DataFim);
        intervaloCalculado = intervalo;
    }

    private void AlternarTom()
    {
        if (criterio != Criterio.Tom) { criterio = Criterio.Tom; sentidoTom = SentidoTom.Positivo; return; }
        sentidoTom = sentidoTom switch { SentidoTom.Positivo => SentidoTom.Negativo, SentidoTom.Negativo => SentidoTom.Nulo, _ => SentidoTom.Positivo };
    }

    private void SelecionarCategoria(string id) => mensagemSelecao = $"Categoria selecionada: {id}";
    private void VoltarPrincipal() => Navegacao.NavigateTo("principal");

    private string RotuloTom(double? tom)
    {
        if (!tom.HasValue) return "Sem Tom definido";
        var valor = tom.Value.ToString("0.##", culturaPtBr);
        return $"Tom médio, {(tom.Value > 0 ? "+" : string.Empty)}{valor}";
    }

    private enum Criterio { Representatividade, Tom }
    private enum SentidoTom { Positivo, Negativo, Nulo }
}
