@page "/rememorar"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using Microsoft.JSInterop
@using Rememore.Client.Infraestrutura.Rememorar
@inject NavigationManager Navegacao
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject SincronizadorProjecaoPanorama Sincronizador
@inject IJSRuntime JS
@inject IWebAssemblyHostEnvironment Ambiente
@implements IAsyncDisposable

<PageTitle>Rememorar</PageTitle>

<main class="pagina-rememorar">
    <CabecalhoAmbiente Titulo="Rememorar" MostrarRetorno AoRetornar="VoltarPrincipal" />

    @if (MostrarControlesCenarioE4)
    {
        <section class="container mt-4" aria-label="Cenário temporário de validação">
            <div class="notification is-info is-light">
                <p><strong>Cenário temporário da E4</strong></p>
                @if (!string.IsNullOrWhiteSpace(mensagemCenarioE4))
                {
                    <p>@mensagemCenarioE4</p>
                }
                @if (carregandoCenarioE4)
                {
                    <p role="status" aria-busy="true">Preparando cenário…</p>
                }
                else if (statusCenarioE4 is { Quantidade: > 0 } status)
                {
                    <p>O pool: @status.Quantidade memórias, @status.DataInicio–@status.DataFim.</p>
                    <button class="button is-danger is-light mt-2" type="button" @onclick="RemoverCenarioE4Async">
                        Remover cenário de teste
                    </button>
                }
                else
                {
                    <button class="button is-link is-light mt-2" type="button" @onclick="PrepararCenarioE4Async">
                        Preparar 75 memórias de teste
                    </button>
                }
            </div>
        </section>
    }

    @if (carregando)
    {
        <p class="rememorar-estado" aria-busy="true" role="status">Preparando o Panorama…</p>
    }
    else if (falhaPreparacao)
    {
        <div class="notification elemento-falha-recuperavel rememorar-estado" role="alert" aria-atomic="true">
            <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <div class="elemento-falha-recuperavel__conteudo">
                <p class="elemento-falha-recuperavel__mensagem"><strong>Não foi possível preparar os dados do Panorama. Tente novamente.</strong></p>
                <button class="button is-link elemento-botao-com-icone mt-3" type="button" @onclick="PrepararAsync">
                    <span>Tentar novamente</span>
                </button>
            </div>
        </div>
    }
    else if (modelo is null)
    {
        <p class="rememorar-estado" role="status">@mensagemAcervoIndisponivel</p>
    }
    else
    {
        <section class="rememorar-controles" aria-label="Período e ordenação">
            <div class="rememorar-controles__conteudo">
                <JanelaTemporal Modelo="@modelo" TomPreciso="@resultado.TomMedioJanela" AoAtualizar="AtualizarPanoramaAsync" />
                <ControlesOrdenacaoPanorama Estado="@ordenacao" AoAlterar="AlterarOrdenacaoAsync" />
            </div>
        </section>

        <section class="rememorar-lista" aria-label="Categorias do panorama">
            @if (resultado.Categorias.Count == 0)
            {
                <p role="status">Nenhuma categoria possui associações neste período.</p>
            }
            else
            {
                <ul @ref="raizCategorias" class="rememorar-lista__itens">
                    @foreach (var categoria in categoriasOrdenadas)
                    {
                        <li @key="categoria.Identidade" data-categoria-id="@categoria.Identidade">
                            <CategoriaPanorama Identificador="@categoria.Identidade" Nome="@categoria.Nome"
                                               Representatividade="@categoria.Representatividade" Tom="@categoria.TomMedio"
                                               RotuloTom="@RotuloTom(categoria.TomMedio)" Aparencia="@AparenciaTom.ObterPrecisao(categoria.TomMedio, limiar: 20, intensidadeNoLimiar: 50)"
                                               AnimarApresentacao="true" AoSelecionar="SelecionarCategoria" />
                        </li>
                    }
                </ul>
            }
            <p class="is-sr-only" aria-live="polite">@mensagemSelecao</p>
        </section>
    }
</main>

@code {
    private readonly CultureInfo culturaPtBr = CultureInfo.GetCultureInfo("pt-BR");
    private IReadOnlyList<BlocoDiaPanoramaRemoto> dias = [];
    private IReadOnlyList<Rememore.Client.Infraestrutura.Categorias.CategoriaPreservadaRemota> categoriasCatalogo = [];
    private ModeloJanelaTemporal? modelo;
    private ResultadoCalculoPanorama resultado = new([], null);
    private IntervaloJanelaTemporal? intervaloCalculado;
    private EstadoOrdenacaoPanorama ordenacao = EstadoOrdenacaoPanorama.Inicial;
    private IJSObjectReference? moduloEstado;
    private IJSObjectReference? moduloCenarioE4;
    private IJSObjectReference? moduloLista;
    private IJSObjectReference? controladorLista;
    private ElementReference raizCategorias;
    private bool animacaoListaPendente;
    private string? identidadeContaAtual;
    private ContextoJornadaPanorama? contextoRestaurado;
    private string? categoriaSelecionada;
    private string mensagemAcervoIndisponivel = "Rememorar ficará disponível quando houver pelo menos dois dias preservados e duas categorias distintas.";
    private bool rolagemConectada;
    private bool rolagemRestaurada;
    private bool sessaoEncerrada;
    private bool carregando = true;
    private bool falhaPreparacao;
    private bool carregandoCenarioE4;
    private string mensagemSelecao = string.Empty;
    private string? mensagemCenarioE4;
    private StatusCenarioPoolE4? statusCenarioE4;
    private IReadOnlyList<CategoriaPanoramaCalculada> categoriasOrdenadas => OrdenacaoPanorama.Ordenar(resultado.Categorias, ordenacao);
    private bool MostrarControlesCenarioE4 => Ambiente.IsDevelopment()
        && new Uri(Navegacao.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("testeE4=pool", StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        EstadoAutenticacao.AuthenticationStateChanged += AoMudarAutenticacao;
        await PrepararAsync();
        if (MostrarControlesCenarioE4)
            await AtualizarStatusCenarioE4Async();
    }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (primeiroRender)
        {
            await GarantirModuloEstadoAsync();
            if (identidadeContaAtual is not null)
            {
                await moduloEstado!.InvokeVoidAsync("conectarRolagem", identidadeContaAtual, EstadoAutenticacao.IdentidadeSessao);
                rolagemConectada = true;
            }
        }

        if (controladorLista is null && modelo is not null && resultado.Categorias.Count > 0)
        {
            moduloLista = await JS.InvokeAsync<IJSObjectReference>("import", "./js/listaPanorama.js?cmp009=1");
            controladorLista = await moduloLista.InvokeAsync<IJSObjectReference>("conectar", raizCategorias);
        }

        if (animacaoListaPendente && controladorLista is not null)
        {
            animacaoListaPendente = false;
            await controladorLista.InvokeVoidAsync("aplicar", true, false, 180);
        }

        if (!rolagemRestaurada && !carregando && modelo is not null && contextoRestaurado is not null
            && moduloEstado is not null && rolagemConectada)
        {
            await moduloEstado.InvokeVoidAsync("restaurarRolagem", identidadeContaAtual, contextoRestaurado.Rolagem);
            rolagemRestaurada = true;
        }
    }

    private async Task PrepararAsync()
    {
        carregando = true;
        falhaPreparacao = false;
        modelo = null;
        dias = [];
        categoriasCatalogo = [];
        resultado = new([], null);
        intervaloCalculado = null;

        try
        {
            if (EstadoAutenticacao.IdentidadeConta is not { } identidadeConta)
            {
                identidadeContaAtual = EstadoAutenticacaoProvider.IdentidadeContaSimulada;
                await LimparContextoJornadaAsync(true);
                falhaPreparacao = true;
                return;
            }

            identidadeContaAtual = identidadeConta;
            await GarantirModuloEstadoAsync();
            ordenacao = await moduloEstado!.InvokeAsync<EstadoOrdenacaoPanorama?>("lerOrdenacao", identidadeConta)
                ?? EstadoOrdenacaoPanorama.Inicial;
            if (!ordenacao.Valido) ordenacao = EstadoOrdenacaoPanorama.Inicial;
            var identidadeSessao = EstadoAutenticacao.IdentidadeSessao;
            contextoRestaurado = await moduloEstado!.InvokeAsync<ContextoJornadaPanorama?>("lerContexto", identidadeConta, identidadeSessao);
            if (contextoRestaurado is not null && contextoRestaurado.Versao == 1
                && contextoRestaurado.IdentidadeConta == identidadeConta
                && contextoRestaurado.IdentidadeSessao == identidadeSessao)
            {
                categoriaSelecionada = contextoRestaurado.CategoriaSelecionada;
                if (categoriaSelecionada is not null)
                    mensagemSelecao = $"Categoria selecionada: {categoriaSelecionada}";
            }
            else contextoRestaurado = null;

            var preparacao = await Sincronizador.PrepararAsync(identidadeConta);
            if (!preparacao.Disponivel)
            {
                falhaPreparacao = true;
                return;
            }

            dias = preparacao.Dias.OrderBy(dia => dia.Data, StringComparer.Ordinal).ToArray();
            categoriasCatalogo = preparacao.Categorias;
            var datas = dias.Select(dia => DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture)).ToArray();
            if (datas.Length < 2 || !CalculosPanorama.AcervoDisponivel(dias))
            {
                mensagemAcervoIndisponivel = "Rememorar ficará disponível quando houver pelo menos dois dias preservados e duas categorias distintas.";
                contextoRestaurado = null;
                await LimparContextoJornadaAsync();
                return;
            }

            modelo = CriarModelo(datas, contextoRestaurado);
            AtualizarResultado(modelo.Estado.IntervaloValidoAtual ?? modelo.Estado.UltimoIntervaloValido);
            if (contextoRestaurado is null)
                await PersistirContextoAsync();
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException or ArgumentException)
        {
            falhaPreparacao = true;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task AtualizarStatusCenarioE4Async()
    {
        try
        {
            await GarantirModuloCenarioE4Async();
            if (EstadoAutenticacao.IdentidadeConta is { } identidadeConta)
                statusCenarioE4 = await moduloCenarioE4!.InvokeAsync<StatusCenarioPoolE4>("statusCenarioPoolE4", identidadeConta);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            mensagemCenarioE4 = "Não foi possível consultar o estado do cenário local.";
        }
    }

    private async Task PrepararCenarioE4Async()
    {
        if (carregandoCenarioE4 || EstadoAutenticacao.IdentidadeConta is not { } identidadeConta) return;
        carregandoCenarioE4 = true;
        mensagemCenarioE4 = null;
        StateHasChanged();
        try
        {
            await GarantirModuloCenarioE4Async();
            statusCenarioE4 = await moduloCenarioE4!.InvokeAsync<StatusCenarioPoolE4>("prepararCenarioPoolE4", identidadeConta);
            await PrepararAsync();
            await AtualizarStatusCenarioE4Async();
            mensagemCenarioE4 = "Cenário pronto. Abra O pool para testar o detalhe.";
            Navegacao.NavigateTo("/rememorar", replace: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            mensagemCenarioE4 = "Não foi possível preparar o cenário temporário.";
        }
        finally { carregandoCenarioE4 = false; }
    }

    private async Task RemoverCenarioE4Async()
    {
        if (carregandoCenarioE4 || EstadoAutenticacao.IdentidadeConta is not { } identidadeConta) return;
        carregandoCenarioE4 = true;
        mensagemCenarioE4 = null;
        StateHasChanged();
        try
        {
            await GarantirModuloCenarioE4Async();
            var resultado = await moduloCenarioE4!.InvokeAsync<ResultadoRemocaoCenarioE4>("removerCenarioPoolE4", identidadeConta);
            await PrepararAsync();
            statusCenarioE4 = await moduloCenarioE4!.InvokeAsync<StatusCenarioPoolE4>("statusCenarioPoolE4", identidadeConta);
            mensagemCenarioE4 = $"Cenário removido: {resultado.Quantidade} memórias de teste.";
            Navegacao.NavigateTo("/rememorar", replace: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            mensagemCenarioE4 = "Não foi possível remover o cenário temporário.";
        }
        finally { carregandoCenarioE4 = false; }
    }

    private async Task GarantirModuloCenarioE4Async()
    {
        moduloCenarioE4 ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/autoridadeCapturaFake.js?e3=1");
    }

    private async Task AtualizarPanoramaAsync()
    {
        await PrepararAnimacaoListaAsync();
        AtualizarResultado(modelo?.Estado.IntervaloValidoAtual);
        await PersistirContextoAsync();
    }

    private void AtualizarResultado(IntervaloJanelaTemporal? intervalo)
    {
        if (intervalo is null || intervalo == intervaloCalculado) return;
        resultado = CalculosPanorama.Calcular(dias, categoriasCatalogo, intervalo.DataInicio, intervalo.DataFim);
        intervaloCalculado = intervalo;
    }

    private async Task AlterarOrdenacaoAsync(string criterio)
    {
        await PrepararAnimacaoListaAsync();
        ordenacao = criterio == "Representatividade"
            ? ordenacao.AlternarRepresentatividade()
            : ordenacao.AlternarTom();
        await PersistirOrdenacaoAsync();
    }

    private async Task PersistirOrdenacaoAsync()
    {
        if (identidadeContaAtual is not null && moduloEstado is not null)
            await moduloEstado.InvokeVoidAsync("gravarOrdenacao", identidadeContaAtual, ordenacao);
    }

    private async Task PrepararAnimacaoListaAsync()
    {
        if (controladorLista is null) return;
        try
        {
            await controladorLista.InvokeVoidAsync("capturar");
            animacaoListaPendente = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
    }

    private async Task PersistirContextoAsync()
    {
        if (sessaoEncerrada || identidadeContaAtual is null || moduloEstado is null || modelo is null) return;
        var estado = modelo.Estado;
        var ultimoIntervalo = estado.UltimoIntervaloValido;
        var identidadeSessao = EstadoAutenticacao.IdentidadeSessao;
        if (identidadeSessao is null) return;
        var contexto = new ContextoJornadaPanorama(1, identidadeContaAtual, identidadeSessao,
            estado.PosicaoInicio, estado.PosicaoFim,
            ultimoIntervalo?.DataInicio.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ultimoIntervalo?.DataFim.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            categoriaSelecionada);
        await moduloEstado.InvokeVoidAsync("gravarContexto", identidadeContaAtual, identidadeSessao, contexto);
    }

    private async Task SelecionarCategoria(string id)
    {
        categoriaSelecionada = id;
        mensagemSelecao = $"Categoria selecionada: {id}";
        var identidadeSessao = EstadoAutenticacao.IdentidadeSessao;
        if (identidadeContaAtual is not null && identidadeSessao is not null)
        {
            await GarantirModuloEstadoAsync();
            await moduloEstado!.InvokeVoidAsync("gravarRolagemImediata", identidadeContaAtual, identidadeSessao);
        }
        await PersistirContextoAsync();
        Navegacao.NavigateTo($"/rememorar/categoria/{Uri.EscapeDataString(id)}");
    }

    private async Task VoltarPrincipal()
    {
        await LimparContextoJornadaAsync(true);
        Navegacao.NavigateTo("principal");
    }

    private ModeloJanelaTemporal CriarModelo(IReadOnlyList<DateOnly> datas, ContextoJornadaPanorama? contexto)
    {
        EstadoJanelaTemporalRestaurado? restauracao = null;
        if (contexto is not null && contexto.Versao == 1 && contexto.IdentidadeConta == identidadeContaAtual
            && contexto.IdentidadeSessao == EstadoAutenticacao.IdentidadeSessao
            && double.IsFinite(contexto.PosicaoInicio) && double.IsFinite(contexto.PosicaoFim)
            && contexto.PosicaoInicio is >= 0 and <= 1 && contexto.PosicaoFim is >= 0 and <= 1
            && contexto.PosicaoInicio <= contexto.PosicaoFim)
        {
            IntervaloJanelaTemporal? ultimo = null;
            if (DateOnly.TryParseExact(contexto.UltimaDataInicio, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var inicio)
                && DateOnly.TryParseExact(contexto.UltimaDataFim, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fim))
            {
                var indiceInicio = Array.IndexOf(datas.ToArray(), inicio);
                var indiceFim = Array.IndexOf(datas.ToArray(), fim);
                if (indiceInicio >= 0 && indiceFim > indiceInicio)
                    ultimo = new(indiceInicio, indiceFim, inicio, fim);
            }
            restauracao = new(contexto.PosicaoInicio, contexto.PosicaoFim, ultimo);
        }
        return new ModeloJanelaTemporal(datas, restauracao);
    }

    private void AoMudarAutenticacao(Task<AuthenticationState> tarefaEstado)
    {
        _ = LimparJornadaSeAnonimaAsync(tarefaEstado);
    }

    private async Task LimparJornadaSeAnonimaAsync(Task<AuthenticationState> tarefaEstado)
    {
        try
        {
            var estado = await tarefaEstado;
            if (estado.User.Identity?.IsAuthenticated != true)
                await LimparContextoJornadaAsync(true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task LimparContextoJornadaAsync(bool encerrarSessao = false)
    {
        sessaoEncerrada |= encerrarSessao;
        if (identidadeContaAtual is null) return;
        try
        {
            await GarantirModuloEstadoAsync();
            await moduloEstado!.InvokeVoidAsync("removerContexto", identidadeContaAtual);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task GarantirModuloEstadoAsync()
    {
        moduloEstado ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/estadoRememorar.js");
    }

    private string RotuloTom(double? tom)
    {
        if (!tom.HasValue) return "Sem Tom definido";
        var valor = tom.Value.ToString("0.##", culturaPtBr);
        return $"Tom médio, {(tom.Value > 0 ? "+" : string.Empty)}{valor}";
    }

    public async ValueTask DisposeAsync()
    {
        EstadoAutenticacao.AuthenticationStateChanged -= AoMudarAutenticacao;
        if (controladorLista is not null)
        {
            try { await controladorLista.InvokeVoidAsync("descartar"); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
            try { await controladorLista.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }
        if (moduloLista is not null)
        {
            try { await moduloLista.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }
        if (moduloEstado is not null)
        {
            if (rolagemConectada && identidadeContaAtual is not null)
            {
                try { await moduloEstado.InvokeVoidAsync("desconectarRolagem", identidadeContaAtual); }
                catch (JSDisconnectedException) { }
            }
            await moduloEstado.DisposeAsync();
        }
        if (moduloCenarioE4 is not null)
        {
            try { await moduloCenarioE4.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }
    }

    private sealed record ContextoJornadaPanorama(
        int Versao, string IdentidadeConta, string IdentidadeSessao, double PosicaoInicio, double PosicaoFim,
        string? UltimaDataInicio, string? UltimaDataFim, string? CategoriaSelecionada,
        double Rolagem = 0);

    private sealed record StatusCenarioPoolE4(
        int Quantidade, string? DataInicio, string? DataFim, string? IdentidadeCategoria, bool JaExistia = false);

    private sealed record ResultadoRemocaoCenarioE4(int Quantidade);
}
