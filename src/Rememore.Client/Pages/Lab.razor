@page "/lab"
@using Rememore.Client.Componentes
@using Rememore.Client.Componentes.Lab
@inject EstadoTema Tema
@inject EstadoPaletaLaboratorio Paletas
@implements IDisposable

<div class="lab-pagina" style="@Paletas.GerarEstiloPrevia(Tema.AparenciaEscura)">
<CabecalhoPagina Titulo="@TituloCabecalho"
                 LarguraMaxima="84rem"
                 MostrarVoltar="@MostrarVoltar"
                 IconeEsquerdo="@IconeEsquerdo"
                 MostrarSair="@MostrarSair"
                 AoRetornar="ReceberRetorno"
                 AoSair="ReceberSaida" />

<div class="is-flex is-justify-content-center lab-tema-fixo m-3">
    <div class="container is-max-desktop section py-2 is-flex is-justify-content-flex-end">
        <Rememore.Client.Componentes.Lab.SeletorTema />
    </div>
</div>

<main class="container is-fluid section lab-pagina-conteudo" style="font-family: '@FonteSelecionada', sans-serif;">
    <div class="mt-5">
        <BlocoLab Identificador="fonte-padrao" Titulo="Fonte padrão do sistema">
            <SeletorFonteLab @bind-FonteSelecionada="FonteSelecionada" />
        </BlocoLab>

        <BlocoLab Identificador="paleta-cores" Titulo="Cores do sistema">
            <EditorPaletaLab />
        </BlocoLab>

        <BlocoLab Identificador="componentes-html" Titulo="Componentes HTML Simples">
        <h3 class="title is-4">Título</h3>

        <p>Este é um parágrafo de exemplo com texto simples.</p>

        <p><a href="https://bulma.io/documentation/">Link para a documentação do Bulma</a></p>

        <ul>
            <li>Primeiro item da lista</li>
            <li>Segundo item da lista</li>
            <li>Terceiro item da lista</li>
        </ul>

        <div class="field">
            <label class="label" for="lab-caixa-texto">Caixa de texto</label>
            <div class="control">
                <input class="input" id="lab-caixa-texto" type="text" placeholder="Digite um texto" />
            </div>
        </div>

        <div class="field">
            <label class="label" for="lab-caixa-texto-erro">Caixa de texto em estado de erro</label>
            <div class="control">
                <input class="input is-danger"
                       id="lab-caixa-texto-erro"
                       type="text"
                       placeholder="Digite um texto"
                       aria-invalid="true"
                       aria-describedby="lab-caixa-texto-erro-mensagem" />
            </div>
            <p class="help is-danger" id="lab-caixa-texto-erro-mensagem">Mensagem de erro de exemplo.</p>
        </div>

        <button class="button is-link" type="button">Botão de exemplo</button>
        </BlocoLab>

        <BlocoLab Identificador="cmp-001-senha" Titulo="CMP-001 - Senha">
            <DemonstracaoCampoSenha />
        </BlocoLab>

        <BlocoLab Identificador="cmp-002-chave-redefinicao" Titulo="CMP-002 - Chave de redefinição">
            <DemonstracaoConfirmacaoNovaChave />
        </BlocoLab>

        <BlocoLab Identificador="cmp-003-seletor-data" Titulo="CMP-003 - Seletor de Data">
            <DemonstracaoSeletorData />
        </BlocoLab>

        <BlocoLab Identificador="cmp-006-seletor-categoria" Titulo="CMP-006 - Seletor de Categoria">
            <DemonstracaoSeletorCategoria />
        </BlocoLab>

        <BlocoLab Identificador="cmp-007-seletor-tom" Titulo="CMP-007 — Seletor de Tom">
            <DemonstracaoSeletorTom />
        </BlocoLab>

        <BlocoLab Identificador="cmp-008-janela-temporal" Titulo="CMP-008 — Janela Temporal">
            <DemonstracaoJanelaTemporal />
        </BlocoLab>

        <BlocoLab Identificador="cmp-009-categoria-panorama" Titulo="CMP-009 — Categoria do Panorama">
            <DemonstracaoCategoriaPanorama />
        </BlocoLab>

        <BlocoLab Identificador="cmp-011-onda-utilizacao-categoria" Titulo="CMP-011 — Onda de Utilização da Categoria">
            <DemonstracaoOndaUtilizacaoCategoria />
        </BlocoLab>

        <BlocoLab Identificador="cmp-012-variacao-tom-categoria" Titulo="CMP-012 — Variação do Tom da Categoria">
            <DemonstracaoVariacaoTomCategoria />
        </BlocoLab>

        <BlocoLab Identificador="cmp-030-memoria" Titulo="CMP-030 — Memória">
            <DemonstracaoMemoriaCmp030 />
        </BlocoLab>

        <BlocoLab Identificador="cmp-027-cabecalho-pagina" Titulo="CMP-027 — Cabeçalho de Página">
            <div class="columns is-multiline">
                <div class="column is-12">
                    <div class="field">
                        <label class="label" for="cmp-027-titulo">Título obrigatório</label>
                        <div class="control">
                            <input class="input" id="cmp-027-titulo" type="text" @bind="TituloCabecalho" @bind:event="oninput" required />
                        </div>
                    </div>
                </div>

                <div class="column is-6">
                    <div class="field">
                        <label class="label" for="cmp-027-esquerda">Região esquerda</label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select id="cmp-027-esquerda" @bind="ModoEsquerda">
                                    <option value="icone">Exibir ícone</option>
                                    <option value="voltar">Exibir voltar</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                @if (ModoEsquerda == "icone")
                {
                    <div class="column is-6">
                        <div class="field">
                            <label class="label" for="cmp-027-icone">Ícone Font Awesome</label>
                            <div class="control">
                                <input class="input" id="cmp-027-icone" type="text" @bind="IconeEsquerdo" @bind:event="oninput" required />
                            </div>
                            <p class="help">Informe a classe do ícone, por exemplo: fa-book-open.</p>
                        </div>
                    </div>
                }

                <div class="column is-12">
                    <label class="checkbox">
                        <input type="checkbox" @bind="MostrarSair" />
                        Exibir ação de saída
                    </label>
                </div>
            </div>

            <div class="notification is-light mt-4" aria-live="polite">
                <p><strong>Retorno:</strong> @ResultadoRetorno</p>
                <p><strong>Saída:</strong> @ResultadoSaida</p>
            </div>
        </BlocoLab>

        <BlocoLab Identificador="cmp-028-popup" Titulo="CMP-028 - Mensagem em Popup">
            <DemonstracaoPopup />
        </BlocoLab>
    </div>
</main>
</div>

@code {
    private string FonteSelecionada { get; set; } = "Faculty Glyphic";
    private string TituloCabecalho { get; set; } = "Título da página";
    private string ModoEsquerda { get; set; } = "icone";
    private string IconeEsquerdo { get; set; } = "fa-book-open";
    private bool MostrarVoltar => ModoEsquerda == "voltar";
    private bool MostrarSair { get; set; } = true;
    private int acionamentosRetorno;
    private int acionamentosSaida;

    private string ResultadoRetorno => acionamentosRetorno == 0
        ? "Nenhum acionamento recebido."
        : $"Acionamento recebido pelo chamador ({acionamentosRetorno}).";

    private string ResultadoSaida => acionamentosSaida == 0
        ? "Nenhum acionamento recebido."
        : $"Acionamento recebido pelo chamador ({acionamentosSaida}).";

    private void ReceberRetorno() => acionamentosRetorno++;

    private void ReceberSaida() => acionamentosSaida++;

    protected override void OnInitialized()
    {
        Tema.Alterado += Atualizar;
        Paletas.Alterado += Atualizar;
    }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (primeiroRender) await Paletas.InicializarAsync();
    }

    private void Atualizar() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Tema.Alterado -= Atualizar;
        Paletas.Alterado -= Atualizar;
    }
}
