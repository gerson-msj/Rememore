@page "/capturar/{DataRota}"
@attribute [Authorize]
@implements IAsyncDisposable
@using Rememore.Client.Infraestrutura.Capturar
@using Rememore.Client.Infraestrutura.OrientacaoProgressiva
@using Rememore.Client.Infraestrutura.TrabalhoLocal
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject NavigationManager Navegacao
@inject IJSRuntime JS
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject AberturaCaptura Abertura
@inject ICapturasLocais CapturasLocais
@inject ContinuidadeCapturaSessionStorage Continuidade
@inject IOrientacaoProgressiva Orientacao
@inject FonteNivelOrientacaoSimulada NivelOrientacaoSimulado
@inject IWebAssemblyHostEnvironment Ambiente
@using System.Globalization

<PageTitle>Capturar @dataFormatada</PageTitle>

<main class="pagina-captura-dia">
    <CabecalhoAmbiente Titulo="Capturar" MostrarRetorno AoRetornar="VoltarSelecao" />
    <div class="captura-dia__espacador-cabecalho" aria-hidden="true"></div>
    @if (!dataInvalida && !string.IsNullOrEmpty(dataFormatada))
    {
        <div class="captura-dia__barra-fixa">
            <div class="captura-dia__linha-data">
                <time class="subtitle is-6 has-text-weight-medium" datetime="@data.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@dataFormatada</time>
            </div>
            <nav class="tabs is-fullwidth captura-dia__abas" role="group" aria-label="Etapas da captura">
                <ul>
                    <li class="is-active">
                        <a aria-current="step">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-feather-pointed"></i></span>
                            <span>Memorar</span>
                        </a>
                    </li>
                    <li>
                        <a aria-disabled="true" tabindex="-1">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
                            <span>Categorizar</span>
                        </a>
                    </li>
                    <li>
                        <a aria-disabled="true" tabindex="-1">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-bookmark"></i></span>
                            <span>Revisar</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="captura-dia__espacador-barra" aria-hidden="true"></div>
    }
    <div class="captura-dia__conteudo">
        @if (dataInvalida)
        {
            <h2 class="title is-3">Data inválida</h2>
            <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <div class="elemento-falha-recuperavel__conteudo">
                    <p class="elemento-falha-recuperavel__mensagem"><strong>Data inválida. Escolha uma data completa, existente e até hoje.</strong></p>
                    <button class="button is-link captura-dia__botao-retorno" type="button" @onclick="VoltarSelecao">Voltar à Seleção</button>
                </div>
            </div>
        }
        else if (preparando)
        {
            <p aria-busy="true">Preparando captura…</p>
        }
        else if (resultado?.Estado != EstadoAberturaCaptura.Aberta)
        {
            <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <div class="elemento-falha-recuperavel__conteudo">
                    <p class="elemento-falha-recuperavel__mensagem"><strong>@MensagemFalha</strong></p>
                    <button class="button is-link captura-dia__botao-retorno" type="button" @onclick="VoltarAposFalha">@RotuloRetornoFalha</button>
                </div>
            </div>
        }
        else
        {
            @if (ComposicaoVazia && textoOrientacao is not null)
            {
                <div class="notification elemento-orientacao-informativa" role="status">
                    <span class="elemento-orientacao-informativa__texto">@textoOrientacao</span>
                </div>
            }

            @foreach (var memoria in Memorias)
            {
                <Memoria @key="memoria.Identidade"
                         Identificador="memoria.Identidade"
                         Conteudo="memoria.Conteudo"
                         Modo="ModoMemoria.Memorar"
                         Inativa="true" />
            }

            @if (inclusaoAberta)
            {
                <section class="captura-dia__inclusao" aria-label="Inclusão de memória">
                    <CampoMultilinhaAtalhos @ref="campoInclusao" @bind-Value="textoInclusao"
                                             Desabilitado="@operacaoEmAndamento"
                                             AoSolicitarInclusao="IncluirMemoriaAsync"
                                             AoSolicitarInclusaoEContinuar="IncluirEContinuarAsync"
                                             AoSolicitarCancelamento="CancelarInclusaoAsync" />
                    <div class="buttons has-addons is-right captura-dia__acoes-inclusao">
                        <button class="button is-link" type="button" disabled="@operacaoEmAndamento" @onclick="IncluirMemoriaAsync">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
                            <span>Incluir memória</span>
                        </button>
                        <button class="button is-light" type="button" disabled="@operacaoEmAndamento" @onclick="CancelarInclusaoAsync">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-times"></i></span>
                            <span>Cancelar inclusão</span>
                        </button>
                    </div>
                    @if (mensagemFalhaInclusao is not null)
                    {
                        <div class="notification elemento-falha-recuperavel captura-dia__falha-inclusao" role="alert" aria-atomic="true">
                            <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </span>
                            <div class="elemento-falha-recuperavel__conteudo">
                                <p class="elemento-falha-recuperavel__mensagem"><strong>@mensagemFalhaInclusao</strong></p>
                            </div>
                        </div>
                    }
                    @if (ExibirDicaAtalhos)
                    {
                        <div class="notification elemento-orientacao-informativa captura-dia__dica-atalhos" role="note">
                            <span class="elemento-orientacao-informativa__texto">@DicaAtalhos</span>
                        </div>
                    }
                </section>
            }
            else
            {
                <div class="buttons is-right captura-dia__acao-incluir">
                    <button class="button is-link" type="button" @onclick="AbrirInclusao">
                        <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
                        <span>Incluir memória</span>
                    </button>
                </div>
            }

            @if (Ambiente.IsDevelopment())
            {
                <section class="box captura-dia__verificacao" aria-labelledby="verificacao-orientacao-titulo">
                    <h2 class="title is-6" id="verificacao-orientacao-titulo">Controles de verificação — Desenvolvimento</h2>
                    <div class="field">
                        <label class="label" for="nivel-orientacao-simulado">Nível de orientação simulado</label>
                        <div class="control">
                            <div class="select">
                                <select id="nivel-orientacao-simulado" @bind="nivelSimulado" @bind:after="AtualizarOrientacaoAsync">
                                    <option value="@NivelOrientacao.Iniciante">Iniciante</option>
                                    <option value="@NivelOrientacao.Intermediario">Intermediário</option>
                                    <option value="@NivelOrientacao.Avancado">Avançado</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label" for="cenario-composicao-simulado">Cenário da composição</label>
                        <div class="control">
                            <div class="select">
                                <select id="cenario-composicao-simulado" @bind="cenarioSimulado" @bind:after="AtualizarOrientacaoAsync">
                                    <option value="@CenarioComposicao.Real">Composição real do workspace</option>
                                    <option value="@CenarioComposicao.Vazia">Simular composição vazia</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p>Simulações locais e reversíveis: não gravam no workspace nem alteram progresso.</p>
                </section>
            }
        }
    </div>
    <MensagemPopup IsOpen="popupCancelamentoInclusao" Titulo="Cancelar inclusão da memória?"
                   Paragrafos="@MensagemCancelamentoInclusao"
                   RotuloConfirmacao="Cancelar inclusão"
                   RotuloCancelamento="Continuar escrevendo"
                   AoResponder="ResponderCancelamentoInclusaoAsync" />
</main>

@code {
    [Parameter] public string DataRota { get; set; } = "";

    private enum CenarioComposicao { Real, Vazia }

    private static readonly IReadOnlyList<string> MensagemCancelamentoInclusao =
    [
        "A memória que você está escrevendo ainda não foi incluída. Se cancelar agora, esse texto será perdido."
    ];

    private IJSObjectReference? moduloCalendario;
    private IDisposable? registroMudancaLocal;
    private string? ultimaDataRota;
    private DateOnly data;
    private string dataFormatada = "";
    private bool dataInvalida;
    private bool preparando = true;
    private ResultadoAberturaCaptura? resultado;
    private NivelOrientacao nivelSimulado;
    private NivelOrientacao nivelOriginal;
    private CenarioComposicao cenarioSimulado;
    private string? textoOrientacao;
    private CampoMultilinhaAtalhos? campoInclusao;
    private string textoInclusao = string.Empty;
    private string? mensagemFalhaInclusao;
    private bool inclusaoAberta;
    private bool operacaoEmAndamento;
    private bool popupCancelamentoInclusao;
    private bool focarInclusaoAposRenderizar;

    private const string DicaAtalhos = "Enter cria uma nova linha.\nShift+Enter inclui a memória.\nCtrl+Enter inclui e permite registrar outra.\nEsc cancela.";
    private bool ExibirDicaAtalhos => inclusaoAberta && ComposicaoVazia && nivelSimulado == NivelOrientacao.Iniciante;
    private IReadOnlyList<MemoriaCapturaLocal> Memorias => resultado?.Workspace?.Memorias ?? [];

    private bool ComposicaoVazia => cenarioSimulado switch
    {
        CenarioComposicao.Vazia => true,
        _ => Memorias.Count == 0
    };

    private string MensagemFalha => resultado?.Estado switch
    {
        EstadoAberturaCaptura.ApiIndisponivel => "Não é possível iniciar uma captura neste navegador. O Rememore precisa do armazenamento local do navegador para proteger suas memórias enquanto você trabalha. Tente utilizar uma versão atualizada de um navegador compatível.",
        EstadoAberturaCaptura.FalhaArmazenamento => "Não foi possível acessar o armazenamento local. O Rememore precisa desse recurso para proteger suas memórias enquanto você trabalha. Verifique as configurações de privacidade do navegador ou tente novamente em uma janela de navegação normal.",
        _ => "Não foi possível preparar esta captura. O trabalho não foi aberto. Volte e tente novamente."
    };
    private string RotuloRetornoFalha => resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
        ? "Voltar à Principal" : "Voltar à Seleção";

    protected override void OnInitialized()
    {
        nivelOriginal = NivelOrientacaoSimulado.NivelAtual;
        nivelSimulado = nivelOriginal;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ultimaDataRota is not null && ultimaDataRota != DataRota)
        {
            await Continuidade.LimparAsync();
            cenarioSimulado = CenarioComposicao.Real;
            inclusaoAberta = false;
            textoInclusao = string.Empty;
        }
        ultimaDataRota = DataRota;
        preparando = true;
        dataFormatada = "";
        resultado = null;

        moduloCalendario ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/calendarioCaptura.js");
        var hojeTexto = await moduloCalendario.InvokeAsync<string>("hojeLocal");
        var hoje = DateOnly.ParseExact(hojeTexto, "yyyy-MM-dd");
        dataInvalida = !DatasCaptura.TentarValidar(DataRota, hoje, out data);
        if (dataInvalida) { preparando = false; return; }

        dataFormatada = data.ToString("dddd, d 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("pt-BR"));
        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is null)
        {
            resultado = new(EstadoAberturaCaptura.FalhaPreparacao);
            preparando = false;
            return;
        }

        var recargaAtiva = await Continuidade.EhRecargaAtivaAsync(identidadeConta, data);
        resultado = await Abertura.AbrirAsync(identidadeConta, data, recargaAtiva);
        if (resultado.Estado == EstadoAberturaCaptura.Aberta)
        {
            await Continuidade.RegistrarAsync(identidadeConta, data);
            registroMudancaLocal ??= Navegacao.RegisterLocationChangingHandler(async contexto =>
            {
                if (!string.Equals(contexto.TargetLocation, Navegacao.Uri, StringComparison.Ordinal))
                    await Continuidade.LimparAsync();
            });
            await AtualizarOrientacaoAsync();
        }
        preparando = false;
    }

    private async Task AtualizarOrientacaoAsync()
    {
        NivelOrientacaoSimulado.NivelAtual = nivelSimulado;
        textoOrientacao = await Orientacao.ObterTextoAsync(ContextosOrientacao.CapturaMemorar);
    }

    private void AbrirInclusao()
    {
        inclusaoAberta = true;
        mensagemFalhaInclusao = null;
        focarInclusaoAposRenderizar = true;
    }

    private Task IncluirMemoriaAsync() => PersistirMemoriaAsync(continuar: false);

    private Task IncluirEContinuarAsync() => PersistirMemoriaAsync(continuar: true);

    private async Task PersistirMemoriaAsync(bool continuar)
    {
        if (operacaoEmAndamento || !inclusaoAberta) return;
        if (string.IsNullOrWhiteSpace(textoInclusao))
        {
            mensagemFalhaInclusao = "Escreva uma memória antes de incluir.";
            return;
        }

        var workspace = resultado?.Workspace;
        if (workspace is null) return;

        operacaoEmAndamento = true;
        mensagemFalhaInclusao = null;
        try
        {
            var memorias = workspace.Memorias.ToList();
            var ordem = memorias.Count == 0 ? 0 : memorias.Max(memoria => memoria.Ordem) + 1;
            memorias.Add(new(Guid.NewGuid().ToString("N"), textoInclusao, ordem));
            var atualizado = workspace with { Alterado = true, Memorias = memorias };
            var gravacao = await CapturasLocais.GravarAsync(atualizado);
            if (!gravacao.Sucesso)
            {
                mensagemFalhaInclusao = "Não foi possível incluir a memória. Tente novamente.";
                return;
            }

            resultado = resultado! with { Workspace = atualizado };
            textoInclusao = string.Empty;
            inclusaoAberta = continuar;
            if (continuar) focarInclusaoAposRenderizar = true;
            await AtualizarOrientacaoAsync();
        }
        finally
        {
            operacaoEmAndamento = false;
        }
    }

    private Task CancelarInclusaoAsync()
    {
        if (operacaoEmAndamento || !inclusaoAberta) return Task.CompletedTask;
        mensagemFalhaInclusao = null;
        if (string.IsNullOrWhiteSpace(textoInclusao))
        {
            FecharInclusao();
            return Task.CompletedTask;
        }

        popupCancelamentoInclusao = true;
        return Task.CompletedTask;
    }

    private Task ResponderCancelamentoInclusaoAsync(RespostaPopup resposta)
    {
        popupCancelamentoInclusao = false;
        if (resposta == RespostaPopup.Confirmacao) FecharInclusao();
        else focarInclusaoAposRenderizar = true;
        return Task.CompletedTask;
    }

    private void FecharInclusao()
    {
        textoInclusao = string.Empty;
        mensagemFalhaInclusao = null;
        inclusaoAberta = false;
    }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (!focarInclusaoAposRenderizar || campoInclusao is null) return;
        focarInclusaoAposRenderizar = false;
        await campoInclusao.FocarAsync();
    }

    private void VoltarSelecao() => Navegacao.NavigateTo("capturar");
    private void VoltarAposFalha() => Navegacao.NavigateTo(
        resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
            ? "principal" : "capturar");

    public async ValueTask DisposeAsync()
    {
        NivelOrientacaoSimulado.NivelAtual = nivelOriginal;
        registroMudancaLocal?.Dispose();
        if (moduloCalendario is not null) await moduloCalendario.DisposeAsync();
    }
}
