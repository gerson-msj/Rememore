@page "/capturar/{DataRota}"
@attribute [Authorize]
@implements IAsyncDisposable
@using Rememore.Client.Infraestrutura.Capturar
@using Rememore.Client.Infraestrutura.OrientacaoProgressiva
@using Rememore.Client.Infraestrutura.TrabalhoLocal
@inject NavigationManager Navegacao
@inject IJSRuntime JS
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject AberturaCaptura Abertura
@inject ICapturasLocais CapturasLocais
@inject ContinuidadeCapturaSessionStorage Continuidade
@inject IOrientacaoProgressiva Orientacao
@inject IFonteNivelOrientacao FonteNivelOrientacao
@using System.Globalization
@using Rememore.Client.Componentes

<PageTitle>Capturar @dataFormatada</PageTitle>

<main class="pagina-captura-dia">
    <CabecalhoPagina Titulo="Capturar" MostrarVoltar MostrarSair
                     AoRetornar="SolicitarVoltarCabecalhoAsync"
                     AoSair="SolicitarSaidaAsync" />
    <NavigationLock ConfirmExternalNavigation="@ExigirConfirmacaoAbandono" />
    <div class="captura-dia__espacador-cabecalho" aria-hidden="true"></div>
    @if (!dataInvalida && !string.IsNullOrEmpty(dataFormatada))
    {
        <div class="captura-dia__barra-fixa">
            <div class="captura-dia__linha-data">
                <time class="subtitle is-6 has-text-weight-medium" datetime="@data.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@dataFormatada</time>
            </div>
            <nav class="tabs is-fullwidth captura-dia__abas" aria-label="Etapas da captura">
                <ul>
                    <li class="@(!AbaCategorizar && !AbaRevisar ? "is-active" : string.Empty)">
                        <a href="@UrlAbaMemorar" aria-current="@(!AbaCategorizar && !AbaRevisar ? "step" : null)">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-feather-pointed"></i></span>
                            <span>Memorar</span>
                        </a>
                    </li>
                    <li class="@(AbaCategorizar ? "is-active" : string.Empty)">
                        <a href="@UrlAbaCategorizar" aria-current="@(AbaCategorizar ? "step" : null)"
                           aria-disabled="@(inclusaoAberta ? "true" : null)" tabindex="@(inclusaoAberta ? -1 : null)"
                           @onclick:preventDefault="@inclusaoAberta">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
                            <span>Categorizar</span>
                        </a>
                    </li>
                    <li class="@(AbaRevisar ? "is-active" : string.Empty)">
                        <a href="@UrlAbaRevisar" aria-current="@(AbaRevisar ? "step" : null)">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-bookmark"></i></span>
                            <span>Revisar</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="captura-dia__espacador-barra" aria-hidden="true"></div>
    }
    <div class="captura-dia__conteudo @(AbaRevisar ? "captura-dia__conteudo--revisao" : string.Empty)">
        @if (dataInvalida)
        {
            <h2 class="title is-3">Data inválida</h2>
            <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <div class="elemento-falha-recuperavel__conteudo">
                    <p class="elemento-falha-recuperavel__mensagem"><strong>Data inválida. Escolha uma data completa, existente e até hoje.</strong></p>
                    <button class="button is-link captura-dia__botao-retorno" type="button" @onclick="VoltarSelecao">Voltar à Seleção</button>
                </div>
            </div>
        }
        else if (preparando)
        {
            <p aria-busy="true">Preparando captura…</p>
        }
        else if (resultado?.Estado != EstadoAberturaCaptura.Aberta)
        {
            <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <div class="elemento-falha-recuperavel__conteudo">
                    <p class="elemento-falha-recuperavel__mensagem"><strong>@MensagemFalha</strong></p>
                    <button class="button is-link captura-dia__botao-retorno" type="button" @onclick="VoltarAposFalha">@RotuloRetornoFalha</button>
                </div>
            </div>
        }
        else
        {
            @if (AbaRevisar)
            {
                <div class="buttons captura-dia__acoes-revisao" role="group" aria-label="Ações da revisão">
                    <button class="button is-link elemento-botao-com-icone" type="button" @onclick="ValidarCategoriasParaPreservarAsync">
                        <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-bookmark"></i></span>
                        <span>Preservar</span>
                    </button>
                    <button class="button is-light elemento-botao-com-icone" type="button" disabled>
                        <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-trash-can"></i></span>
                        <span>Descartar alterações</span>
                    </button>
                </div>
                @if (textoOrientacao is not null)
                {
                    <div class="notification elemento-orientacao-informativa" role="status">
                        <span class="elemento-orientacao-informativa__texto">@textoOrientacao</span>
                    </div>
                }
                <div class="lista-memorias captura-dia__lista-memorias" role="list" aria-label="Memórias da revisão">
                    @foreach (var memoria in Memorias)
                    {
                        <div @key="memoria.Identidade" class="captura-dia__item-memoria" role="listitem" data-identidade-memoria="@memoria.Identidade">
                            <Memoria Identificador="@memoria.Identidade"
                                     Conteudo="@ComporConteudoRevisao(memoria)"
                                     Categorias="@(memoria.Categorias?.Select(categoria => categoria.Nome).ToArray() ?? [])"
                                     Tom="@memoria.Tom"
                                     Modo="ModoMemoria.Revisar"
                                     CategoriaEmAtencao="@identidadesSemCategoriaEmAtencao.Contains(memoria.Identidade)"
                                     AoAcionar="AcionarMemoria" />
                        </div>
                    }
                </div>
                @if (revisaoRolavel)
                {
                    <p class="captura-dia__voltar-topo">
                    <a class="has-text-link" href="#" @onclick="VoltarAoTopoRevisaoAsync">
                        <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-arrow-up"></i></span>
                        <span>Voltar ao topo</span>
                    </a>
                    </p>
                }
            }
            else if (AbaCategorizar && Memorias.Count == 0)
            {
                <p role="status">Não há memórias para categorizar.</p>
            }
            else if (!AbaCategorizar && !AbaRevisar && Memorias.Count == 0 && textoOrientacao is not null)
            {
                <div class="notification elemento-orientacao-informativa" role="status">
                    <span class="elemento-orientacao-informativa__texto">@textoOrientacao</span>
                </div>
            }

            @if (!AbaRevisar && Memorias.Count > 0)
            {
                <div class="lista-memorias captura-dia__lista-memorias" role="list" aria-label="@(AbaCategorizar ? "Memórias para categorizar" : "Memórias da captura")">
                    @for (var indice = 0; indice < Memorias.Count; indice++)
                    {
                        var memoria = Memorias[indice];
                        <div @key="memoria.Identidade" class="captura-dia__item-memoria" role="listitem"
                             data-identidade-memoria="@memoria.Identidade">
                            <Memoria
                                     Identificador="@memoria.Identidade"
                                     Conteudo="@memoria.Conteudo"
                                     Categorias="@(memoria.Categorias?.Select(categoria => categoria.Nome).ToArray() ?? [])"
                                     Tom="@memoria.Tom"
                                     Modo="@(AbaCategorizar ? ModoMemoria.Categorizar : ModoMemoria.Memorar)"
                                     Primeira="@(indice == 0)"
                                     Ultima="@(indice == Memorias.Count - 1)"
                                     Inativa="@(inclusaoAberta || operacaoEmAndamento)"
                                     AoAcionar="AcionarMemoria"
                                     AoElevar="ElevarMemoriaAsync"
                                     AoRebaixar="RebaixarMemoriaAsync" />
                        </div>
                    }
                </div>
            }

            @if (!AbaCategorizar && inclusaoAberta)
            {
                <section class="captura-dia__inclusao" aria-label="Inclusão de memória">
                    <CampoMultilinhaAtalhos @ref="campoInclusao"
                                             Value="@textoInclusao"
                                             ValueChanged="AtualizarTextoInclusaoAsync"
                                             Desabilitado="@operacaoEmAndamento"
                                             AoSolicitarInclusao="IncluirMemoriaAsync"
                                             AoSolicitarInclusaoEContinuar="IncluirEContinuarAsync"
                                             AoSolicitarCancelamento="CancelarInclusaoAsync" />
                    <div class="buttons has-addons is-right captura-dia__acoes-inclusao">
                        <button class="button is-link" type="button" disabled="@operacaoEmAndamento" @onclick="IncluirMemoriaAsync">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
                            <span>Incluir memória</span>
                        </button>
                        <button class="button is-light" type="button" disabled="@operacaoEmAndamento" @onclick="CancelarInclusaoAsync">
                            <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-times"></i></span>
                            <span>Cancelar inclusão</span>
                        </button>
                    </div>
                    @if (mensagemFalhaInclusao is not null)
                    {
                        <div class="notification elemento-falha-recuperavel captura-dia__falha-inclusao" role="alert" aria-atomic="true">
                            <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </span>
                            <div class="elemento-falha-recuperavel__conteudo">
                                <p class="elemento-falha-recuperavel__mensagem"><strong>@mensagemFalhaInclusao</strong></p>
                            </div>
                        </div>
                    }
                    @if (ExibirDicaAtalhos)
                    {
                        <div class="notification elemento-orientacao-informativa captura-dia__dica-atalhos" role="note">
                            <span class="elemento-orientacao-informativa__texto">@DicaAtalhos</span>
                        </div>
                    }
                </section>
            }
            else if (!AbaCategorizar && !AbaRevisar)
            {
                <div class="buttons is-right captura-dia__acao-incluir">
                    <button class="button is-link" type="button" @onclick="AbrirInclusao">
                        <span class="icon is-small" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
                        <span>Incluir memória</span>
                    </button>
                </div>
            }

        }
    </div>
    <Popup Aberto="@popupCancelamentoInclusao" Titulo="Cancelar inclusão da memória?"
           Mensagem="@MensagemCancelamentoInclusao"
           TextoConfirmar="Cancelar inclusão"
           TextoCancelar="Continuar escrevendo"
           ClasseBotaoConfirmar="is-danger is-light"
           ClasseBotaoCancelar="is-info"
           AoResponder="ResponderCancelamentoInclusaoAsync" />
    <Popup Aberto="@popupNavegacaoAberto" Titulo="@TituloPopupNavegacao"
           Mensagem="@MensagemNavegacao"
           TextoConfirmar="@RotuloConfirmacaoNavegacao"
           TextoCancelar="@RotuloCancelamentoNavegacao"
           ClasseBotaoConfirmar="is-danger is-light"
           ClasseBotaoCancelar="is-info"
           AoResponder="ResponderPopupNavegacaoAsync" />
    <Popup Aberto="@popupFalhaOrdenacao"
           Mensagem="@MensagemFalhaOrdenacao"
           ClassePopup="popup--sombra-warning"
           TextoConfirmar="Ok"
           ClasseBotaoConfirmar="is-info"
           AoResponder="ResponderFalhaOrdenacaoAsync" />
    <Popup Aberto="@popupCategoriasAusentes"
           Mensagem="Há memórias sem categoria. Adicione pelo menos uma categoria a cada memória antes de preservar."
           TextoConfirmar="Ok"
           ClasseBotaoConfirmar="is-info"
           AoResponder="ResponderCategoriasAusentesAsync" />
</main>

@code {
    [Parameter] public string DataRota { get; set; } = "";
    [SupplyParameterFromQuery(Name = "aba")] public string? Aba { get; set; }
    [SupplyParameterFromQuery(Name = "memoria")] public string? MemoriaFocoRota { get; set; }
    [SupplyParameterFromQuery(Name = "atencao")] public bool AtencaoRota { get; set; }

    private enum TipoPopupNavegacao { Nenhum, VoltarCabecalho, SairSemTexto, SairComTexto, NavegacaoInterna }

    private const string MensagemCancelamentoInclusao = "A memória que você está escrevendo ainda não foi incluída. Se cancelar agora, esse texto será perdido.";
    private const string MensagemFalhaOrdenacao = "Não foi possível atualizar a ordem das memórias. A ordem anterior foi mantida. Tente novamente.";

    private IJSObjectReference? moduloCalendario;
    private IJSObjectReference? moduloNavegacao;
    private IJSObjectReference? moduloLista;
    private IJSObjectReference? moduloRevisao;
    private DotNetObjectReference<CapturaDia>? referenciaNavegacao;
    private DotNetObjectReference<CapturaDia>? referenciaRevisao;
    private IDisposable? registroMudancaLocal;
    private string? ultimaDataRota;
    private DateOnly data;
    private string dataFormatada = "";
    private bool dataInvalida;
    private string? identidadeMemoriaParaAlinhar;
    private bool AbaCategorizar => !inclusaoAberta && string.Equals(Aba, "categorizar", StringComparison.OrdinalIgnoreCase);
    private bool AbaRevisar => !inclusaoAberta && string.Equals(Aba, "revisar", StringComparison.OrdinalIgnoreCase);
    private string UrlAbaMemorar => $"capturar/{Uri.EscapeDataString(DataRota)}";
    private string UrlAbaCategorizar => $"capturar/{Uri.EscapeDataString(DataRota)}?aba=categorizar";
    private string UrlAbaRevisar => $"capturar/{Uri.EscapeDataString(DataRota)}?aba=revisar";
    private bool preparando = true;
    private ResultadoAberturaCaptura? resultado;
    private NivelOrientacao nivelOrientacaoAtual = NivelOrientacao.Iniciante;
    private string? textoOrientacao;
    private readonly HashSet<string> identidadesSemCategoriaEmAtencao = new(StringComparer.Ordinal);
    private bool popupCategoriasAusentes;
    private bool alinharPrimeiraMemoriaSemCategoria;
    private string? primeiraMemoriaSemCategoria;
    private bool revisaoRolavel;
    private CampoMultilinhaAtalhos? campoInclusao;
    private string textoInclusao = string.Empty;
    private string? mensagemFalhaInclusao;
    private bool inclusaoAberta;
    private bool operacaoEmAndamento;
    private bool popupCancelamentoInclusao;
    private bool popupNavegacaoAberto;
    private bool permitirProximaNavegacao;
    private bool focarInclusaoAposRenderizar;
    private bool rolarPaginaAoAbrirInclusao;
    private bool rolarPaginaAposInclusao;
    private string? identidadeFocoOrdenacao;
    private bool focarElevarAposOrdenacao;
    private bool popupFalhaOrdenacao;
    private bool restaurarFocoOrdenacaoAposRenderizar;
    private void AbrirEdicaoMemoria(string identidade, AbaOrigemEdicaoCaptura origem, bool categoriaEmAtencao = false) =>
        Navegacao.NavigateTo(ContextoEdicaoCaptura.RotaEdicaoMemoria(DataRota, identidade, origem, categoriaEmAtencao));
    private void AbrirCategorizacaoMemoria(string identidade, AbaOrigemEdicaoCaptura origem, bool categoriaEmAtencao = false) =>
        Navegacao.NavigateTo(ContextoEdicaoCaptura.RotaCategorizacao(DataRota, identidade, origem, categoriaEmAtencao));
    private void AcionarMemoria(string identidade)
    {
        if (AbaCategorizar) AbrirCategorizacaoMemoria(identidade, AbaOrigemEdicaoCaptura.Categorizar);
        else if (AbaRevisar)
        {
            var emAtencao = identidadesSemCategoriaEmAtencao.Contains(identidade);
            if (emAtencao) AbrirCategorizacaoMemoria(identidade, AbaOrigemEdicaoCaptura.Revisar, categoriaEmAtencao: true);
            else AbrirEdicaoMemoria(identidade, AbaOrigemEdicaoCaptura.Revisar);
        }
        else AbrirEdicaoMemoria(identidade, AbaOrigemEdicaoCaptura.Memorar);
    }
    private TipoPopupNavegacao tipoPopupNavegacao;
    private TaskCompletionSource<bool>? decisaoNavegacaoInterna;

    private const string DicaAtalhos = "Enter cria uma nova linha.\nShift+Enter inclui a memória.\nCtrl+Enter inclui e permite registrar outra.\nEsc cancela.";
    private bool ExibirDicaAtalhos => inclusaoAberta && Memorias.Count == 0 && nivelOrientacaoAtual == NivelOrientacao.Iniciante;
    private IReadOnlyList<MemoriaCapturaLocal> Memorias => resultado?.Workspace?.Memorias.OrderBy(memoria => memoria.Ordem).ToList() ?? [];
    private string ComporConteudoRevisao(MemoriaCapturaLocal memoria)
    {
        var blocos = new List<string> { memoria.Conteudo };
        foreach (var complemento in (memoria.Complementos ?? []).OrderBy(item => item.Ordem))
        {
            var titulo = complemento.PrimeiraPreservacaoUtc is { } marco
                ? $"Complemento adicionado em {marco.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("pt-BR"))}"
                : "Complemento";
            blocos.Add($"{titulo}\n{complemento.Conteudo}");
        }
        return string.Join("\n\n", blocos);
    }
    private static Task IgnorarAcionamentoMemoria(string _) => Task.CompletedTask;
    private bool TemTextoUtil => inclusaoAberta && !string.IsNullOrWhiteSpace(textoInclusao);
    private bool ExigirConfirmacaoAbandono => TemTextoUtil;

    private string TituloPopupNavegacao => tipoPopupNavegacao switch
    {
        TipoPopupNavegacao.VoltarCabecalho or TipoPopupNavegacao.NavegacaoInterna => "Voltar sem incluir a memória?",
        TipoPopupNavegacao.SairComTexto => "Sair sem incluir a memória?",
        TipoPopupNavegacao.SairSemTexto => "Sair do Rememore?",
        _ => string.Empty
    };

    private string MensagemNavegacao => tipoPopupNavegacao switch
    {
        TipoPopupNavegacao.VoltarCabecalho or TipoPopupNavegacao.NavegacaoInterna =>
            "A memória que você está escrevendo ainda não foi incluída. Se voltar agora, esse texto será perdido.",
        TipoPopupNavegacao.SairComTexto =>
            "A memória que você está escrevendo ainda não foi incluída. Se sair agora, esse texto será perdido e sua sessão será encerrada.",
        TipoPopupNavegacao.SairSemTexto => "Deseja encerrar sua sessão?",
        _ => string.Empty
    };

    private string RotuloConfirmacaoNavegacao => tipoPopupNavegacao switch
    {
        TipoPopupNavegacao.VoltarCabecalho or TipoPopupNavegacao.NavegacaoInterna => "Voltar sem incluir",
        TipoPopupNavegacao.SairComTexto => "Sair sem incluir",
        TipoPopupNavegacao.SairSemTexto => "Sair",
        _ => "Confirmar"
    };

    private string RotuloCancelamentoNavegacao => tipoPopupNavegacao == TipoPopupNavegacao.SairSemTexto
        ? "Cancelar" : "Continuar escrevendo";

    private string MensagemFalha => resultado?.Estado switch
    {
        EstadoAberturaCaptura.ApiIndisponivel => "Não é possível iniciar uma captura neste navegador. O Rememore precisa do armazenamento local do navegador para proteger suas memórias enquanto você trabalha. Tente utilizar uma versão atualizada de um navegador compatível.",
        EstadoAberturaCaptura.FalhaArmazenamento => "Não foi possível acessar o armazenamento local. O Rememore precisa desse recurso para proteger suas memórias enquanto você trabalha. Verifique as configurações de privacidade do navegador ou tente novamente em uma janela de navegação normal.",
        _ => "Não foi possível preparar esta captura. O trabalho não foi aberto. Volte e tente novamente."
    };
    private string RotuloRetornoFalha => resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
        ? "Voltar à Principal" : "Voltar à Seleção";

    protected override async Task OnParametersSetAsync()
    {
        identidadeMemoriaParaAlinhar = !string.IsNullOrWhiteSpace(MemoriaFocoRota)
            ? Uri.UnescapeDataString(MemoriaFocoRota)
            : null;
        if (ultimaDataRota is not null && ultimaDataRota != DataRota)
        {
            await Continuidade.LimparAsync();
            await Continuidade.LimparRascunhoAsync();
            inclusaoAberta = false;
            textoInclusao = string.Empty;
        }
        ultimaDataRota = DataRota;
        preparando = true;
        dataFormatada = "";
        resultado = null;

        moduloCalendario ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/calendarioCaptura.js");
        var hojeTexto = await moduloCalendario.InvokeAsync<string>("hojeLocal");
        var hoje = DateOnly.ParseExact(hojeTexto, "yyyy-MM-dd");
        dataInvalida = !DatasCaptura.TentarValidar(DataRota, hoje, out data);
        if (dataInvalida) { preparando = false; return; }

        dataFormatada = data.ToString("dddd, d 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("pt-BR"));
        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is null)
        {
            resultado = new(EstadoAberturaCaptura.FalhaPreparacao);
            preparando = false;
            return;
        }

        var recargaAtiva = await Continuidade.EhRecargaAtivaAsync(identidadeConta, data);
        resultado = await Abertura.AbrirAsync(identidadeConta, data, recargaAtiva);
        if (resultado.Estado == EstadoAberturaCaptura.Aberta)
        {
            if (recargaAtiva)
            {
                var rascunho = await Continuidade.RecuperarRascunhoAsync(identidadeConta, data);
                inclusaoAberta = rascunho?.InclusaoAberta == true;
                textoInclusao = inclusaoAberta ? rascunho!.Texto : string.Empty;
                focarInclusaoAposRenderizar = inclusaoAberta;
                if (!inclusaoAberta) await Continuidade.LimparRascunhoAsync();
            }
            else
            {
                inclusaoAberta = false;
                textoInclusao = string.Empty;
                await Continuidade.LimparRascunhoAsync();
            }

            await Continuidade.RegistrarAsync(identidadeConta, data);
            registroMudancaLocal ??= Navegacao.RegisterLocationChangingHandler(TratarMudancaInternaAsync);
            if (AbaRevisar)
            {
                await AtualizarRevisaoLocalAsync();
                var tentativaRegistrada = AtencaoRota || await Continuidade.TentouPreservarAsync(identidadeConta, data);
                if (AtencaoRota && !tentativaRegistrada)
                {
                    await Continuidade.RegistrarTentativaPreservarAsync(identidadeConta, data);
                    tentativaRegistrada = true;
                }
                identidadesSemCategoriaEmAtencao.Clear();
                if (tentativaRegistrada)
                {
                    foreach (var memoria in Memorias.Where(item => item.Categorias is not { Count: > 0 }))
                        identidadesSemCategoriaEmAtencao.Add(memoria.Identidade);
                }
            }
            await AtualizarOrientacaoAsync();
        }
        preparando = false;
    }

    private async Task AtualizarOrientacaoAsync()
    {
        nivelOrientacaoAtual = await FonteNivelOrientacao.ObterNivelAsync();
        textoOrientacao = await Orientacao.ObterTextoAsync(AbaRevisar
            ? ContextosOrientacao.CapturaRevisar
            : ContextosOrientacao.CapturaMemorar);
    }

    private async Task AtualizarRevisaoLocalAsync()
    {
        if (resultado?.Workspace is not { } workspace) return;
        var atual = await CapturasLocais.RecuperarAsync(workspace.IdentidadeConta, workspace.Data);
        if (atual.Sucesso && atual.Valor is { } confirmado)
        {
            resultado = resultado with { Workspace = confirmado };
            identidadesSemCategoriaEmAtencao.RemoveWhere(id => confirmado.Memorias
                .Any(memoria => memoria.Identidade == id && memoria.Categorias is { Count: > 0 }));
        }
    }

    private async Task ValidarCategoriasParaPreservarAsync()
    {
        if (operacaoEmAndamento) return;
        await AtualizarRevisaoLocalAsync();
        var invalidas = Memorias.Where(memoria => memoria.Categorias is not { Count: > 0 }).ToArray();
        if (invalidas.Length == 0) return;

        if (resultado?.Workspace is { } workspace)
            await Continuidade.RegistrarTentativaPreservarAsync(workspace.IdentidadeConta, workspace.Data);
        identidadesSemCategoriaEmAtencao.Clear();
        foreach (var memoria in invalidas) identidadesSemCategoriaEmAtencao.Add(memoria.Identidade);
        primeiraMemoriaSemCategoria = invalidas[0].Identidade;
        popupCategoriasAusentes = true;
    }

    private Task ResponderCategoriasAusentesAsync(RespostaPopup _)
    {
        popupCategoriasAusentes = false;
        alinharPrimeiraMemoriaSemCategoria = primeiraMemoriaSemCategoria is not null;
        return Task.CompletedTask;
    }

    private async Task VoltarAoTopoRevisaoAsync()
    {
        if (moduloRevisao is not null) await moduloRevisao.InvokeVoidAsync("voltarAoTopo");
    }

    private async Task AbrirInclusao()
    {
        inclusaoAberta = true;
        mensagemFalhaInclusao = null;
        focarInclusaoAposRenderizar = true;
        rolarPaginaAoAbrirInclusao = true;
        await RegistrarRascunhoAsync();
    }

    private async Task AtualizarTextoInclusaoAsync(string texto)
    {
        textoInclusao = texto;
        mensagemFalhaInclusao = null;
        await RegistrarRascunhoAsync();
    }

    private Task RegistrarRascunhoAsync()
    {
        var workspace = resultado?.Workspace;
        return workspace is null
            ? Task.CompletedTask
            : Continuidade.RegistrarRascunhoAsync(workspace.IdentidadeConta, workspace.Data, inclusaoAberta, textoInclusao);
    }

    private Task IncluirMemoriaAsync() => PersistirMemoriaAsync(continuar: false);

    private Task IncluirEContinuarAsync() => PersistirMemoriaAsync(continuar: true);

    private Task ElevarMemoriaAsync(string identidade) => MoverMemoriaAsync(identidade, -1);

    private Task RebaixarMemoriaAsync(string identidade) => MoverMemoriaAsync(identidade, 1);

    private async Task MoverMemoriaAsync(string identidade, int deslocamento)
    {
        if (operacaoEmAndamento || inclusaoAberta) return;
        var workspace = resultado?.Workspace;
        if (workspace is null) return;

        var memorias = workspace.Memorias.OrderBy(memoria => memoria.Ordem).ToList();
        var indice = memorias.FindIndex(memoria => memoria.Identidade == identidade);
        var destino = indice + deslocamento;
        if (indice < 0 || destino < 0 || destino >= memorias.Count) return;

        (memorias[indice], memorias[destino]) = (memorias[destino], memorias[indice]);
        var reordenadas = memorias.Select((memoria, ordem) => memoria with { Ordem = ordem }).ToList();
        var atualizado = workspace with { Alterado = true, AlteradoApenasPorCategorias = false, Memorias = reordenadas };
        identidadeFocoOrdenacao = identidade;
        focarElevarAposOrdenacao = deslocamento < 0;

        operacaoEmAndamento = true;
        try
        {
            var gravacao = await CapturasLocais.GravarAsync(atualizado);
            if (!gravacao.Sucesso)
            {
                popupFalhaOrdenacao = true;
                return;
            }

            resultado = resultado! with { Workspace = atualizado };
            restaurarFocoOrdenacaoAposRenderizar = true;
        }
        finally
        {
            operacaoEmAndamento = false;
        }
    }

    private Task ResponderFalhaOrdenacaoAsync(RespostaPopup _)
    {
        popupFalhaOrdenacao = false;
        restaurarFocoOrdenacaoAposRenderizar = true;
        return Task.CompletedTask;
    }

    private async Task RestaurarFocoOrdenacaoAsync()
    {
        if (identidadeFocoOrdenacao is null) return;
        await (moduloLista ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/capturaDiaLista.js"))
            .InvokeVoidAsync("focarEManterVisivel", identidadeFocoOrdenacao, focarElevarAposOrdenacao, ".captura-dia__barra-fixa");
    }

    private async Task PersistirMemoriaAsync(bool continuar)
    {
        if (operacaoEmAndamento || !inclusaoAberta) return;
        if (string.IsNullOrWhiteSpace(textoInclusao))
        {
            mensagemFalhaInclusao = "Escreva uma memória antes de incluir.";
            return;
        }

        var workspace = resultado?.Workspace;
        if (workspace is null) return;

        operacaoEmAndamento = true;
        mensagemFalhaInclusao = null;
        try
        {
            var memorias = workspace.Memorias.ToList();
            var ordem = memorias.Count == 0 ? 0 : memorias.Max(memoria => memoria.Ordem) + 1;
            memorias.Add(new(Guid.NewGuid().ToString("N"), textoInclusao, ordem,
                PrimeiraPreservacaoUtc: null, TemporalidadeConhecida: true, Complementos: []));
            var atualizado = workspace with { Alterado = true, AlteradoApenasPorCategorias = false, Memorias = memorias };
            var gravacao = await CapturasLocais.GravarAsync(atualizado);
            if (!gravacao.Sucesso)
            {
                mensagemFalhaInclusao = "Não foi possível incluir a memória. Tente novamente.";
                return;
            }

            resultado = resultado! with { Workspace = atualizado };
            textoInclusao = string.Empty;
            inclusaoAberta = continuar;
            if (continuar) await RegistrarRascunhoAsync();
            else await Continuidade.LimparRascunhoAsync();
            rolarPaginaAposInclusao = true;
            if (continuar) focarInclusaoAposRenderizar = true;
            await AtualizarOrientacaoAsync();
        }
        finally
        {
            operacaoEmAndamento = false;
        }
    }

    private async Task CancelarInclusaoAsync()
    {
        if (operacaoEmAndamento || !inclusaoAberta) return;
        mensagemFalhaInclusao = null;
        if (string.IsNullOrWhiteSpace(textoInclusao))
        {
            await DescartarInclusaoAsync();
            return;
        }

        popupCancelamentoInclusao = true;
    }

    private async Task ResponderCancelamentoInclusaoAsync(RespostaPopup resposta)
    {
        popupCancelamentoInclusao = false;
        if (resposta == RespostaPopup.Confirmacao) await DescartarInclusaoAsync();
        else focarInclusaoAposRenderizar = true;
    }

    private async Task DescartarInclusaoAsync()
    {
        textoInclusao = string.Empty;
        mensagemFalhaInclusao = null;
        inclusaoAberta = false;
        await Continuidade.LimparRascunhoAsync();
    }

    private async Task LimparInclusaoEIndicadorAsync()
    {
        await DescartarInclusaoAsync();
        await Continuidade.LimparAsync();
    }

    private async Task SolicitarVoltarCabecalhoAsync()
    {
        if (TemTextoUtil)
        {
            tipoPopupNavegacao = TipoPopupNavegacao.VoltarCabecalho;
            popupNavegacaoAberto = true;
            return;
        }

        await LimparInclusaoEIndicadorAsync();
        permitirProximaNavegacao = true;
        Navegacao.NavigateTo("capturar");
    }

    private Task SolicitarSaidaAsync()
    {
        tipoPopupNavegacao = TemTextoUtil
            ? TipoPopupNavegacao.SairComTexto
            : TipoPopupNavegacao.SairSemTexto;
        popupNavegacaoAberto = true;
        return Task.CompletedTask;
    }

    private async Task ResponderPopupNavegacaoAsync(RespostaPopup resposta)
    {
        var tipo = tipoPopupNavegacao;
        popupNavegacaoAberto = false;

        if (tipo == TipoPopupNavegacao.NavegacaoInterna)
        {
            if (resposta == RespostaPopup.Cancelamento)
            {
                focarInclusaoAposRenderizar = true;
                decisaoNavegacaoInterna?.TrySetResult(false);
            }
            else decisaoNavegacaoInterna?.TrySetResult(true);
            return;
        }

        if (resposta == RespostaPopup.Cancelamento)
        {
            if (TemTextoUtil) focarInclusaoAposRenderizar = true;
            return;
        }

        if (tipo == TipoPopupNavegacao.VoltarCabecalho)
        {
            await LimparInclusaoEIndicadorAsync();
            permitirProximaNavegacao = true;
            Navegacao.NavigateTo("capturar");
            return;
        }

        if (tipo is TipoPopupNavegacao.SairComTexto or TipoPopupNavegacao.SairSemTexto)
        {
            await LimparInclusaoEIndicadorAsync();
            permitirProximaNavegacao = true;
            await EstadoAutenticacao.EncerrarSessaoAsync();
            Navegacao.NavigateTo(Navegacao.BaseUri);
        }
    }

    private async ValueTask TratarMudancaInternaAsync(LocationChangingContext contexto)
    {
        if (permitirProximaNavegacao)
        {
            permitirProximaNavegacao = false;
            return;
        }

        if (!TemTextoUtil)
        {
            await LimparInclusaoEIndicadorAsync();
            return;
        }

        if (decisaoNavegacaoInterna is not null)
        {
            contexto.PreventNavigation();
            return;
        }

        decisaoNavegacaoInterna = new(TaskCreationOptions.RunContinuationsAsynchronously);
        tipoPopupNavegacao = TipoPopupNavegacao.NavegacaoInterna;
        popupNavegacaoAberto = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var confirmou = await decisaoNavegacaoInterna.Task.WaitAsync(contexto.CancellationToken);
            if (!confirmou)
            {
                contexto.PreventNavigation();
                return;
            }

            await LimparInclusaoEIndicadorAsync();
        }
        catch (OperationCanceledException)
        {
            contexto.PreventNavigation();
        }
        finally
        {
            popupNavegacaoAberto = false;
            tipoPopupNavegacao = TipoPopupNavegacao.Nenhum;
            decisaoNavegacaoInterna = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (primeiroRender)
        {
            moduloNavegacao = await JS.InvokeAsync<IJSObjectReference>("import", "./js/capturaDiaNavegacao.js");
            moduloLista = await JS.InvokeAsync<IJSObjectReference>("import", "./js/capturaDiaLista.js");
            await moduloLista.InvokeVoidAsync("conectarOrdenacao");
            moduloRevisao = await JS.InvokeAsync<IJSObjectReference>("import", "./js/capturaDiaRevisao.js");
            await moduloRevisao.InvokeVoidAsync("conectar", AbaRevisar);
            referenciaNavegacao = DotNetObjectReference.Create(this);
            await moduloNavegacao.InvokeVoidAsync("conectar", referenciaNavegacao);
            referenciaRevisao = DotNetObjectReference.Create(this);
            await moduloRevisao.InvokeVoidAsync("conectar", AbaRevisar, referenciaRevisao);
        }

        if (restaurarFocoOrdenacaoAposRenderizar && !popupFalhaOrdenacao)
        {
            restaurarFocoOrdenacaoAposRenderizar = false;
            await RestaurarFocoOrdenacaoAsync();
        }

        if (!preparando && resultado?.Estado == EstadoAberturaCaptura.Aberta
            && identidadeMemoriaParaAlinhar is { } identidade
            && Memorias.Any(memoria => memoria.Identidade == identidade)
            && moduloLista is not null)
        {
            identidadeMemoriaParaAlinhar = null;
            await moduloLista.InvokeVoidAsync("alinharMemoriaNoTopo", identidade, ".captura-dia__barra-fixa");
        }

        if (!preparando && resultado?.Estado == EstadoAberturaCaptura.Aberta && AbaRevisar && moduloRevisao is not null)
        {
            await moduloRevisao.InvokeVoidAsync("atualizarVisibilidadeVoltarTopo");
            if (alinharPrimeiraMemoriaSemCategoria && primeiraMemoriaSemCategoria is { } invalida)
            {
                alinharPrimeiraMemoriaSemCategoria = false;
                primeiraMemoriaSemCategoria = null;
                await moduloLista!.InvokeVoidAsync("alinharMemoriaNoTopo", invalida, ".captura-dia__barra-fixa");
            }
        }

        if (focarInclusaoAposRenderizar && campoInclusao is not null)
        {
            focarInclusaoAposRenderizar = false;
            await campoInclusao.FocarAsync();
        }

        if (rolarPaginaAoAbrirInclusao && inclusaoAberta && moduloLista is not null)
        {
            rolarPaginaAoAbrirInclusao = false;
            await moduloLista.InvokeVoidAsync("rolarConteudoAteFim");
        }

        if (rolarPaginaAposInclusao && !preparando && resultado?.Estado == EstadoAberturaCaptura.Aberta && moduloLista is not null)
        {
            rolarPaginaAposInclusao = false;
            await moduloLista.InvokeVoidAsync("rolarPaginaAteFim");
        }
    }

    [JSInvokable]
    public async Task AoRestaurarPaginaDoCacheAsync()
    {
        await LimparInclusaoEIndicadorAsync();
        popupNavegacaoAberto = false;
        popupCancelamentoInclusao = false;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task AtualizarVisibilidadeVoltarTopo(bool visivel)
    {
        if (revisaoRolavel == visivel) return Task.CompletedTask;
        revisaoRolavel = visivel;
        return InvokeAsync(StateHasChanged);
    }

    private void VoltarSelecao() => Navegacao.NavigateTo("capturar");
    private void VoltarAposFalha() => Navegacao.NavigateTo(
        resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
            ? "principal" : "capturar");

    public async ValueTask DisposeAsync()
    {
        registroMudancaLocal?.Dispose();
        if (moduloCalendario is not null) await moduloCalendario.DisposeAsync();
        if (moduloNavegacao is not null)
        {
            try { await moduloNavegacao.InvokeVoidAsync("desconectar"); }
            catch (JSDisconnectedException) { }
            try { await moduloNavegacao.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (moduloLista is not null)
        {
            try { await moduloLista.InvokeVoidAsync("desconectarOrdenacao"); }
            catch (JSDisconnectedException) { }
            try { await moduloLista.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (moduloRevisao is not null)
        {
            try { await moduloRevisao.InvokeVoidAsync("desconectar"); }
            catch (JSDisconnectedException) { }
            try { await moduloRevisao.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        referenciaNavegacao?.Dispose();
        referenciaRevisao?.Dispose();
    }
}
