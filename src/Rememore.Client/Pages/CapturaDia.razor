@page "/capturar/{DataRota}"
@attribute [Authorize]
@implements IAsyncDisposable
@using Rememore.Client.Infraestrutura.Capturar
@using Rememore.Client.Infraestrutura.TrabalhoLocal
@inject NavigationManager Navegacao
@inject IJSRuntime JS
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject AberturaCaptura Abertura
@inject ICapturasLocais Capturas
@inject ContinuidadeCapturaSessionStorage Continuidade

<PageTitle>Capturar @dataFormatada</PageTitle>

<main class="pagina-captura-dia">
    <CabecalhoAmbiente Titulo="Capturar" MostrarRetorno AoRetornar="VoltarSelecao" />
    <div class="captura-dia__conteudo">
        @if (dataInvalida)
        {
            <h1>Data inválida</h1>
            <p role="alert">Data inválida. Escolha uma data completa, existente e até hoje.</p>
            <button class="button is-link" type="button" @onclick="VoltarSelecao">Voltar à Seleção</button>
        }
        else if (preparando)
        {
            <h1>Captura de @dataFormatada</h1>
            <p aria-busy="true">Preparando captura…</p>
        }
        else if (resultado?.Estado != EstadoAberturaCaptura.Aberta)
        {
            <h1>Captura de @dataFormatada</h1>
            <p role="alert">@MensagemFalha</p>
            <button class="button is-link" type="button" @onclick="VoltarAposFalha">@RotuloRetornoFalha</button>
        }
        else
        {
            <h1>Captura de @dataFormatada</h1>
            <div class="captura-dia__estado" role="status">
                <span class="captura-dia__estado-icone" aria-hidden="true"><i class="@(workspace?.Alterado == true ? "fa-solid fa-pen" : "fa-regular fa-circle-check")"></i></span>
                <span>Workspace @(workspace?.Alterado == true ? "alterado" : "limpo")</span>
            </div>

            <section class="captura-dia__controle" aria-labelledby="controle-temporario-titulo">
                <h2 id="controle-temporario-titulo">Controle temporário de desenvolvimento</h2>
                <button class="button" type="button" disabled="@marcando" @onclick="MarcarAlteradoAsync">Marcar como alterada</button>
                @if (falhaMarcacao)
                {
                    <p role="alert">Não foi possível marcar a captura como alterada. Tente novamente.</p>
                }
            </section>
        }
    </div>
</main>

@code {
    [Parameter] public string DataRota { get; set; } = "";

    private IJSObjectReference? moduloCalendario;
    private IDisposable? registroMudancaLocal;
    private string? ultimaDataRota;
    private DateOnly data;
    private string dataFormatada = "";
    private bool dataInvalida;
    private bool preparando = true;
    private bool marcando;
    private bool falhaMarcacao;
    private ResultadoAberturaCaptura? resultado;
    private WorkspaceCapturaLocal? workspace;

    private string MensagemFalha => resultado?.Estado switch
    {
        EstadoAberturaCaptura.ApiIndisponivel => "Não é possível iniciar uma captura neste navegador. O Rememore precisa do armazenamento local do navegador para proteger suas memórias enquanto você trabalha. Tente utilizar uma versão atualizada de um navegador compatível.",
        EstadoAberturaCaptura.FalhaArmazenamento => "Não foi possível acessar o armazenamento local. O Rememore precisa desse recurso para proteger suas memórias enquanto você trabalha. Verifique as configurações de privacidade do navegador ou tente novamente em uma janela de navegação normal.",
        _ => "Não foi possível preparar esta captura. O trabalho não foi aberto. Volte e tente novamente."
    };
    private string RotuloRetornoFalha => resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
        ? "Voltar à Principal" : "Voltar à Seleção";

    protected override async Task OnParametersSetAsync()
    {
        if (ultimaDataRota is not null && ultimaDataRota != DataRota)
            await Continuidade.LimparAsync();
        ultimaDataRota = DataRota;
        preparando = true;
        dataFormatada = "";
        resultado = null;
        workspace = null;
        falhaMarcacao = false;

        moduloCalendario ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/calendarioCaptura.js");
        var hojeTexto = await moduloCalendario.InvokeAsync<string>("hojeLocal");
        var hoje = DateOnly.ParseExact(hojeTexto, "yyyy-MM-dd");
        dataInvalida = !DatasCaptura.TentarValidar(DataRota, hoje, out data);
        if (dataInvalida) { preparando = false; return; }

        dataFormatada = DatasCaptura.Apresentar(data);
        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is null)
        {
            resultado = new(EstadoAberturaCaptura.FalhaPreparacao);
            preparando = false;
            return;
        }

        var recargaAtiva = await Continuidade.EhRecargaAtivaAsync(identidadeConta, data);
        resultado = await Abertura.AbrirAsync(identidadeConta, data, recargaAtiva);
        workspace = resultado.Workspace;
        if (resultado.Estado == EstadoAberturaCaptura.Aberta)
        {
            await Continuidade.RegistrarAsync(identidadeConta, data);
            registroMudancaLocal ??= Navegacao.RegisterLocationChangingHandler(async contexto =>
            {
                if (!string.Equals(contexto.TargetLocation, Navegacao.Uri, StringComparison.Ordinal))
                    await Continuidade.LimparAsync();
            });
        }
        preparando = false;
    }

    private async Task MarcarAlteradoAsync()
    {
        if (marcando || workspace is null) return;
        marcando = true;
        falhaMarcacao = false;
        try
        {
            var marcacao = await Capturas.MarcarAlteradoAsync(workspace.IdentidadeConta, workspace.Data);
            if (marcacao.Sucesso && marcacao.Valor is not null)
                workspace = marcacao.Valor;
            else falhaMarcacao = true;
        }
        finally { marcando = false; }
    }

    private void VoltarSelecao() => Navegacao.NavigateTo("capturar");
    private void VoltarAposFalha() => Navegacao.NavigateTo(
        resultado?.Estado is EstadoAberturaCaptura.ApiIndisponivel or EstadoAberturaCaptura.FalhaArmazenamento
            ? "principal" : "capturar");

    public async ValueTask DisposeAsync()
    {
        registroMudancaLocal?.Dispose();
        if (moduloCalendario is not null) await moduloCalendario.DisposeAsync();
    }
}
