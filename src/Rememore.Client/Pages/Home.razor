@page "/"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Rememore</PageTitle>

<main class="inicio" aria-labelledby="titulo-inicio">
    <header class="cabecalho">
        <div class="marca" aria-label="Rememore">
            <span class="marca-simbolo" aria-hidden="true">R</span>
            <span>Rememore</span>
        </div>
        <span class="etiqueta">Uma nova etapa</span>
    </header>

    <section class="apresentacao">
        <p class="sobretitulo">Um espaço para lembrar</p>
        <h1 id="titulo-inicio">Suas memórias começam aqui.</h1>
        <p class="descricao">
            Esta é a página inicial do Rememore. O client está funcionando de forma independente,
            pronto para crescer passo a passo.
        </p>

        <div class="estado" role="status">
            <span class="estado-indicador" aria-hidden="true"></span>
            <div class="estado-texto">
                <strong>Client ativo</strong>
                <span>Blazor WebAssembly carregado com sucesso.</span>
            </div>
        </div>

        <section class="categorias" aria-labelledby="titulo-categorias">
            <div class="categorias-cabecalho">
                <div>
                    <p class="sobretitulo">Seus círculos</p>
                    <h2 id="titulo-categorias">Categorias de exemplo</h2>
                </div>
                @if (categorias is not null)
                {
                    <span class="contador-categorias">@categorias.Count</span>
                }
            </div>

            @if (mensagemErro is not null)
            {
                <p class="erro-api" role="alert">@mensagemErro</p>
            }
            else if (carregando)
            {
                <p class="mensagem-categorias" role="status">Carregando categorias…</p>
            }
            else if (categorias is { Count: 0 })
            {
                <p class="mensagem-categorias">A API não retornou categorias.</p>
            }
            else
            {
                <ul class="lista-categorias">
                    @foreach (var categoria in categorias ?? [])
                    {
                        <li>@categoria.Nome</li>
                    }
                </ul>
            }
        </section>
    </section>

    <footer class="rodape">
        <span>Rememore</span>
        <span>Uma lembrança de cada vez.</span>
    </footer>
</main>

@code {
    private List<CategoriaDto>? categorias;
    private string? mensagemErro;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/categorias") ?? [];
        }
        catch (Exception ex)
        {
            mensagemErro = $"Não foi possível carregar as categorias: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private sealed record CategoriaDto(int Id, string Nome);
}

