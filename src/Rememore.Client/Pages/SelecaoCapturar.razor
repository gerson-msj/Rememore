@page "/capturar"
@attribute [Authorize]
@implements IAsyncDisposable
@using Rememore.Client.Infraestrutura.Capturar
@using Rememore.Client.Infraestrutura.OrientacaoProgressiva
@using Rememore.Client.Infraestrutura.TrabalhoLocal
@inject NavigationManager Navegacao
@inject IJSRuntime JS
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject IOrientacaoProgressiva Orientacao
@inject ICapturasLocais Capturas

<PageTitle>Capturar</PageTitle>

<main class="pagina-selecao-capturar">
    <CabecalhoPagina Titulo="Capturar" MostrarVoltar MostrarSair AoRetornar="VoltarPrincipal" AoSair="AbrirPopupSaida" />
    <section class="selecao-capturar__conteudo">
        <h1 class="title is-4">Escolha o dia que deseja capturar</h1>

        @if (carregando)
        {
            <p class="help" aria-busy="true">Carregando seleção…</p>
        }
        else
        {
            @if (textoOrientacao is not null)
            {
                <div class="notification elemento-orientacao-informativa">
                    <span class="elemento-orientacao-informativa__texto">@textoOrientacao</span>
                </div>
            }

            <section class="selecao-capturar__escolha" aria-label="Seleção da data">
                <SeletorData ValorInicial="@hojeTexto" AoMudarValor="AtualizarData" />
                <div class="is-flex is-justify-content-flex-end">
                    <button class="button is-link" type="button" disabled="@(!DataValida)" @onclick="AbrirCaptura">Capturar</button>
                </div>
            </section>

            @if (falhaConsulta)
            {
                <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                    <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <div class="elemento-falha-recuperavel__conteudo">
                        <p class="elemento-falha-recuperavel__mensagem"><strong>Não foi possível verificar as capturas pendentes neste dispositivo.</strong></p>
                        <button class="button is-light elemento-botao-com-icone" type="button" @onclick="CarregarPendenciasAsync">
                            <span class="icon" aria-hidden="true"><i class="fa-solid fa-rotate"></i></span>
                            <span>Tentar novamente</span>
                        </button>
                    </div>
                </div>
            }
            else if (pendencias.Count > 0)
            {
                <section class="selecao-capturar__pendencias" aria-labelledby="titulo-pendencias">
                    <h2 class="title is-5" id="titulo-pendencias">Capturas pendentes</h2>
                    <ListaCapturasPendentes Datas="@pendencias.Select(pendencia => pendencia.Data).ToArray()"
                                            AoAbrir="AbrirPendencia"
                                            AoSolicitarExclusao="SolicitarExclusao" />
                </section>
            }

            @if (falhaRemocao)
            {
                <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                    <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <div class="elemento-falha-recuperavel__conteudo">
                        <p class="elemento-falha-recuperavel__mensagem"><strong>Não foi possível apagar as alterações. Tente novamente.</strong></p>
                    </div>
                </div>
            }
        }
    </section>

    <Popup Aberto="@popupAberto" Titulo="@TituloExclusao" Mensagem="@MensagemExclusaoPopup"
           ClassePopup="popup--sombra-danger" TextoConfirmar="Apagar" TextoCancelar="Cancelar"
           ClasseBotaoConfirmar="is-danger" AoResponder="ResponderExclusaoAsync" />
    <Popup Aberto="@popupSaidaAberto" Mensagem="Deseja realmente sair?"
           TextoConfirmar="Sim" TextoCancelar="Não" ClasseBotaoConfirmar="is-link"
           AoResponder="ResponderSaidaAsync" />
</main>

@code {
    private IJSObjectReference? moduloCalendario;
    private DateOnly hoje;
    private string hojeTexto = "";
    private string valorData = "";
    private string? textoOrientacao;
    private IReadOnlyList<WorkspaceCapturaLocal> pendencias = [];
    private WorkspaceCapturaLocal? pendenciaSelecionada;
    private bool carregando = true;
    private bool falhaConsulta;
    private bool falhaRemocao;
    private bool popupAberto;
    private bool popupSaidaAberto;
    private bool DataValida => valorData.Length > 0;
    private string DataExclusao => pendenciaSelecionada is null ? "" : DatasCaptura.Apresentar(pendenciaSelecionada.Data);
    private string MensagemExclusaoPopup => string.Join("\n\n", MensagemExclusao);
    private string TituloExclusao => pendenciaSelecionada?.Origem switch
    {
        OrigemCapturaLocal.Ausente => $"Apagar as memórias de {DataExclusao}?",
        OrigemCapturaLocal.Presente => $"Apagar as alterações de {DataExclusao}?",
        _ => $"Apagar o trabalho local de {DataExclusao}?"
    };
    private IReadOnlyList<string> MensagemExclusao => pendenciaSelecionada?.Origem switch
    {
        OrigemCapturaLocal.Ausente => ["As memórias desta captura ainda não foram preservadas e serão removidas."],
        OrigemCapturaLocal.Presente => ["As alterações ainda não preservadas serão removidas. As memórias já preservadas desse dia serão mantidas."],
        _ => ["O trabalho ainda não preservado desta captura será removido. Qualquer conteúdo já preservado será mantido."]
    };

    protected override async Task OnInitializedAsync()
    {
        moduloCalendario = await JS.InvokeAsync<IJSObjectReference>("import", "./js/calendarioCaptura.js");
        hojeTexto = await moduloCalendario.InvokeAsync<string>("hojeLocal");
        hoje = DateOnly.ParseExact(hojeTexto, "yyyy-MM-dd");
        valorData = hojeTexto;
        textoOrientacao = await Orientacao.ObterTextoAsync(ContextosOrientacao.SelecaoCapturar);
        await CarregarPendenciasAsync();
        carregando = false;
    }

    private async Task CarregarPendenciasAsync()
    {
        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is null) { falhaConsulta = true; return; }

        var resultado = await Capturas.ConsultarAsync(identidadeConta);
        falhaConsulta = !resultado.Sucesso || resultado.Valor is null;
        pendencias = falhaConsulta ? [] : resultado.Valor!
            .Where(captura => captura.Alterado)
            .OrderBy(captura => captura.Data)
            .ToArray();
    }

    private Task AtualizarData(string? novoValor)
    {
        valorData = novoValor ?? "";
        return Task.CompletedTask;
    }

    private void AbrirCaptura()
    {
        if (DatasCaptura.TentarValidar(valorData, hoje, out var data))
            Navegacao.NavigateTo($"capturar/{data:yyyy-MM-dd}");
    }

    private void AbrirPendencia(DateOnly data) => Navegacao.NavigateTo($"capturar/{data:yyyy-MM-dd}");

    private void SolicitarExclusao(DateOnly data)
    {
        falhaRemocao = false;
        pendenciaSelecionada = pendencias.FirstOrDefault(pendencia => pendencia.Data == data);
        if (pendenciaSelecionada is null) return;
        popupAberto = true;
    }

    private void AbrirPopupSaida() => popupSaidaAberto = true;

    private async Task ResponderExclusaoAsync(RespostaPopup resposta)
    {
        popupAberto = false;
        var selecionada = pendenciaSelecionada;
        pendenciaSelecionada = null;
        if (resposta != RespostaPopup.Confirmacao || selecionada is null) return;

        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is null) { falhaRemocao = true; return; }
        var remocao = await Capturas.RemoverSeAlteradoAsync(identidadeConta, selecionada.Data);
        if (!remocao.Sucesso && remocao.Estado != EstadoOperacaoLocal.Ausente)
        {
            falhaRemocao = true;
            return;
        }

        await CarregarPendenciasAsync();
    }

    private async Task ResponderSaidaAsync(RespostaPopup resposta)
    {
        popupSaidaAberto = false;
        if (resposta != RespostaPopup.Confirmacao) return;

        await EstadoAutenticacao.EncerrarSessaoAsync();
        Navegacao.NavigateTo(new Uri(new Uri(Navegacao.BaseUri), "").ToString());
    }

    private void VoltarPrincipal() => Navegacao.NavigateTo("principal");

    public async ValueTask DisposeAsync()
    {
        if (moduloCalendario is not null) await moduloCalendario.DisposeAsync();
    }
}
