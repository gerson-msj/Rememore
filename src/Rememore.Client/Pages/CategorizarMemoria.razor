@page "/categorizar/{DataRota}/{IdentidadeMemoria}"
@implements IDisposable
@attribute [Authorize]
@using System.Globalization
@using Rememore.Client.Infraestrutura
@using Rememore.Client.Infraestrutura.Capturar
@using Rememore.Client.Infraestrutura.Categorias
@using Rememore.Client.Infraestrutura.OrientacaoProgressiva
@using Rememore.Client.Infraestrutura.TrabalhoLocal
@using Rememore.Client.Componentes
@inject NavigationManager Navegacao
@inject IJSRuntime JS
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject AberturaCaptura Abertura
@inject ICapturasLocais CapturasLocais
@inject CatalogoCategoriasPorConta CatalogoCategorias
@inject IConfiguracaoCapturar ConfiguracaoCapturar
@inject ContinuidadeCapturaSessionStorage Continuidade
@inject TimeProvider Relogio
@inject IFonteNivelOrientacao FonteNivelOrientacao
@inject ResolvedorOrientacaoProgressiva ResolvedorOrientacao

<PageTitle>@TituloDaPagina</PageTitle>

<main class="pagina-categorizar-memoria">
    <CabecalhoAmbiente Titulo="@TituloDaPagina" MostrarRetorno AoRetornar="VoltarParaListaAsync" />
    <div class="categorizar-memoria__espacador-cabecalho" aria-hidden="true"></div>

    @if (dataCaptura is { } data)
    {
        <div class="categorizar-memoria__barra-data">
            <div class="categorizar-memoria__linha-data is-flex is-align-items-center">
                <time class="subtitle is-6 has-text-weight-medium" datetime="@data.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@data.ToString("dddd, d 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("pt-BR"))</time>
            </div>
        </div>
        <div class="categorizar-memoria__espacador-data" aria-hidden="true"></div>
    }
    else
    {
        <div class="categorizar-memoria__espacador-cabecalho" aria-hidden="true"></div>
    }

    @if (OrigemEdicao == AbaOrigemEdicaoCaptura.Revisar && memoriaAtual is not null)
    {
        <nav class="tabs is-centered" aria-label="Perspectiva da edição">
            <ul>
                <li><a href="@ContextoEdicaoCaptura.RotaEdicaoMemoria(DataRota, identidadeMemoria, OrigemEdicao, CategoriaEmAtencaoRota)"
                       @onclick="AlternarParaMemoria" @onclick:preventDefault>Memória</a></li>
                <li class="is-active"><a aria-current="page">Categorização</a></li>
            </ul>
        </nav>
    }

    @if (preparando)
    {
        <p class="section" role="status" aria-busy="true">Preparando Categorização…</p>
    }
    else if (memoriaAtual is null)
    {
        <div class="notification elemento-falha-recuperavel categorizar-memoria__estado" role="alert" aria-atomic="true">
            <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <div class="elemento-falha-recuperavel__conteudo">
                <p class="elemento-falha-recuperavel__mensagem"><strong>Não foi possível abrir esta memória para Categorização.</strong></p>
                <button class="button is-link" type="button" @onclick="VoltarParaListaAsync">Voltar à lista Categorizar</button>
            </div>
        </div>
    }
    else
    {
        <section class="container is-max-desktop p-4 categorizar-memoria__conteudo">
            @if (falhaCatalogo is not null)
            {
                <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                    <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <div class="elemento-falha-recuperavel__conteudo">
                        <p class="elemento-falha-recuperavel__mensagem"><strong>@falhaCatalogo</strong></p>
                        <button class="button is-light elemento-botao-com-icone" type="button" @onclick="RecarregarCatalogoAsync">
                            <span class="icon" aria-hidden="true"><i class="fa-solid fa-rotate"></i></span><span>Tentar novamente</span>
                        </button>
                    </div>
                </div>
            }

            @if (falhaCategorias is not null)
            {
                <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                    <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <div class="elemento-falha-recuperavel__conteudo">
                        <p class="elemento-falha-recuperavel__mensagem"><strong>@falhaCategorias</strong></p>
                        @if (repetirOperacaoCategoria is not null)
                        {
                            <button class="button is-light elemento-botao-com-icone" type="button" disabled="@operacaoCategoriaEmAndamento" @onclick="RepetirOperacaoCategoriaAsync">
                                <span class="icon" aria-hidden="true"><i class="fa-solid fa-rotate"></i></span><span>Tentar novamente</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (falhaTom is not null)
            {
                <div class="notification elemento-falha-recuperavel" role="alert" aria-atomic="true">
                    <span class="icon elemento-falha-recuperavel__icone" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <div class="elemento-falha-recuperavel__conteudo">
                        <p class="elemento-falha-recuperavel__mensagem"><strong>@falhaTom</strong></p>
                        @if (tomParaReintentar.HasValue || reintentarTomAusente)
                        {
                            <button class="button is-light elemento-botao-com-icone" type="button" disabled="@operacaoTomEmAndamento" @onclick="RepetirOperacaoTomAsync">
                                <span class="icon" aria-hidden="true"><i class="fa-solid fa-rotate"></i></span><span>Tentar novamente</span>
                            </button>
                        }
                    </div>
                </div>
            }
            @if (falhaBalanco is not null)
            {
                <div class="notification elemento-falha-recuperavel" role="alert"><p>@falhaBalanco</p></div>
            }

            <label class="label" for="categorizar-memoria-contexto">Memória</label>
            <textarea id="categorizar-memoria-contexto" class="textarea categorizar-memoria__contexto categorizar-memoria__superficie-tom @AparenciaTomAtual.Classes mb-4" style="@AparenciaTomAtual.Estilo" rows="4" readonly>@TextoContexto</textarea>

            <section class="block" aria-labelledby="categorizar-memoria-titulo-categorias">
                <h2 class="label" id="categorizar-memoria-titulo-categorias">Categorias</h2>
                @if (!SomenteLeitura)
                {
                    <div class="notification elemento-orientacao-informativa" role="status">
                        <span class="elemento-orientacao-informativa__texto">@textoOrientacao</span>
                    </div>
                }
                <SeletorCategoria Categorias="CategoriasSelecionadas"
                                  CategoriasDisponiveis="CategoriasDisponiveis"
                                  Tom="@TomVisual"
                                  SomenteLeitura="@SomenteLeitura"
                                  PopupAberto="@popupAberto"
                                  PopupAbertoChanged="AtualizarPopupAsync"
                                  AoAdicionarCategoria="AdicionarCategoriaAsync"
                                  AoCriarCategoria="CriarCategoriaAsync"
                                  AoRemoverCategoria="RemoverCategoriaAsync" />
            </section>

            @if (CategoriasSelecionadas.Count >= 2)
            {
                <div class="notification elemento-orientacao-informativa" role="note" style="border-inline-start-color: var(--bulma-warning);">
                    <span class="elemento-orientacao-informativa__texto">Tente representar esta memória com uma única categoria sempre que possível. Use mais de uma apenas quando isso fizer diferença para você.</span>
                </div>
            }

            @if (nivelOrientacaoAtual >= NivelOrientacao.Intermediario)
            {
                <section class="block" aria-labelledby="categorizar-memoria-titulo-tom">
                    <h2 class="label" id="categorizar-memoria-titulo-tom">Tom</h2>
                    @if (!SomenteLeitura)
                    {
                        <div class="notification elemento-orientacao-informativa" role="note">
                            <span class="elemento-orientacao-informativa__texto">@OrientacaoTomVisual</span>
                        </div>
                    }
                    <SeletorTom @key="ChaveSeletorTom" Valor="@TomConfirmado" Desabilitado="@(!PodeEditarTom || operacaoTomEmAndamento || popupDesativarTomAberto)"
                                AoAlterar="AlterarTomTransitórioAsync" AoConcluir="ConcluirTomAsync" AoSolicitarDesativacao="SolicitarDesativacaoTomAsync" />
                </section>
            }

            @if (nivelOrientacaoAtual >= NivelOrientacao.Intermediario)
            {
            <section class="block" aria-labelledby="categorizar-memoria-titulo-balanco">
                <h2 class="label" id="categorizar-memoria-titulo-balanco">Balanço sentimental</h2>
                @if (!string.IsNullOrWhiteSpace(textoOrientacaoBalanco))
                {
                    <div class="notification elemento-orientacao-informativa" role="note">
                        <span class="elemento-orientacao-informativa__texto">@textoOrientacaoBalanco</span>
                    </div>
                }
                <PreviaBalancoSentimental Texto="@TextoBalancoConfirmado" Acionavel="@PodeAbrirBalanco"
                                          AcionavelSomenteComExcedente="@SomenteLeitura" AoAcionar="AcionarBalancoAsync" />
                @if (!SomenteLeitura)
                {
                    <div class="buttons is-right mt-3">
                        <button class="button is-link" type="button" disabled="@(operacaoBalancoEmAndamento)" @onclick="AbrirBalancoAsync">
                            @(TextoBalancoConfirmado is null ? "Adicionar balanço sentimental" : "Editar balanço sentimental")
                        </button>
                    </div>
                }
            </section>
            }

            <PopupBalancoSentimental @ref="popupBalanco" Aberto="@popupBalancoAberto" Contexto="@ContextoBalanco" TextoConfirmado="@TextoBalancoConfirmado"
                                     RascunhoInicial="@rascunhoBalanco" SomenteLeitura="@popupBalancoSomenteLeitura"
                                     AoAtualizarRascunho="AtualizarRascunhoBalancoAsync" AoSalvar="SalvarBalancoAsync" AoExcluir="ExcluirBalancoAsync"
                                     AoConcluir="ConcluirPopupBalancoAsync" AoContinuarEditando="CancelarNavegacaoPendente" />

            @if (OrigemEdicao != AbaOrigemEdicaoCaptura.Revisar)
            {
            <nav class="buttons is-centered categorizar-memoria__navegacao" aria-label="Navegação entre memórias">
                <button class="button is-light elemento-botao-com-icone" type="button" aria-label="Memória anterior" disabled="@(EhPrimeiraMemoria || operacaoTomEmAndamento || interacaoTomEmAndamento || operacaoCategoriaEmAndamento)" @onclick="IrParaAnterior">
                    <span class="icon" aria-hidden="true"><i class="fa-solid fa-chevron-left"></i></span><span>Anterior</span>
                </button>
                <button class="button is-light elemento-botao-com-icone" type="button" aria-label="Próxima memória" disabled="@(EhUltimaMemoria || operacaoTomEmAndamento || interacaoTomEmAndamento || operacaoCategoriaEmAndamento)" @onclick="IrParaProxima">
                    <span>Próxima</span><span class="icon" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>
                </button>
            </nav>
            }
        </section>
    }
    <Popup Aberto="@popupDesativarTomAberto" Titulo="Desativar o Tom?" Mensagem="O Tom selecionado será apagado. Deseja continuar?"
           TextoConfirmar="Desativar" TextoCancelar="Cancelar" ClasseBotaoConfirmar="is-danger is-light" ClasseBotaoCancelar="is-info" AoResponder="ResponderDesativacaoTomAsync" />
</main>

@code {
    [Parameter] public string DataRota { get; set; } = string.Empty;
    [Parameter] public string IdentidadeMemoria { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "origem")] public string? OrigemRota { get; set; }
    [SupplyParameterFromQuery(Name = "atencao")] public bool CategoriaEmAtencaoRota { get; set; }
    private AbaOrigemEdicaoCaptura OrigemEdicao => ContextoEdicaoCaptura.InterpretarOrigem(OrigemRota, AbaOrigemEdicaoCaptura.Categorizar);
    private string TituloDaPagina => OrigemEdicao == AbaOrigemEdicaoCaptura.Revisar ? "Revisar Categorização" : "Categorização";
    private void AlternarParaMemoria()
    {
        if (operacaoCategoriaEmAndamento || operacaoTomEmAndamento || interacaoTomEmAndamento || popupDesativarTomAberto) return;
        Navegacao.NavigateTo(ContextoEdicaoCaptura.RotaEdicaoMemoria(DataRota,
            Uri.UnescapeDataString(IdentidadeMemoria), OrigemEdicao, CategoriaEmAtencaoRota));
    }

    private bool preparando = true;
    private bool popupAberto;
    private bool operacaoCategoriaEmAndamento;
    private bool operacaoTomEmAndamento;
    private bool interacaoTomEmAndamento;
    private bool popupDesativarTomAberto;
    private bool popupBalancoAberto;
    private bool popupBalancoSomenteLeitura;
    private bool operacaoBalancoEmAndamento;
    private DateOnly? dataCaptura;
    private string identidadeConta = string.Empty;
    private string identidadeMemoria = string.Empty;
    private string? falhaCatalogo;
    private string? falhaCategorias;
    private string? falhaTom;
    private string? falhaBalanco;
    private string? textoOrientacao;
    private int? tomTransitório;
    private int? tomParaReintentar;
    private int? tomEsperadoReintento;
    private int chaveSeletorTom;
    private bool reintentarTomAusente;
    private string? TextoBalancoConfirmado => memoriaAtual?.BalancoSentimental;
    private string ContextoBalanco => $"{identidadeConta}:{dataCaptura:yyyy-MM-dd}:{identidadeMemoria}:{(SomenteLeitura ? "leitura" : "edicao")}";
    private string? textoOrientacaoBalanco;
    private string? rascunhoBalanco;
    private string? destinoNavegacaoPendente;
    private bool retomarNavegacaoAposRender;
    private PopupBalancoSentimental? popupBalanco;
    private bool PodeAbrirBalanco => memoriaAtual is not null && (SomenteLeitura ? TextoBalancoConfirmado is not null : PodeEditarBalanco);
    private bool PodeEditarBalanco => !SomenteLeitura && nivelOrientacaoAtual >= NivelOrientacao.Intermediario;
    private NivelOrientacao nivelOrientacaoAtual = NivelOrientacao.Iniciante;
    private MemoriaCapturaLocal? memoriaAtual;
    private WorkspaceCapturaLocal? workspaceCaptura;
    private IReadOnlyList<MemoriaCapturaLocal> memoriasOrdenadas = [];
    private IReadOnlyList<CategoriaPreservadaRemota> categoriasCatalogo = [];
    private Func<Task>? repetirOperacaoCategoria;
    private IDisposable? registroMudancaLocal;

    private bool SomenteLeitura { get; set; }
    private bool PodeEditarTom => !SomenteLeitura && nivelOrientacaoAtual >= NivelOrientacao.Intermediario;
    private int? TomConfirmado => memoriaAtual?.Tom;
    private int? TomVisual => tomTransitório ?? TomConfirmado;
    private string ChaveSeletorTom => $"{identidadeMemoria}:{chaveSeletorTom}";
    private AparenciaTomVisual AparenciaTomAtual => AparenciaTom.Obter(TomVisual);
    private string OrientacaoTomVisual => nivelOrientacaoAtual == NivelOrientacao.Avancado
        ? "Use o Tom para registrar a impressão geral que esta memória deixa em você."
        : "O Tom registra a impressão geral que esta memória deixa em você. Ative-o para indicar essa percepção entre negativo, neutro e positivo.";
    private IReadOnlyList<CategoriaAssociadaLocal> AssociacoesSelecionadas => memoriaAtual?.Categorias ?? [];
    private IReadOnlyList<string> CategoriasSelecionadas => AssociacoesSelecionadas.Select(categoria => categoria.Nome).ToArray();
    private IReadOnlyList<string> CategoriasDisponiveis => categoriasCatalogo.Where(categoria => categoria.Ativa)
        .Select(categoria => categoria.Nome)
        .Concat(memoriasOrdenadas.SelectMany(memoria => memoria.Categorias ?? []).Select(categoria => categoria.Nome))
        .DistinctBy(PesquisaCategorias.Normalizar).ToArray();
    private string TextoContexto => memoriaAtual is null ? string.Empty
        : string.Join("\n\n", new[] { memoriaAtual.Conteudo }
            .Concat((memoriaAtual.Complementos ?? []).OrderBy(complemento => complemento.Ordem).Select(complemento => complemento.Conteudo)));
    private int IndiceMemoriaAtual => memoriasOrdenadas.ToList().FindIndex(memoria => memoria.Identidade == identidadeMemoria);
    private bool EhPrimeiraMemoria => IndiceMemoriaAtual <= 0;
    private bool EhUltimaMemoria => IndiceMemoriaAtual < 0 || IndiceMemoriaAtual >= memoriasOrdenadas.Count - 1;

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (!retomarNavegacaoAposRender || destinoNavegacaoPendente is not { } destino) return;
        retomarNavegacaoAposRender = false;
        destinoNavegacaoPendente = null;
        var destinoEhOutraPerspectivaDaRevisao = OrigemEdicao == AbaOrigemEdicaoCaptura.Revisar
            && Navegacao.ToAbsoluteUri(destino).AbsolutePath.Contains("/editar-memoria/", StringComparison.OrdinalIgnoreCase);
        if (!destinoEhOutraPerspectivaDaRevisao) await Continuidade.LimparAutorizacaoCategoriaAsync();
        Navegacao.NavigateTo(destino, replace: false);
    }

    protected override async Task OnParametersSetAsync()
    {
        var identidadeSolicitada = Uri.UnescapeDataString(IdentidadeMemoria);
        if (!preparando && workspaceCaptura is not null && memoriaAtual is not null
            && dataCaptura is { } dataAberta && DataRota == dataAberta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            && identidadeConta == EstadoAutenticacao.IdentidadeConta)
        {
            var destino = memoriasOrdenadas.SingleOrDefault(memoria => memoria.Identidade == identidadeSolicitada);
            if (destino is not null)
            {
                popupAberto = false;
                popupDesativarTomAberto = false;
                popupBalancoAberto = false;
                popupBalancoSomenteLeitura = false;
                tomTransitório = null;
                interacaoTomEmAndamento = false;
                identidadeMemoria = identidadeSolicitada;
                await DefinirMemoriaAtualAsync(destino, restaurarAutorizacao: false);
                return;
            }
        }

        preparando = true;
        popupAberto = false;
        popupDesativarTomAberto = false;
        tomTransitório = null;
        interacaoTomEmAndamento = false;
        memoriaAtual = null;
        workspaceCaptura = null;
        dataCaptura = null;
        textoOrientacao = null;
        falhaCatalogo = null;
        falhaCategorias = null;
        falhaTom = null;
        SomenteLeitura = false;
        registroMudancaLocal ??= Navegacao.RegisterLocationChangingHandler(InterceptarNavegacaoAsync);

        var moduloCalendario = await JS.InvokeAsync<IJSObjectReference>("import", "./js/calendarioCaptura.js");
        try
        {
            var hojeTexto = await moduloCalendario.InvokeAsync<string>("hojeLocal");
            var hoje = DateOnly.ParseExact(hojeTexto, "yyyy-MM-dd", CultureInfo.InvariantCulture);
            if (!DatasCaptura.TentarValidar(DataRota, hoje, out var data)
                || string.IsNullOrWhiteSpace(IdentidadeMemoria)
                || EstadoAutenticacao.IdentidadeConta is not { } conta) return;

            identidadeConta = conta;
            dataCaptura = data;
            identidadeMemoria = identidadeSolicitada;
            var resultado = await Abertura.AbrirAsync(conta, data, continuidadeAtiva: true);
            if (resultado.Estado != EstadoAberturaCaptura.Aberta || resultado.Workspace is not { } workspace
                || workspace.IdentidadeConta != conta || workspace.Data != data) return;

            workspaceCaptura = workspace;
            AtualizarMemorias(workspace);
            memoriaAtual = memoriasOrdenadas.SingleOrDefault(memoria => memoria.Identidade == identidadeMemoria);
            if (memoriaAtual is null) return;

            await DefinirMemoriaAtualAsync(memoriaAtual, restaurarAutorizacao: true);
            var catalogo = await CatalogoCategorias.AtualizarAsync(conta);
            categoriasCatalogo = catalogo.Categorias;
            if (!catalogo.Disponivel || catalogo.FalhaCache)
                falhaCatalogo = catalogo.FalhaCache
                    ? "Não foi possível atualizar o cache local do catálogo. As categorias conhecidas desta captura continuam disponíveis."
                    : "Não foi possível consultar o catálogo preservado. As categorias conhecidas desta captura continuam disponíveis.";
        }
        finally
        {
            await moduloCalendario.DisposeAsync();
            preparando = false;
        }
    }

    private async Task DefinirMemoriaAtualAsync(MemoriaCapturaLocal memoria, bool restaurarAutorizacao)
    {
        memoriaAtual = memoria;
        var configuracao = await ConfiguracaoCapturar.ObterAsync();
        var autorizacaoDaSessao = restaurarAutorizacao && dataCaptura is { } data
            && await Continuidade.RecuperarAutorizacaoCategoriaAsync(identidadeConta, data, memoria.Identidade);
        var autorizacao = RegraEdicaoMemoria.Resolver(memoria, configuracao, Relogio.GetUtcNow(),
            autorizacaoDaSessao ? true : null);
        SomenteLeitura = !autorizacao.DadosValidos || !autorizacao.Concedida;
        if (dataCaptura is { } dataAtual)
        {
            if (SomenteLeitura) await Continuidade.LimparAutorizacaoCategoriaAsync();
            else await Continuidade.RegistrarAutorizacaoCategoriaAsync(identidadeConta, dataAtual, memoria.Identidade);
        }

        nivelOrientacaoAtual = await FonteNivelOrientacao.ObterNivelAsync();
        if (!SomenteLeitura)
        {
            textoOrientacao = ResolvedorOrientacao.ObterTextoAsync(ContextosOrientacao.CategorizacaoCategoria, nivelOrientacaoAtual);
        }
        else
        {
            nivelOrientacaoAtual = await FonteNivelOrientacao.ObterNivelAsync();
            textoOrientacao = null;
        }
        textoOrientacaoBalanco = nivelOrientacaoAtual switch
        {
            NivelOrientacao.Intermediario => "O balanço sentimental é uma extensão opcional da memória para registrar, em palavras, os sentimentos que ela despertou em você, positivos e negativos.",
            NivelOrientacao.Avancado => "Use o balanço sentimental para registrar os sentimentos que esta memória despertou em você.",
            _ => null
        };
        if (restaurarAutorizacao && dataCaptura is { } dataRascunho)
        {
            var recuperado = await Continuidade.RecuperarBalancoSentimentalAsync(identidadeConta, dataRascunho, memoria.Identidade);
            if (recuperado is not null && recuperado.AutorizacaoConcedida && PodeEditarBalanco
                && recuperado.TextoConfirmadoBase == memoria.BalancoSentimental)
            {
                rascunhoBalanco = recuperado.Texto;
                popupBalancoSomenteLeitura = false;
                popupBalancoAberto = true;
            }
            else if (recuperado is not null)
            {
                falhaBalanco = "Não foi possível retomar este rascunho porque a memória ou a autorização mudou. O balanço confirmado foi preservado.";
                await Continuidade.LimparBalancoSentimentalAsync(identidadeConta, dataRascunho, memoria.Identidade);
            }
        }
    }

    private void AtualizarMemorias(WorkspaceCapturaLocal workspace)
    {
        memoriasOrdenadas = workspace.Memorias.OrderBy(memoria => memoria.Ordem).ToArray();
    }

    private async Task CarregarCatalogoAsync()
    {
        falhaCatalogo = null;
        var resultado = await CatalogoCategorias.AtualizarAsync(identidadeConta);
        categoriasCatalogo = resultado.Categorias;
        if (!resultado.Disponivel || resultado.FalhaCache)
            falhaCatalogo = resultado.FalhaCache
                ? "Não foi possível atualizar o cache local do catálogo. As categorias conhecidas desta captura continuam disponíveis."
                : "Não foi possível consultar o catálogo preservado. As categorias conhecidas desta captura continuam disponíveis.";
    }

    private Task RecarregarCatalogoAsync() => CarregarCatalogoAsync();

    private async Task AbrirBalancoAsync()
    {
        if (!PodeEditarBalanco || operacaoBalancoEmAndamento || memoriaAtual is null || dataCaptura is not { } data) return;
        popupAberto = false;
        rascunhoBalanco = memoriaAtual.BalancoSentimental;
        popupBalancoSomenteLeitura = false;
        falhaBalanco = null;
        popupBalancoAberto = true;
        var protegido = await Continuidade.RegistrarBalancoSentimentalAsync(identidadeConta, data, identidadeMemoria,
            memoriaAtual.BalancoSentimental, rascunhoBalanco ?? string.Empty, autorizacaoConcedida: true);
        if (!protegido) falhaBalanco = "Não foi possível proteger o rascunho nesta sessão. Mantenha o editor aberto até salvar ou copiar seu texto.";
    }

    private Task AcionarBalancoAsync() => SomenteLeitura ? AbrirBalancoLeituraAsync() : AbrirBalancoAsync();

    private Task AbrirBalancoLeituraAsync()
    {
        if (!SomenteLeitura || memoriaAtual?.BalancoSentimental is null) return Task.CompletedTask;
        popupAberto = false;
        popupBalancoSomenteLeitura = true;
        popupBalancoAberto = true;
        return Task.CompletedTask;
    }

    private async Task AtualizarRascunhoBalancoAsync(string? texto)
    {
        rascunhoBalanco = texto;
        if (dataCaptura is not { } data || memoriaAtual is null) return;
        if (texto is null)
            await Continuidade.LimparBalancoSentimentalAsync(identidadeConta, data, identidadeMemoria);
        else if (!await Continuidade.RegistrarBalancoSentimentalAsync(identidadeConta, data, identidadeMemoria,
                     memoriaAtual.BalancoSentimental, texto, PodeEditarBalanco))
            falhaBalanco = "Não foi possível proteger o rascunho nesta sessão. Mantenha o editor aberto até salvar ou copiar seu texto.";
    }

    private async Task<bool> SalvarBalancoAsync(string texto)
    {
        if (!PodeEditarBalanco || operacaoBalancoEmAndamento || dataCaptura is not { } data || memoriaAtual is null
            || string.IsNullOrWhiteSpace(texto)) return false;
        operacaoBalancoEmAndamento = true;
        falhaBalanco = null;
        try
        {
            var atual = memoriaAtual;
            var resultado = await CapturasLocais.ConfirmarBalancoSentimentalAsync(identidadeConta, data,
                atual.Identidade, atual.BalancoSentimental, texto);
            if (resultado.Sucesso && resultado.Valor is { } workspace)
            {
                workspaceCaptura = workspace;
                AtualizarMemorias(workspace);
                memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == atual.Identidade);
                return memoriaAtual?.BalancoSentimental == texto;
            }
            if (resultado.Falha?.Codigo == "ContextoAlterado")
            {
                await RecarregarWorkspaceBalancoAsync(data, atual.Identidade);
                falhaBalanco = "O balanço mudou em outra aba. O estado protegido foi recarregado; confira e tente novamente.";
            }
            else falhaBalanco = "Não foi possível salvar o balanço sentimental. Seu texto continua aqui. Tente novamente.";
            return false;
        }
        finally { operacaoBalancoEmAndamento = false; }
    }

    private Task<bool> ExcluirBalancoAsync() => SalvarAusenciaBalancoAsync();

    private async Task<bool> SalvarAusenciaBalancoAsync()
    {
        if (!PodeEditarBalanco || operacaoBalancoEmAndamento || dataCaptura is not { } data || memoriaAtual?.BalancoSentimental is not { } confirmado) return false;
        operacaoBalancoEmAndamento = true;
        falhaBalanco = null;
        try
        {
            var atual = memoriaAtual;
            var resultado = await CapturasLocais.ConfirmarBalancoSentimentalAsync(identidadeConta, data,
                atual.Identidade, confirmado, null);
            if (resultado.Sucesso && resultado.Valor is { } workspace)
            {
                workspaceCaptura = workspace;
                AtualizarMemorias(workspace);
                memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == atual.Identidade);
                return memoriaAtual?.BalancoSentimental is null;
            }
            if (resultado.Falha?.Codigo == "ContextoAlterado") await RecarregarWorkspaceBalancoAsync(data, atual.Identidade);
            falhaBalanco = "Não foi possível excluir o balanço sentimental. Seu texto continua aqui. Tente novamente.";
            return false;
        }
        finally { operacaoBalancoEmAndamento = false; }
    }

    private async Task RecarregarWorkspaceBalancoAsync(DateOnly data, string idMemoria)
    {
        var recuperacao = await CapturasLocais.RecuperarAsync(identidadeConta, data);
        if (!recuperacao.Sucesso || recuperacao.Valor is not { } workspace) return;
        workspaceCaptura = workspace;
        AtualizarMemorias(workspace);
        memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == idMemoria);
    }

    private async Task ConcluirPopupBalancoAsync(ResultadoPopupBalanco resultado)
    {
        popupBalancoAberto = false;
        popupBalancoSomenteLeitura = false;
        if (resultado is ResultadoPopupBalanco.Salvo or ResultadoPopupBalanco.Excluido or ResultadoPopupBalanco.Descartado or ResultadoPopupBalanco.FechadoSemAlteracao)
        {
            rascunhoBalanco = null;
            if (dataCaptura is { } data) await Continuidade.LimparBalancoSentimentalAsync(identidadeConta, data, identidadeMemoria);
        }
        if (destinoNavegacaoPendente is not null)
        {
            retomarNavegacaoAposRender = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CancelarNavegacaoPendente()
    {
        destinoNavegacaoPendente = null;
        return Task.CompletedTask;
    }

    private async ValueTask InterceptarNavegacaoAsync(LocationChangingContext contexto)
    {
        if (operacaoCategoriaEmAndamento || operacaoTomEmAndamento || interacaoTomEmAndamento || operacaoBalancoEmAndamento)
        {
            contexto.PreventNavigation();
            return;
        }
        if (popupBalancoAberto && !popupBalancoSomenteLeitura && !string.IsNullOrEmpty(contexto.TargetLocation))
        {
            contexto.PreventNavigation();
            destinoNavegacaoPendente = contexto.TargetLocation;
            if (popupBalanco is not null) await popupBalanco.SolicitarSaidaAsync();
            return;
        }
        var destino = Navegacao.ToAbsoluteUri(contexto.TargetLocation).AbsolutePath;
        var destinoEhOutraPerspectivaDaRevisao = OrigemEdicao == AbaOrigemEdicaoCaptura.Revisar
            && destino.Contains("/editar-memoria/", StringComparison.OrdinalIgnoreCase);
        if (!destinoEhOutraPerspectivaDaRevisao && !destino.Contains("/categorizar/", StringComparison.OrdinalIgnoreCase))
            await Continuidade.LimparAutorizacaoCategoriaAsync();
    }

    private Task AtualizarPopupAsync(bool aberto)
    {
        popupAberto = aberto && !SomenteLeitura && !operacaoCategoriaEmAndamento;
        return Task.CompletedTask;
    }

    private Task AdicionarCategoriaAsync(string nome)
    {
        if (SomenteLeitura || operacaoCategoriaEmAndamento) return Task.CompletedTask;
        var existente = ObterCategoriaDisponivel(nome);
        if (existente is null || AssociacoesSelecionadas.Any(item => Equivalentes(item.Nome, nome))) return Task.CompletedTask;
        var novas = AssociacoesSelecionadas.Append(existente).ToArray();
        repetirOperacaoCategoria = () => PersistirCategoriasAsync(novas);
        return PersistirCategoriasAsync(novas);
    }

    private Task CriarCategoriaAsync(string nome)
    {
        var nomePreservado = nome.Trim();
        if (SomenteLeitura || operacaoCategoriaEmAndamento || string.IsNullOrWhiteSpace(nomePreservado)
            || CategoriasDisponiveis.Any(atual => Equivalentes(atual, nomePreservado))) return Task.CompletedTask;
        var categoria = new CategoriaAssociadaLocal($"local-{Guid.NewGuid():N}", nomePreservado, OrigemCategoriaLocal.Local);
        var novas = AssociacoesSelecionadas.Append(categoria).ToArray();
        repetirOperacaoCategoria = () => PersistirCategoriasAsync(novas);
        return PersistirCategoriasAsync(novas);
    }

    private Task RemoverCategoriaAsync(string nome)
    {
        if (SomenteLeitura || operacaoCategoriaEmAndamento) return Task.CompletedTask;
        var novas = AssociacoesSelecionadas.Where(item => !string.Equals(item.Nome, nome, StringComparison.Ordinal)).ToArray();
        if (novas.Length == AssociacoesSelecionadas.Count) return Task.CompletedTask;
        repetirOperacaoCategoria = () => PersistirCategoriasAsync(novas);
        return PersistirCategoriasAsync(novas);
    }

    private CategoriaAssociadaLocal? ObterCategoriaDisponivel(string nome)
    {
        var associadaNaCaptura = memoriasOrdenadas.SelectMany(memoria => memoria.Categorias ?? [])
            .FirstOrDefault(item => Equivalentes(item.Nome, nome));
        if (associadaNaCaptura is not null) return associadaNaCaptura;
        var preservada = categoriasCatalogo.FirstOrDefault(item => item.Ativa && Equivalentes(item.Nome, nome));
        return preservada is null ? null
            : new(preservada.Identidade, preservada.Nome, OrigemCategoriaLocal.Preservada, preservada.Versao);
    }

    private async Task PersistirCategoriasAsync(IReadOnlyList<CategoriaAssociadaLocal> novas)
    {
        if (operacaoCategoriaEmAndamento || SomenteLeitura || dataCaptura is not { } data || memoriaAtual is null) return;
        operacaoCategoriaEmAndamento = true;
        falhaCategorias = null;
        try
        {
            var esperadas = memoriaAtual.Categorias ?? [];
            var gravacao = await CapturasLocais.ConfirmarCategoriasAsync(identidadeConta, data,
                identidadeMemoria, esperadas, novas);
            if (gravacao.Sucesso && gravacao.Valor is { } atualizado)
            {
                workspaceCaptura = atualizado;
                AtualizarMemorias(atualizado);
                memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == identidadeMemoria);
                repetirOperacaoCategoria = null;
            }
            else if (gravacao.Falha?.Codigo == "ContextoAlterado")
            {
                var atual = await CapturasLocais.RecuperarAsync(identidadeConta, data);
                if (atual.Sucesso && atual.Valor is { } workspace)
                {
                    workspaceCaptura = workspace;
                    AtualizarMemorias(workspace);
                    memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == identidadeMemoria);
                }
                repetirOperacaoCategoria = null;
                falhaCategorias = "As categorias mudaram em outra aba. O estado atual foi recarregado; confira e tente novamente.";
            }
            else
            {
                falhaCategorias = "Não foi possível confirmar a alteração no armazenamento local. As categorias confirmadas foram mantidas.";
            }
        }
        finally
        {
            operacaoCategoriaEmAndamento = false;
        }
    }

    private Task AlterarTomTransitórioAsync(int? tom)
    {
        if (!PodeEditarTom || operacaoTomEmAndamento || memoriaAtual is null) return Task.CompletedTask;
        tomTransitório = tom;
        interacaoTomEmAndamento = true;
        falhaTom = null;
        return Task.CompletedTask;
    }

    private async Task ConcluirTomAsync(int? tom)
    {
        if (!PodeEditarTom || operacaoTomEmAndamento || memoriaAtual is null) return;
        var valor = Math.Clamp(tom ?? 0, -100, 100);
        interacaoTomEmAndamento = false;
        if (valor == memoriaAtual.Tom)
        {
            tomTransitório = null;
            return;
        }
        await PersistirTomAsync(valor);
    }

    private Task SolicitarDesativacaoTomAsync()
    {
        if (!PodeEditarTom || operacaoTomEmAndamento || interacaoTomEmAndamento || memoriaAtual?.Tom is null)
            return Task.CompletedTask;
        popupDesativarTomAberto = true;
        return Task.CompletedTask;
    }

    private async Task ResponderDesativacaoTomAsync(RespostaPopup resposta)
    {
        popupDesativarTomAberto = false;
        if (resposta != RespostaPopup.Confirmacao || memoriaAtual?.Tom is not { } tom) return;
        tomEsperadoReintento = tom;
        reintentarTomAusente = true;
        tomParaReintentar = null;
        await PersistirTomAsync(null);
    }

    private async Task PersistirTomAsync(int? novoTom)
    {
        if (!PodeEditarTom || operacaoTomEmAndamento || dataCaptura is not { } data || memoriaAtual is null) return;
        var memoriaDaOperacao = memoriaAtual;
        var tomEsperado = memoriaDaOperacao.Tom;
        if (novoTom is < -100 or > 100 || novoTom == tomEsperado)
        {
            tomTransitório = null;
            interacaoTomEmAndamento = false;
            return;
        }

        operacaoTomEmAndamento = true;
        falhaTom = null;
        try
        {
            var gravacao = await CapturasLocais.ConfirmarTomAsync(identidadeConta, data,
                memoriaDaOperacao.Identidade, tomEsperado, novoTom);
            if (gravacao.Sucesso && gravacao.Valor is { } atualizado)
            {
                workspaceCaptura = atualizado;
                AtualizarMemorias(atualizado);
                memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == memoriaDaOperacao.Identidade);
                tomTransitório = null;
                tomParaReintentar = null;
                reintentarTomAusente = false;
                falhaTom = null;
            }
            else if (gravacao.Falha?.Codigo == "ContextoAlterado")
            {
                var atual = await CapturasLocais.RecuperarAsync(identidadeConta, data);
                if (atual.Sucesso && atual.Valor is { } workspace)
                {
                    workspaceCaptura = workspace;
                    AtualizarMemorias(workspace);
                    memoriaAtual = memoriasOrdenadas.SingleOrDefault(item => item.Identidade == memoriaDaOperacao.Identidade);
                }
                tomTransitório = null;
                tomParaReintentar = null;
                reintentarTomAusente = false;
                falhaTom = "O Tom mudou em outra aba. O estado protegido foi recarregado; confira e tente novamente.";
                chaveSeletorTom++;
            }
            else
            {
                tomTransitório = null;
                tomParaReintentar = novoTom;
                tomEsperadoReintento = tomEsperado;
                reintentarTomAusente = novoTom is null;
                falhaTom = "Não foi possível confirmar o Tom no armazenamento local. O valor confirmado foi mantido.";
                chaveSeletorTom++;
            }
        }
        finally
        {
            interacaoTomEmAndamento = false;
            operacaoTomEmAndamento = false;
        }
    }

    private Task RepetirOperacaoTomAsync()
    {
        if (tomEsperadoReintento != memoriaAtual?.Tom) return Task.CompletedTask;
        var valor = reintentarTomAusente ? (int?)null : tomParaReintentar;
        return PersistirTomAsync(valor);
    }

    private async Task RepetirOperacaoCategoriaAsync()
    {
        var repetir = repetirOperacaoCategoria;
        if (repetir is not null) await repetir();
    }

    private async Task IrParaAnterior()
    {
        var indice = IndiceMemoriaAtual;
        if (indice <= 0) return;
        await NavegarParaMemoriaAsync(memoriasOrdenadas[indice - 1]);
    }

    private async Task IrParaProxima()
    {
        var indice = IndiceMemoriaAtual;
        if (indice < 0 || indice >= memoriasOrdenadas.Count - 1) return;
        await NavegarParaMemoriaAsync(memoriasOrdenadas[indice + 1]);
    }

    private Task NavegarParaMemoriaAsync(MemoriaCapturaLocal memoria)
    {
        if (operacaoCategoriaEmAndamento || operacaoTomEmAndamento || interacaoTomEmAndamento) return Task.CompletedTask;
        popupAberto = false;
        Navegacao.NavigateTo(ContextoEdicaoCaptura.RotaCategorizacao(DataRota, memoria.Identidade, OrigemEdicao, CategoriaEmAtencaoRota));
        return Task.CompletedTask;
    }

    private async Task VoltarParaListaAsync()
    {
        if (operacaoCategoriaEmAndamento || operacaoTomEmAndamento || interacaoTomEmAndamento) return;
        await Continuidade.LimparAutorizacaoCategoriaAsync();
        Navegacao.NavigateTo(ContextoEdicaoCaptura.RotaRetorno(DataRota, OrigemEdicao, identidadeMemoria, CategoriaEmAtencaoRota));
    }

    private static bool Equivalentes(string primeira, string segunda) =>
        string.Equals(PesquisaCategorias.Normalizar(primeira), PesquisaCategorias.Normalizar(segunda), StringComparison.Ordinal);

    public void Dispose() => registroMudancaLocal?.Dispose();
}
