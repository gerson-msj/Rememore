@page "/rememorar/categoria/{categoria}"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.JSInterop
@using Rememore.Client.Componentes
@using Rememore.Client.Infraestrutura
@using Rememore.Client.Infraestrutura.Categorias
@using Rememore.Client.Infraestrutura.Rememorar
@inject NavigationManager Navegacao
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject SincronizadorProjecaoPanorama Sincronizador
@inject CoordenadorConsultaMemoriasCategoria Coordenador
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@TituloPagina</PageTitle>

@if (carregando)
{
    <main class="pagina-detalhe-categoria" aria-busy="true">
        <p class="rememorar-estado" role="status">Carregando...</p>
    </main>
}
else if (categoriaAtual is not null && modeloTemporal is not null)
{
    <main class="pagina-detalhe-categoria">
        <CabecalhoAmbiente Titulo="@categoriaAtual.Nome" MostrarRetorno AoRetornar="VoltarAoPanorama" />

        <section class="detalhe-categoria-controles" aria-label="Período">
            <div class="detalhe-categoria-controles__conteudo">
                <JanelaTemporal Modelo="@modeloTemporal" TomPreciso="@tomPublicado" />
            </div>
        </section>

        @if (Coordenador.Publicado is not null)
        {
            <section class="detalhe-categoria-graficos-area" aria-label="Sínteses da categoria">
                <div class="columns is-mobile is-variable is-1 variacao-tom-comparacao">
                    <div class="column">
                        <OndaUtilizacaoCategoria Serie="@serieUtilizacaoPublicada" Tom="@tomPublicado" />
                    </div>
                    <div class="column">
                        <VariacaoTomCategoria Tons="@tonsPublicados" />
                    </div>
                </div>
            </section>

            <div class="detalhe-categoria-conteudo">
                @if (Coordenador.Falha is not null)
                {
                    <div class="notification is-danger is-light" role="alert" aria-atomic="true">
                        <p>Não foi possível carregar as memórias. Tente novamente.</p>
                        <button class="button is-link mt-3" type="button" @onclick="TentarNovamenteAsync"
                                disabled="@Coordenador.Carregando">Tentar novamente</button>
                    </div>
                }
                <section class="detalhe-categoria-memorias" aria-label="Memórias da categoria">
                    <ListaMemoriasCategoria Itens="@memoriasPublicadas" NomeAcessivel="@NomeAcessivelMemorias" />
                </section>
            </div>
        }
        else
        {
            <div class="detalhe-categoria-conteudo">
                @if (Coordenador.Falha is not null)
                {
                    <div class="notification is-danger is-light" role="alert" aria-atomic="true">
                        <p>Não foi possível carregar as memórias. Tente novamente.</p>
                        <button class="button is-link mt-3" type="button" @onclick="TentarNovamenteAsync"
                                disabled="@Coordenador.Carregando">Tentar novamente</button>
                    </div>
                }
                else
                {
                    <p class="rememorar-estado" role="status" aria-busy="@Coordenador.Carregando">Carregando...</p>
                }
            </div>
        }
    </main>
}

@code {
    [Parameter] public string categoria { get; set; } = string.Empty;

    private IJSObjectReference? moduloEstado;
    private CategoriaPreservadaRemota? categoriaAtual;
    private ModeloJanelaTemporal? modeloTemporal;
    private IReadOnlyList<BlocoDiaPanoramaRemoto> diasPreservados = [];
    private IReadOnlyList<double> serieUtilizacaoPublicada = [];
    private IReadOnlyList<double?> tonsPublicados = [];
    private IReadOnlyList<ItemListaMemoriasCategoria> memoriasPublicadas = [];
    private PublicacaoMemoriasCategoria? publicacaoMaterializada;
    private IntervaloJanelaTemporal? intervaloSolicitado;
    private double? tomPublicado;
    private bool carregando = true;
    private bool inscritoModelo;
    private bool inscritoCoordenador;
    private long geracaoCarregamento;
    private string TituloPagina => categoriaAtual is null ? "Rememorar" : $"{categoriaAtual.Nome} — Rememorar";
    private string NomeAcessivelMemorias => categoriaAtual is null
        ? "Memórias da categoria"
        : $"Memórias da categoria {categoriaAtual.Nome}";

    protected override async Task OnParametersSetAsync()
    {
        var geracao = ++geracaoCarregamento;
        DesinscreverEventos();
        carregando = true;
        categoriaAtual = null;
        modeloTemporal = null;
        diasPreservados = [];
        serieUtilizacaoPublicada = [];
        tonsPublicados = [];
        memoriasPublicadas = [];
        publicacaoMaterializada = null;
        intervaloSolicitado = null;
        tomPublicado = null;

        try
        {
            var identidadeConta = EstadoAutenticacao.IdentidadeConta;
            var identidadeSessao = EstadoAutenticacao.IdentidadeSessao;
            if (!EstadoAutenticacao.Autenticado || identidadeConta is null || identidadeSessao is null
                || string.IsNullOrWhiteSpace(categoria))
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            moduloEstado ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/estadoRememorar.js");
            var contexto = await moduloEstado.InvokeAsync<ContextoJornadaPanorama?>(
                "lerContexto", identidadeConta, identidadeSessao);
            if (!ContextoValido(contexto, identidadeConta, identidadeSessao, categoria))
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            var preparacao = await Sincronizador.PrepararAsync(identidadeConta);
            if (geracao != geracaoCarregamento) return;
            if (!preparacao.Disponivel)
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            categoriaAtual = preparacao.Categorias.FirstOrDefault(item =>
                item.Ativa && string.Equals(item.Identidade, categoria, StringComparison.Ordinal));
            if (categoriaAtual is null)
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            diasPreservados = preparacao.Dias.OrderBy(dia => dia.Data, StringComparer.Ordinal).ToArray();
            var datas = diasPreservados
                .Select(dia => DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture))
                .ToArray();
            if (datas.Length < 2 || !CriarModeloTemporal(datas, contexto!, out var modeloRestaurado)
                || modeloRestaurado is null)
            {
                categoriaAtual = null;
                NavegarAoPanoramaSeguro();
                return;
            }

            modeloTemporal = modeloRestaurado;
            modeloTemporal.OperacaoConcluida += AoConcluirOperacaoTemporal;
            inscritoModelo = true;
            Coordenador.Atualizado += AoAtualizarConsulta;
            inscritoCoordenador = true;

            var intervaloInicial = modeloTemporal.Estado.IntervaloValidoAtual
                ?? modeloTemporal.Estado.UltimoIntervaloValido;
            if (intervaloInicial is null)
            {
                categoriaAtual = null;
                NavegarAoPanoramaSeguro();
                return;
            }

            intervaloSolicitado = intervaloInicial;
            await Coordenador.AbrirAsync(identidadeConta, identidadeSessao, categoriaAtual.Identidade, intervaloInicial);
            if (geracao != geracaoCarregamento) return;
            MaterializarPublicacao();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or ArgumentException
            or FormatException or TaskCanceledException)
        {
            categoriaAtual = null;
            modeloTemporal = null;
            NavegarAoPanoramaSeguro();
        }
        finally
        {
            if (geracao == geracaoCarregamento)
                carregando = false;
        }
    }

    private static bool ContextoValido(
        ContextoJornadaPanorama? contexto,
        string identidadeConta,
        string identidadeSessao,
        string identidadeCategoria) =>
        contexto is not null
        && contexto.Versao == 1
        && contexto.IdentidadeConta == identidadeConta
        && contexto.IdentidadeSessao == identidadeSessao
        && string.Equals(contexto.CategoriaSelecionada, identidadeCategoria, StringComparison.Ordinal)
        && double.IsFinite(contexto.PosicaoInicio)
        && double.IsFinite(contexto.PosicaoFim)
        && contexto.PosicaoInicio is >= 0 and <= 1
        && contexto.PosicaoFim is >= 0 and <= 1
        && contexto.PosicaoInicio <= contexto.PosicaoFim;

    private static bool CriarModeloTemporal(
        IReadOnlyList<DateOnly> datas,
        ContextoJornadaPanorama contexto,
        out ModeloJanelaTemporal? modelo)
    {
        modelo = null;
        if (!DateOnly.TryParseExact(contexto.UltimaDataInicio, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var inicio)
            || !DateOnly.TryParseExact(contexto.UltimaDataFim, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var fim))
            return false;

        var indiceInicio = Array.IndexOf(datas.ToArray(), inicio);
        var indiceFim = Array.IndexOf(datas.ToArray(), fim);
        if (indiceInicio < 0 || indiceFim <= indiceInicio) return false;

        var intervalo = new IntervaloJanelaTemporal(indiceInicio, indiceFim, inicio, fim);
        var restauracao = new EstadoJanelaTemporalRestaurado(
            contexto.PosicaoInicio, contexto.PosicaoFim, intervalo);
        modelo = new ModeloJanelaTemporal(datas, restauracao);
        return true;
    }

    private void AoConcluirOperacaoTemporal(ConclusaoOperacaoJanelaTemporal conclusao)
    {
        if (conclusao.Invalida || conclusao.IntervaloValido is not { } intervalo) return;
        _ = InvokeAsync(() => ConfirmarIntervaloAsync(intervalo));
    }

    private async Task ConfirmarIntervaloAsync(IntervaloJanelaTemporal intervalo)
    {
        intervaloSolicitado = intervalo;
        await Coordenador.ConfirmarIntervaloAsync(intervalo);
    }

    private async Task TentarNovamenteAsync()
    {
        if (intervaloSolicitado is { } intervalo)
            await Coordenador.ConfirmarIntervaloAsync(intervalo);
    }

    private void AoAtualizarConsulta()
    {
        _ = InvokeAsync(() =>
        {
            MaterializarPublicacao();
            StateHasChanged();
        });
    }

    private void MaterializarPublicacao()
    {
        var publicado = Coordenador.Publicado;
        if (ReferenceEquals(publicado, publicacaoMaterializada)) return;
        publicacaoMaterializada = publicado;
        if (publicado is null)
        {
            serieUtilizacaoPublicada = [];
            tonsPublicados = [];
            memoriasPublicadas = [];
            tomPublicado = null;
            return;
        }

        var diasDoRecorte = diasPreservados
            .Select(dia => new
            {
                Data = DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture),
                Associacoes = dia.Associacoes
                    .Where(associacao => string.Equals(associacao.IdentidadeCategoria,
                        publicado.IdentidadeCategoria, StringComparison.Ordinal))
                    .ToArray()
            })
            .Where(dia => dia.Data >= publicado.Intervalo.DataInicio && dia.Data <= publicado.Intervalo.DataFim)
            .ToArray();

        serieUtilizacaoPublicada = diasDoRecorte
            .Where(dia => dia.Associacoes.Length > 0)
            .Select(dia => (double)dia.Associacoes.Length)
            .ToArray();
        tonsPublicados = diasDoRecorte
            .SelectMany(dia => dia.Associacoes)
            .Select(associacao => associacao.Tom is { } tom ? (double?)tom : null)
            .ToArray();
        var tonsDefinidos = tonsPublicados.Where(tom => tom.HasValue).Select(tom => tom!.Value).ToArray();
        tomPublicado = tonsDefinidos.Length == 0 ? null : tonsDefinidos.Average();
        memoriasPublicadas = publicado.Itens
            .Select(item => new ItemListaMemoriasCategoria(item.Identidade, item.Conteudo, item.Tom))
            .ToArray();
    }

    private void DesinscreverEventos()
    {
        if (inscritoModelo && modeloTemporal is not null)
        {
            modeloTemporal.OperacaoConcluida -= AoConcluirOperacaoTemporal;
            inscritoModelo = false;
        }
        if (inscritoCoordenador)
        {
            Coordenador.Atualizado -= AoAtualizarConsulta;
            inscritoCoordenador = false;
        }
    }

    private void VoltarAoPanorama() => Navegacao.NavigateTo("/rememorar");

    private void NavegarAoPanoramaSeguro() => Navegacao.NavigateTo("/rememorar", replace: true);

    public async ValueTask DisposeAsync()
    {
        geracaoCarregamento++;
        DesinscreverEventos();
        if (moduloEstado is not null)
            await moduloEstado.DisposeAsync();
    }

    private sealed record ContextoJornadaPanorama(
        int Versao, string IdentidadeConta, string IdentidadeSessao, double PosicaoInicio, double PosicaoFim,
        string? UltimaDataInicio, string? UltimaDataFim, string? CategoriaSelecionada,
        double Rolagem = 0);
}
