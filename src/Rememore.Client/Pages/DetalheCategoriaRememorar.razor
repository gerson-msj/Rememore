@page "/rememorar/categoria/{categoria}"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.JSInterop
@using Rememore.Client.Componentes
@using Rememore.Client.Infraestrutura
@using Rememore.Client.Infraestrutura.Categorias
@using Rememore.Client.Infraestrutura.Rememorar
@inject NavigationManager Navegacao
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject SincronizadorProjecaoPanorama Sincronizador
@inject CoordenadorConsultaMemoriasCategoria Coordenador
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@TituloPagina</PageTitle>

@if (carregando)
{
    <main class="pagina-detalhe-categoria" aria-busy="true">
        <p class="rememorar-estado" role="status">Carregando...</p>
    </main>
}
else if (categoriaAtual is not null && modeloTemporal is not null)
{
    <main class="pagina-detalhe-categoria">
        <CabecalhoAmbiente Titulo="@categoriaAtual.Nome" MostrarRetorno AoRetornar="VoltarAoPanoramaAsync" />

        <section class="detalhe-categoria-controles" aria-label="Período">
            <div class="detalhe-categoria-controles__conteudo">
                <JanelaTemporal Modelo="@modeloTemporal" TomPreciso="@tomPublicado" />
            </div>
        </section>

        @if (Coordenador.Publicado is not null)
        {
            <section class="detalhe-categoria-graficos-area" aria-label="Sínteses da categoria">
                <div class="columns is-mobile is-variable is-1 variacao-tom-comparacao">
                    <div class="column">
                        <OndaUtilizacaoCategoria Serie="@serieUtilizacaoPublicada" Tom="@tomPublicado" />
                    </div>
                    <div class="column">
                        <VariacaoTomCategoria Tons="@tonsPublicados" />
                    </div>
                </div>
            </section>

            <div class="detalhe-categoria-conteudo">
                @if (Coordenador.CacheIndisponivel)
                {
                    <div class="notification is-warning is-light" role="status">
                        Não foi possível atualizar o cache local. As memórias recebidas continuam disponíveis.
                    </div>
                }
                @if (Coordenador.Falha is not null)
                {
                    <div class="notification is-danger is-light" role="alert" aria-atomic="true">
                        <p>Não foi possível carregar as memórias. Tente novamente.</p>
                        <button class="button is-link mt-3" type="button" @onclick="TentarNovamenteAsync"
                                disabled="@(Coordenador.Carregando || carregandoMais)">Tentar novamente</button>
                    </div>
                }
                @if (Coordenador.Carregando && intervaloSolicitado != Coordenador.Publicado?.Intervalo)
                {
                    <p class="rememorar-estado detalhe-categoria-carregando" role="status" aria-busy="true">Carregando...</p>
                }
                <section class="detalhe-categoria-memorias" aria-label="Memórias da categoria">
                    <ListaMemoriasCategoria Itens="@memoriasPublicadas" NomeAcessivel="@NomeAcessivelMemorias" />
                    <div id="detalhe-categoria-marcador" class="detalhe-categoria-marcador" aria-hidden="true"></div>
                    @if (Coordenador.Carregando && intervaloSolicitado == Coordenador.Publicado?.Intervalo)
                    {
                        <p class="rememorar-estado detalhe-categoria-carregando" role="status" aria-busy="true">Carregando...</p>
                    }
                    @if (Coordenador.Publicado is { TemMais: false } && lotesAdicionais > 0
                         && !Coordenador.Carregando && Coordenador.Falha is null)
                    {
                        <p class="rememorar-estado detalhe-categoria-fim-lista" role="status">@TextoFimLista</p>
                    }
                </section>
                @if (mostrarVoltarAoTopo)
                {
                    <button class="button is-link is-light detalhe-categoria-voltar-topo" type="button"
                            @onclick="VoltarAoTopoAsync">Voltar ao topo</button>
                }
            </div>
        }
        else
        {
            <div class="detalhe-categoria-conteudo">
                @if (Coordenador.Falha is not null)
                {
                    <div class="notification is-danger is-light" role="alert" aria-atomic="true">
                        <p>Não foi possível carregar as memórias. Tente novamente.</p>
                        <button class="button is-link mt-3" type="button" @onclick="TentarNovamenteAsync"
                                disabled="@Coordenador.Carregando">Tentar novamente</button>
                    </div>
                }
                else
                {
                    <p class="rememorar-estado" role="status" aria-busy="@Coordenador.Carregando">Carregando...</p>
                }
            </div>
        }
    </main>
}

@code {
    [Parameter] public string categoria { get; set; } = string.Empty;

    private const string TextoFimLista = "Não há mais memórias.";
    private IJSObjectReference? moduloEstado;
    private DotNetObjectReference<DetalheCategoriaRememorar>? referenciaDotNet;
    private CategoriaPreservadaRemota? categoriaAtual;
    private ModeloJanelaTemporal? modeloTemporal;
    private IReadOnlyList<BlocoDiaPanoramaRemoto> diasPreservados = [];
    private IReadOnlyList<double> serieUtilizacaoPublicada = [];
    private IReadOnlyList<double?> tonsPublicados = [];
    private IReadOnlyList<ItemListaMemoriasCategoria> memoriasPublicadas = [];
    private PublicacaoMemoriasCategoria? publicacaoMaterializada;
    private IntervaloJanelaTemporal? intervaloSolicitado;
    private double? tomPublicado;
    private bool carregando = true;
    private bool inscritoModelo;
    private bool inscritoCoordenador;
    private bool carregandoMais;
    private bool rolagemDetalheConectada;
    private bool mostrarVoltarAoTopo;
    private bool disposed;
    private bool restauracaoPontoLeituraPendente;
    private bool restaurandoPontoLeitura;
    private bool restauracaoIniciada;
    private bool jornadaEncerrada;
    private TaskCompletionSource? renderRestauracaoConcluido;
    private string? identidadeContaAtual;
    private string? identidadeSessaoAtual;
    private string? identidadeJornadaAtual;
    private double rolagemRestaurar;
    private int lotesAdicionais;
    private string? revisaoPublicadaAnterior;
    private IntervaloJanelaTemporal? intervaloPublicadoAnterior;
    private string? assinaturaObservador;
    private long geracaoCarregamento;
    private string TituloPagina => categoriaAtual is null ? "Rememorar" : $"{categoriaAtual.Nome} — Rememorar";
    private string NomeAcessivelMemorias => categoriaAtual is null
        ? "Memórias da categoria"
        : $"Memórias da categoria {categoriaAtual.Nome}";

    protected override void OnInitialized()
    {
        EstadoAutenticacao.AuthenticationStateChanged += AoMudarAutenticacao;
    }

    protected override async Task OnParametersSetAsync()
    {
        var geracao = ++geracaoCarregamento;
        disposed = false;
        DesinscreverEventos();
        carregando = true;
        categoriaAtual = null;
        modeloTemporal = null;
        diasPreservados = [];
        serieUtilizacaoPublicada = [];
        tonsPublicados = [];
        memoriasPublicadas = [];
        publicacaoMaterializada = null;
        intervaloSolicitado = null;
        tomPublicado = null;
        lotesAdicionais = 0;
        revisaoPublicadaAnterior = null;
        intervaloPublicadoAnterior = null;
        restauracaoPontoLeituraPendente = false;
        restaurandoPontoLeitura = false;
        restauracaoIniciada = false;
        identidadeContaAtual = null;
        identidadeSessaoAtual = null;
        identidadeJornadaAtual = null;
        rolagemRestaurar = 0;
        jornadaEncerrada = false;

        try
        {
            var identidadeConta = EstadoAutenticacao.IdentidadeConta;
            var identidadeSessao = EstadoAutenticacao.IdentidadeSessao;
            if (!EstadoAutenticacao.Autenticado || identidadeConta is null || identidadeSessao is null
                || string.IsNullOrWhiteSpace(categoria))
            {
                NavegarAoPanoramaSeguro();
                return;
            }
            identidadeContaAtual = identidadeConta;
            identidadeSessaoAtual = identidadeSessao;

            moduloEstado ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/estadoRememorar.js");
            var jornadaAba = await moduloEstado.InvokeAsync<JornadaAba?>(
                "validarIdentidadeJornadaDaAba", identidadeConta, identidadeSessao);
            if (jornadaAba is null)
            {
                NavegarAoPanoramaSeguro();
                return;
            }
            var contextoPanorama = await moduloEstado.InvokeAsync<ContextoJornadaPanorama?>(
                "lerContexto", identidadeConta, identidadeSessao);
            if (!ContextoPanoramaValido(contextoPanorama, identidadeConta, identidadeSessao, categoria))
            {
                NavegarAoPanoramaSeguro();
                return;
            }
            identidadeJornadaAtual = contextoPanorama!.IdentidadeJornada;

            var preparacao = await Sincronizador.PrepararAsync(identidadeConta);
            if (geracao != geracaoCarregamento) return;
            if (!preparacao.Disponivel)
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            categoriaAtual = preparacao.Categorias.FirstOrDefault(item =>
                item.Ativa && string.Equals(item.Identidade, categoria, StringComparison.Ordinal));
            if (categoriaAtual is null)
            {
                NavegarAoPanoramaSeguro();
                return;
            }

            diasPreservados = preparacao.Dias.OrderBy(dia => dia.Data, StringComparer.Ordinal).ToArray();
            var datas = diasPreservados
                .Select(dia => DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture))
                .ToArray();
            var contextoDetalhe = await moduloEstado.InvokeAsync<ContextoDetalheCategoria?>(
                "lerContextoDetalhe", identidadeConta, identidadeSessao, identidadeJornadaAtual, categoria);
            var detalheValidado = ContextoDetalheValido(contextoDetalhe, identidadeConta, identidadeSessao,
                identidadeJornadaAtual, categoria, datas);
            var contextoInicialDetalhe = detalheValidado
                ? contextoDetalhe!
                : CriarContextoDetalheDoPanorama(contextoPanorama!);
            if (datas.Length < 2 || !CriarModeloTemporal(datas, contextoInicialDetalhe, out var modeloRestaurado)
                || modeloRestaurado is null)
            {
                categoriaAtual = null;
                NavegarAoPanoramaSeguro();
                return;
            }

            modeloTemporal = modeloRestaurado;
            restauracaoPontoLeituraPendente = detalheValidado;
            rolagemRestaurar = detalheValidado ? contextoDetalhe!.Rolagem : 0;
            modeloTemporal.OperacaoConcluida += AoConcluirOperacaoTemporal;
            inscritoModelo = true;
            Coordenador.Atualizado += AoAtualizarConsulta;
            inscritoCoordenador = true;

            var intervaloInicial = modeloTemporal.Estado.IntervaloValidoAtual
                ?? modeloTemporal.Estado.UltimoIntervaloValido;
            if (intervaloInicial is null)
            {
                categoriaAtual = null;
                NavegarAoPanoramaSeguro();
                return;
            }

            intervaloSolicitado = intervaloInicial;
            await Coordenador.AbrirAsync(identidadeConta, identidadeJornadaAtual, categoriaAtual.Identidade, intervaloInicial);
            if (geracao != geracaoCarregamento) return;
            MaterializarPublicacao();
            await PersistirContextoDetalheAsync(intervaloInicial);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or ArgumentException
            or FormatException or TaskCanceledException)
        {
            categoriaAtual = null;
            modeloTemporal = null;
            NavegarAoPanoramaSeguro();
        }
        finally
        {
            if (geracao == geracaoCarregamento)
                carregando = false;
        }
    }

    private static bool ContextoPanoramaValido(
        ContextoJornadaPanorama? contexto,
        string identidadeConta,
        string identidadeSessao,
        string identidadeCategoria) =>
        contexto is not null
        && contexto.Versao == 2
        && contexto.IdentidadeConta == identidadeConta
        && contexto.IdentidadeSessao == identidadeSessao
        && !string.IsNullOrWhiteSpace(contexto.IdentidadeJornada)
        && string.Equals(contexto.CategoriaSelecionada, identidadeCategoria, StringComparison.Ordinal)
        && double.IsFinite(contexto.PosicaoInicio)
        && double.IsFinite(contexto.PosicaoFim)
        && contexto.PosicaoInicio is >= 0 and <= 1
        && contexto.PosicaoFim is >= 0 and <= 1
        && contexto.PosicaoInicio <= contexto.PosicaoFim;

    private static ContextoDetalheCategoria CriarContextoDetalheDoPanorama(ContextoJornadaPanorama contexto) =>
        new(1, contexto.IdentidadeConta, contexto.IdentidadeSessao, contexto.IdentidadeJornada,
            contexto.CategoriaSelecionada!, contexto.PosicaoInicio, contexto.PosicaoFim,
            contexto.UltimaDataInicio, contexto.UltimaDataFim, 0);

    private static bool ContextoDetalheValido(
        ContextoDetalheCategoria? contexto,
        string identidadeConta,
        string identidadeSessao,
        string identidadeJornada,
        string identidadeCategoria,
        IReadOnlyList<DateOnly> datas) =>
        contexto is not null && contexto.Versao == 1
        && contexto.IdentidadeConta == identidadeConta && contexto.IdentidadeSessao == identidadeSessao
        && contexto.IdentidadeJornada == identidadeJornada
        && contexto.IdentidadeCategoria == identidadeCategoria
        && double.IsFinite(contexto.PosicaoInicio) && contexto.PosicaoInicio is >= 0 and <= 1
        && double.IsFinite(contexto.PosicaoFim) && contexto.PosicaoFim is >= 0 and <= 1
        && contexto.PosicaoInicio <= contexto.PosicaoFim
        && double.IsFinite(contexto.Rolagem) && contexto.Rolagem >= 0
        && DateOnly.TryParseExact(contexto.UltimaDataInicio, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var inicio)
        && DateOnly.TryParseExact(contexto.UltimaDataFim, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var fim)
        && Array.IndexOf(datas.ToArray(), inicio) >= 0 && Array.IndexOf(datas.ToArray(), fim) > Array.IndexOf(datas.ToArray(), inicio);

    private static bool CriarModeloTemporal(
        IReadOnlyList<DateOnly> datas,
        ContextoDetalheCategoria contexto,
        out ModeloJanelaTemporal? modelo)
    {
        modelo = null;
        if (!DateOnly.TryParseExact(contexto.UltimaDataInicio, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var inicio)
            || !DateOnly.TryParseExact(contexto.UltimaDataFim, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var fim))
            return false;

        var indiceInicio = Array.IndexOf(datas.ToArray(), inicio);
        var indiceFim = Array.IndexOf(datas.ToArray(), fim);
        if (indiceInicio < 0 || indiceFim <= indiceInicio) return false;

        var intervalo = new IntervaloJanelaTemporal(indiceInicio, indiceFim, inicio, fim);
        var restauracao = new EstadoJanelaTemporalRestaurado(
            contexto.PosicaoInicio, contexto.PosicaoFim, intervalo);
        modelo = new ModeloJanelaTemporal(datas, restauracao);
        return true;
    }

    private void AoConcluirOperacaoTemporal(ConclusaoOperacaoJanelaTemporal conclusao)
    {
        if (conclusao.Invalida || conclusao.IntervaloValido is not { } intervalo) return;
        _ = InvokeAsync(() => ConfirmarIntervaloAsync(intervalo));
    }

    private async Task ConfirmarIntervaloAsync(IntervaloJanelaTemporal intervalo)
    {
        var mudouRecorte = intervalo != Coordenador.Publicado?.Intervalo;
        intervaloSolicitado = intervalo;
        if (mudouRecorte) rolagemRestaurar = 0;
        await Coordenador.ConfirmarIntervaloAsync(intervalo);
        await PersistirContextoDetalheAsync(intervalo);
    }

    private async Task PersistirContextoDetalheAsync(IntervaloJanelaTemporal intervalo)
    {
        if (moduloEstado is null || identidadeContaAtual is null || identidadeSessaoAtual is null
            || identidadeJornadaAtual is null || categoriaAtual is null || modeloTemporal is null) return;
        var estado = modeloTemporal.Estado;
        var contexto = new ContextoDetalheCategoria(1, identidadeContaAtual, identidadeSessaoAtual,
            identidadeJornadaAtual, categoriaAtual.Identidade, estado.PosicaoInicio, estado.PosicaoFim,
            intervalo.DataInicio.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            intervalo.DataFim.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), rolagemRestaurar);
        await moduloEstado.InvokeVoidAsync("gravarContextoDetalhe", identidadeContaAtual,
            identidadeSessaoAtual, identidadeJornadaAtual, contexto);
    }

    private async Task TentarNovamenteAsync()
    {
        if (Coordenador.Falha == "consultaLote")
        {
            await CarregarMaisAsync();
            return;
        }

        if (intervaloSolicitado is { } intervalo)
            await Coordenador.ConfirmarIntervaloAsync(intervalo);
    }

    private async Task CarregarMaisAsync()
    {
        var publicado = Coordenador.Publicado;
        if (disposed || carregandoMais || Coordenador.Carregando || Coordenador.Falha is not null
            || publicado is null || !publicado.TemMais || publicado.ProximoCursor is null
            || publicado.Intervalo != intervaloSolicitado)
            return;

        carregandoMais = true;
        try { await Coordenador.CarregarMaisAsync(); }
        finally
        {
            carregandoMais = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            if (moduloEstado is null) return;
            if (renderRestauracaoConcluido is { } render && !Coordenador.Carregando)
            {
                renderRestauracaoConcluido = null;
                render.TrySetResult();
            }
            referenciaDotNet ??= DotNetObjectReference.Create(this);
            if (!rolagemDetalheConectada)
            {
                if (identidadeContaAtual is null || identidadeSessaoAtual is null || identidadeJornadaAtual is null) return;
                await moduloEstado.InvokeVoidAsync("conectarRolagemDetalhe", referenciaDotNet,
                    identidadeContaAtual, identidadeSessaoAtual, identidadeJornadaAtual);
                rolagemDetalheConectada = true;
            }

            if (restauracaoPontoLeituraPendente && !restauracaoIniciada
                && !Coordenador.Carregando && Coordenador.Publicado is { } publicacaoConfirmada
                && publicacaoConfirmada.Intervalo == intervaloSolicitado)
            {
                restauracaoIniciada = true;
                restaurandoPontoLeitura = true;
                restauracaoPontoLeituraPendente = false;
                assinaturaObservador = string.Empty;
                await moduloEstado.InvokeVoidAsync("suspenderMarcadorDetalheParaRestauracao");
                _ = RestaurarPontoLeituraAsync(rolagemRestaurar);
                return;
            }

            var publicado = Coordenador.Publicado;
            var podeAvancar = publicado is { TemMais: true, ProximoCursor: not null }
                && publicado.Intervalo == intervaloSolicitado
                && !Coordenador.Carregando && !carregandoMais && !restaurandoPontoLeitura
                && Coordenador.Falha is null;
            var assinatura = podeAvancar
                ? $"{publicado!.IdentidadeCategoria}:{publicado.Intervalo.DataInicio.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}:{publicado.Intervalo.DataFim.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}:{publicado.Revisao}:{publicado.Itens.Count}"
                : string.Empty;
            if (assinatura != assinaturaObservador)
            {
                assinaturaObservador = assinatura;
                if (podeAvancar)
                    await moduloEstado.InvokeVoidAsync("observarMarcadorDetalhe");
                else
                    await moduloEstado.InvokeVoidAsync("desconectarMarcadorDetalhe");
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RestaurarPontoLeituraAsync(double posicao)
    {
        try
        {
            if (moduloEstado is null) return;
            var dimensoes = await moduloEstado.InvokeAsync<DimensoesDocumentoDetalhe>("medirDocumentoDetalhe");
            while (dimensoes.Altura < posicao + dimensoes.AlturaVisivel
                && Coordenador.Publicado is { TemMais: true, ProximoCursor: not null } publicado
                && publicado.Intervalo == intervaloSolicitado && Coordenador.Falha is null
                && !disposed)
            {
                var render = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
                renderRestauracaoConcluido = render;
                await Coordenador.CarregarMaisAsync();
                MaterializarPublicacao();
                await InvokeAsync(StateHasChanged);
                await render.Task;
                if (Coordenador.Falha is not null) break;
                dimensoes = await moduloEstado.InvokeAsync<DimensoesDocumentoDetalhe>("medirDocumentoDetalhe");
            }

            if (!disposed)
            {
                await moduloEstado.InvokeVoidAsync("restaurarRolagemDetalhe", posicao);
                rolagemRestaurar = posicao;
                await moduloEstado.InvokeVoidAsync("concluirRestauracaoDetalhe");
            }
        }
        catch (Exception ex) when (ex is JSException or ObjectDisposedException or InvalidOperationException)
        {
            renderRestauracaoConcluido?.TrySetCanceled();
            renderRestauracaoConcluido = null;
        }
        finally
        {
            restaurandoPontoLeitura = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task AoMarcadorDeLoteVisivelAsync() => CarregarMaisAsync();

    [JSInvokable]
    public Task AoAlterarVisibilidadeDoTopoAsync(bool visivel) => InvokeAsync(() =>
    {
        if (mostrarVoltarAoTopo == visivel) return;
        mostrarVoltarAoTopo = visivel;
        StateHasChanged();
    });

    private async Task VoltarAoTopoAsync()
    {
        if (moduloEstado is not null)
            await moduloEstado.InvokeVoidAsync("rolarAoTopoDetalhe");
    }

    private async Task VoltarAoPanoramaAsync()
    {
        if (moduloEstado is not null)
            await moduloEstado.InvokeVoidAsync("gravarRolagemDetalheImediata");
        Navegacao.NavigateTo("/rememorar");
    }

    private void AoAtualizarConsulta()
    {
        _ = InvokeAsync(() =>
        {
            MaterializarPublicacao();
            StateHasChanged();
        });
    }

    private void MaterializarPublicacao()
    {
        var publicado = Coordenador.Publicado;
        if (ReferenceEquals(publicado, publicacaoMaterializada)) return;
        if (publicado is not null)
        {
            var mesmaConsulta = intervaloPublicadoAnterior == publicado.Intervalo
                && revisaoPublicadaAnterior == publicado.Revisao;
            if (mesmaConsulta)
                lotesAdicionais++;
            else if (!mesmaConsulta)
                lotesAdicionais = 0;
            revisaoPublicadaAnterior = publicado.Revisao;
            intervaloPublicadoAnterior = publicado.Intervalo;
        }
        else
        {
            lotesAdicionais = 0;
            revisaoPublicadaAnterior = null;
            intervaloPublicadoAnterior = null;
        }
        publicacaoMaterializada = publicado;
        if (publicado is null)
        {
            serieUtilizacaoPublicada = [];
            tonsPublicados = [];
            memoriasPublicadas = [];
            tomPublicado = null;
            return;
        }

        var diasDoRecorte = diasPreservados
            .Select(dia => new
            {
                Data = DateOnly.ParseExact(dia.Data, "yyyy-MM-dd", CultureInfo.InvariantCulture),
                Associacoes = dia.Associacoes
                    .Where(associacao => string.Equals(associacao.IdentidadeCategoria,
                        publicado.IdentidadeCategoria, StringComparison.Ordinal))
                    .ToArray()
            })
            .Where(dia => dia.Data >= publicado.Intervalo.DataInicio && dia.Data <= publicado.Intervalo.DataFim)
            .ToArray();

        serieUtilizacaoPublicada = diasDoRecorte
            .Where(dia => dia.Associacoes.Length > 0)
            .Select(dia => (double)dia.Associacoes.Length)
            .ToArray();
        tonsPublicados = diasDoRecorte
            .SelectMany(dia => dia.Associacoes)
            .Select(associacao => associacao.Tom is { } tom ? (double?)tom : null)
            .ToArray();
        var tonsDefinidos = tonsPublicados.Where(tom => tom.HasValue).Select(tom => tom!.Value).ToArray();
        tomPublicado = tonsDefinidos.Length == 0 ? null : tonsDefinidos.Average();
        memoriasPublicadas = publicado.Itens
            .Select(item => new ItemListaMemoriasCategoria(item.Identidade, item.Conteudo, item.Tom))
            .ToArray();
    }

    private void DesinscreverEventos()
    {
        if (inscritoModelo && modeloTemporal is not null)
        {
            modeloTemporal.OperacaoConcluida -= AoConcluirOperacaoTemporal;
            inscritoModelo = false;
        }
        if (inscritoCoordenador)
        {
            Coordenador.Atualizado -= AoAtualizarConsulta;
            inscritoCoordenador = false;
        }
    }

    private void AoMudarAutenticacao(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> tarefaEstado)
    {
        _ = EncerrarJornadaSeContextoMudouAsync(tarefaEstado);
    }

    private async Task EncerrarJornadaSeContextoMudouAsync(
        Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> tarefaEstado)
    {
        try
        {
            var estado = await tarefaEstado;
            var identidadeConta = estado.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (identidadeConta != identidadeContaAtual || estado.User.Identity?.IsAuthenticated != true
                || EstadoAutenticacao.IdentidadeSessao != identidadeSessaoAtual)
            {
                await EncerrarJornadaAsync();
                if (!disposed) Navegacao.NavigateTo("/");
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task EncerrarJornadaAsync()
    {
        if (jornadaEncerrada || identidadeContaAtual is null || identidadeJornadaAtual is null) return;
        jornadaEncerrada = true;
        try { await Coordenador.EncerrarJornadaAsync(identidadeContaAtual, identidadeJornadaAtual); }
        catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException) { }
        if (moduloEstado is not null)
        {
            try { await moduloEstado.InvokeVoidAsync("removerContexto", identidadeContaAtual, identidadeJornadaAtual); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
        }
    }

    private void NavegarAoPanoramaSeguro() => Navegacao.NavigateTo("/rememorar", replace: true);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        geracaoCarregamento++;
        EstadoAutenticacao.AuthenticationStateChanged -= AoMudarAutenticacao;
        renderRestauracaoConcluido?.TrySetCanceled();
        renderRestauracaoConcluido = null;
        if (!jornadaEncerrada && identidadeContaAtual is not null && identidadeJornadaAtual is not null
            && (!EstadoAutenticacao.Autenticado || EstadoAutenticacao.IdentidadeConta != identidadeContaAtual
                || EstadoAutenticacao.IdentidadeSessao != identidadeSessaoAtual))
            await EncerrarJornadaAsync();
        DesinscreverEventos();
        if (moduloEstado is not null)
        {
            try { await moduloEstado.InvokeVoidAsync("desconectarDetalhe"); }
            catch (JSDisconnectedException) { }
        }
        referenciaDotNet?.Dispose();
        if (moduloEstado is not null)
            await moduloEstado.DisposeAsync();
    }

    private sealed record ContextoJornadaPanorama(
        int Versao, string IdentidadeConta, string IdentidadeSessao, string IdentidadeJornada,
        double PosicaoInicio, double PosicaoFim, string? UltimaDataInicio, string? UltimaDataFim,
        string? CategoriaSelecionada,
        double Rolagem = 0);

    private sealed record ContextoDetalheCategoria(
        int Versao, string IdentidadeConta, string IdentidadeSessao, string IdentidadeJornada,
        string IdentidadeCategoria, double PosicaoInicio, double PosicaoFim,
        string? UltimaDataInicio, string? UltimaDataFim, double Rolagem);

    private sealed record DimensoesDocumentoDetalhe(double Altura, double AlturaVisivel);
    private sealed record JornadaAba(string IdentidadeJornada, bool Duplicada);
}
