@page "/principal"
@attribute [Authorize]
@inject NavigationManager Navegacao
@inject EstadoAutenticacaoProvider EstadoAutenticacao
@inject ICapacidadesAmbiente ServicoCapacidades
@inject IPendenciaCapturaLocal ServicoPendencia

<PageTitle>Rememore</PageTitle>

<main class="pagina-principal">
    <CabecalhoAmbiente Titulo="Rememore" LarguraMaxima="72rem" />
    <h1 class="is-sr-only">Rememore</h1>

    @if (carregando)
    {
        <div class="principal-carregando" aria-busy="true" aria-label="Carregando jornadas"></div>
    }
    else
    {
        <div class="principal-conteudo">
            <section class="principal-jornadas" aria-label="Jornadas">
                <div class="principal-jornadas__grade">
                    @foreach (var jornada in Jornadas)
                    {
                        <button class="card elemento-card-principal" type="button" aria-haspopup="@(jornada.Disponivel ? null : "dialog")" @onclick="() => AcionarJornada(jornada)">
                            <span class="card-content elemento-card-principal__conteudo">
                                <span class="icon is-large elemento-card-principal__icone" aria-hidden="true"><i class="@jornada.ClasseIcone"></i></span>
                                <span class="elemento-card-principal__texto">
                                    <span class="elemento-card-principal__titulo">@jornada.Titulo</span>
                                    <span class="elemento-card-principal__descricao">@jornada.Descricao</span>
                                    @if (!jornada.Disponivel)
                                    {
                                        <span class="elemento-card-principal__disponibilidade">@jornada.MensagemIndisponibilidade</span>
                                    }
                                </span>
                            </span>
                        </button>
                    }
                </div>
            </section>

            <div class="principal-secundaria">
                @if (falhaPendencias)
                {
                    <p class="principal-pendencias-erro" role="alert">Não foi possível verificar as capturas pendentes neste dispositivo.</p>
                }
                <nav class="principal-acessos" aria-label="Continuidade, conta e sistema">
                    @if (pendenciaCaptura)
                    {
                        <a class="button is-light principal-acesso principal-acesso--pendente" href="capturar">
                            <span class="icon" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                            <span>Capturas pendentes</span>
                        </a>
                    }
                    <a class="button is-light principal-acesso" href="conta">
                        <span class="icon" aria-hidden="true"><i class="fa-solid fa-user-gear"></i></span>
                        <span>Minha Conta e Meus Dados</span>
                    </a>
                    @if (capacidades?.Administracao == true)
                    {
                        <a class="button is-light principal-acesso" href="admin">
                            <span class="icon" aria-hidden="true"><i class="fa-solid fa-wrench"></i></span>
                            <span>Administração</span>
                        </a>
                    }
                </nav>
            </div>
        </div>
    }

    <Popup Aberto="@popupAberto"
           Titulo="@jornadaSelecionada?.Titulo"
           Icone="@IconeJornadaSelecionada"
           Mensagem="@MensagemJornadaSelecionada"
           TextoConfirmar="OK"
           ClasseBotaoConfirmar="is-link"
           AoResponder="FecharExplicacaoAsync" />
</main>

@code {
    private CapacidadesPrincipal? capacidades;
    private bool pendenciaCaptura;
    private bool falhaPendencias;
    private bool carregando = true;
    private bool popupAberto;
    private Jornada? jornadaSelecionada;

    private IReadOnlyList<Jornada> Jornadas =>
    [
        new("Capturar", "fa-solid fa-feather-pointed", "Preserve as memórias de um dia.", true, "", "capturar", []),
        new("Encontrar Memórias", "fa-solid fa-magnifying-glass", "Localize memórias preservadas usando diferentes critérios.", capacidades?.EncontrarMemorias == true,
            "Disponível depois que você capturar seu primeiro dia.", "encontrar",
            [
                "Encontre memórias já preservadas usando diferentes critérios de busca.",
                "Para começar a utilizar este recurso, primeiro capture e preserve as memórias de pelo menos um dia."
            ]),
        new("Rever um Dia", "fa-solid fa-location-crosshairs", "Volte às memórias preservadas de uma data específica.", capacidades?.ReverDia == true,
            "Disponível depois que você capturar seu primeiro dia.", "rever",
            [
                "Reveja as memórias que você preservou em uma data específica.",
                "Para utilizar este recurso, primeiro capture e preserve as memórias de pelo menos um dia."
            ]),
        new("Rememorar", "fa-solid fa-book-open", "Explore suas memórias por categorias e períodos.", capacidades?.Rememorar == true,
            "Disponível quando houver mais memórias preservadas.", "rememorar",
            [
                "Rememorar permite explorar suas memórias por categorias e períodos, ajudando a perceber relações ao longo do tempo.",
                "Para que essa exploração faça sentido, é preciso ter memórias preservadas em pelo menos dois dias e distribuídas entre pelo menos duas categorias.",
                "Continue capturando suas memórias e o recurso ficará disponível conforme seu acervo crescer."
            ])
    ];

    private string? IconeJornadaSelecionada => jornadaSelecionada?.ClasseIcone;
    private string MensagemJornadaSelecionada => string.Join(Environment.NewLine + Environment.NewLine, jornadaSelecionada?.Explicacao ?? []);

    protected override async Task OnInitializedAsync()
    {
        var estado = await EstadoAutenticacao.GetAuthenticationStateAsync();
        var nomeConta = estado.User.Identity?.Name ?? "";
        capacidades = await ServicoCapacidades.ObterAsync(nomeConta);
        var identidadeConta = EstadoAutenticacao.IdentidadeConta;
        if (identidadeConta is not null)
        {
            var resultado = await ServicoPendencia.ExisteAsync(identidadeConta);
            falhaPendencias = !resultado.Sucesso;
            pendenciaCaptura = resultado.Sucesso && resultado.Valor == true;
        }
        else falhaPendencias = true;
        carregando = false;
    }

    private void AcionarJornada(Jornada jornada)
    {
        if (jornada.Disponivel)
        {
            Navegacao.NavigateTo(jornada.Rota);
            return;
        }

        jornadaSelecionada = jornada;
        popupAberto = true;
    }

    private Task FecharExplicacaoAsync(RespostaPopup _)
    {
        popupAberto = false;
        jornadaSelecionada = null;
        return Task.CompletedTask;
    }

    private sealed record Jornada(
        string Titulo,
        string ClasseIcone,
        string Descricao,
        bool Disponivel,
        string MensagemIndisponibilidade,
        string Rota,
        IReadOnlyList<string> Explicacao);
}
