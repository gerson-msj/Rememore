@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="dialogo" class="mensagem-popup @(Cor is null ? "" : $"mensagem-popup--{ClasseCor}")" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="@(TemTitulo ? $"{IdBase}-titulo" : null)" aria-label="@(TemTitulo ? null : NomeAcessivel)" aria-describedby="@($"{IdBase}-descricao")">
    <section class="mensagem-popup__caixa">
        @if (TemTitulo)
        {
            <h2 class="mensagem-popup__titulo" id="@($"{IdBase}-titulo")">@Titulo</h2>
        }
        <div class="mensagem-popup__mensagem" id="@($"{IdBase}-descricao")">
            @if (!string.IsNullOrWhiteSpace(Icone))
            {
                <i class="@Icone mensagem-popup__icone" aria-hidden="true"></i>
            }
            <div class="mensagem-popup__paragrafos">
                @foreach (var paragrafo in Paragrafos.Where(p => !string.IsNullOrWhiteSpace(p)))
                {
                    <p>@paragrafo</p>
                }
            </div>
        </div>
        @if (MostrarConfirmacao || MostrarCancelamento)
        {
            <div class="mensagem-popup__acoes">
                @if (MostrarCancelamento)
                {
                    <button class="button mensagem-popup__acao-cancelar" type="button" @onclick="() => ResponderAsync(RespostaPopup.Cancelamento)">@RotuloCancelamento</button>
                }
                @if (MostrarConfirmacao)
                {
                    <button class="button @(Cor is null ? "is-link" : ClasseBotaoCor) mensagem-popup__acao-confirmar" type="button" @onclick="() => ResponderAsync(RespostaPopup.Confirmacao)">@RotuloConfirmacao</button>
                }
            </div>
        }
    </section>
</dialog>

@code {
    private static long proximoId;
    private readonly string idBase = $"mensagem-popup-{Interlocked.Increment(ref proximoId)}";
    private ElementReference dialogo;
    private IJSObjectReference? modulo;
    private DotNetObjectReference<MensagemPopup>? referenciaJs;
    private bool abertoNoNavegador;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Titulo { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<string> Paragrafos { get; set; } = [];
    [Parameter] public string? Icone { get; set; }
    [Parameter] public CorSemanticaPopup? Cor { get; set; }
    [Parameter] public bool MostrarConfirmacao { get; set; } = true;
    [Parameter] public bool MostrarCancelamento { get; set; } = true;
    [Parameter] public string RotuloConfirmacao { get; set; } = "OK";
    [Parameter] public string RotuloCancelamento { get; set; } = "Cancelar";
    [Parameter] public EventCallback<RespostaPopup> AoResponder { get; set; }

    private string IdBase => idBase;
    private bool TemTitulo => !string.IsNullOrWhiteSpace(Titulo);
    private string NomeAcessivel => string.Join(" ", Paragrafos.Where(p => !string.IsNullOrWhiteSpace(p)));
    private string ClasseCor => Cor switch
    {
        CorSemanticaPopup.Principal => "principal",
        CorSemanticaPopup.Link => "link",
        CorSemanticaPopup.Informacao => "informacao",
        CorSemanticaPopup.Sucesso => "sucesso",
        CorSemanticaPopup.Atencao => "atencao",
        CorSemanticaPopup.Perigo => "perigo",
        _ => ""
    };
    private string ClasseBotaoCor => Cor switch
    {
        CorSemanticaPopup.Principal => "is-primary",
        CorSemanticaPopup.Link => "is-link",
        CorSemanticaPopup.Informacao => "is-info",
        CorSemanticaPopup.Sucesso => "is-success",
        CorSemanticaPopup.Atencao => "is-warning",
        CorSemanticaPopup.Perigo => "is-danger",
        _ => "is-link"
    };

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (primeiroRender)
        {
            modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mensagemPopup.js");
            referenciaJs = DotNetObjectReference.Create(this);
        }

        if (modulo is null || abertoNoNavegador == IsOpen) return;
        if (IsOpen) await modulo.InvokeVoidAsync("abrir", dialogo, referenciaJs);
        else await modulo.InvokeVoidAsync("fechar", dialogo);
        abertoNoNavegador = IsOpen;
    }

    private Task ResponderAsync(RespostaPopup resposta) => AoResponder.InvokeAsync(resposta);

    [JSInvokable]
    public Task AoCancelarPorTecladoOuFundo() => ResponderAsync(RespostaPopup.Cancelamento);

    public async ValueTask DisposeAsync()
    {
        referenciaJs?.Dispose();
        if (modulo is null) return;
        try { await modulo.InvokeVoidAsync("fechar", dialogo); }
        catch (JSDisconnectedException) { }
        await modulo.DisposeAsync();
    }
}
