@inject IJSRuntime JS

<section class="bloco-laboratorio" id="@Identificador">
    <h2 class="bloco-laboratorio__titulo">
        <button class="bloco-laboratorio__controle" type="button" aria-expanded="@expandido" aria-controls="conteudo-@Identificador" @onclick="AlternarAsync">
            <span>@Titulo</span>
            <i class="fa-solid @(expandido ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
            <span class="sr-only">@(expandido ? "Recolher bloco" : "Expandir bloco")</span>
        </button>
    </h2>
    <div class="bloco-laboratorio__conteudo" id="conteudo-@Identificador" hidden="@(!expandido)">
        @if (expandido)
        {
            @ChildContent
        }
    </div>
</section>

@code {
    private bool expandido;

    [Parameter, EditorRequired] public string Identificador { get; set; } = "";
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public bool ExpandidoInicial { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (!primeiroRender) return;
        try
        {
            var valor = await JS.InvokeAsync<string?>("localStorage.getItem", $"rememore.lab.bloco.{Identificador}.v1");
            expandido = valor is null ? ExpandidoInicial : valor == "true";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { expandido = ExpandidoInicial; }
        StateHasChanged();
    }

    private async Task AlternarAsync()
    {
        expandido = !expandido;
        try { await JS.InvokeVoidAsync("localStorage.setItem", $"rememore.lab.bloco.{Identificador}.v1", expandido ? "true" : "false"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }
}
