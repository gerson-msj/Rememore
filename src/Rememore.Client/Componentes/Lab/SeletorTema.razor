@inject EstadoTema Tema

<div class="seletor-tema-lab buttons has-addons mb-0" role="group" aria-label="Preferência de tema">
    <button class="button @(Tema.Preferencia == PreferenciaTema.Sistema ? "is-link" : string.Empty)" type="button" aria-label="Sistema" title="Sistema" aria-pressed="@(Tema.Preferencia == PreferenciaTema.Sistema)" @onclick="() => SelecionarAsync(PreferenciaTema.Sistema)">
        <span class="icon" aria-hidden="true"><i class="fa-solid fa-display"></i></span>
    </button>
    <button class="button @(Tema.Preferencia == PreferenciaTema.Claro ? "is-link" : string.Empty)" type="button" aria-label="Claro" title="Claro" aria-pressed="@(Tema.Preferencia == PreferenciaTema.Claro)" @onclick="() => SelecionarAsync(PreferenciaTema.Claro)">
        <span class="icon" aria-hidden="true"><i class="fa-solid fa-sun"></i></span>
    </button>
    <button class="button @(Tema.Preferencia == PreferenciaTema.Escuro ? "is-link" : string.Empty)" type="button" aria-label="Escuro" title="Escuro" aria-pressed="@(Tema.Preferencia == PreferenciaTema.Escuro)" @onclick="() => SelecionarAsync(PreferenciaTema.Escuro)">
        <span class="icon" aria-hidden="true"><i class="fa-solid fa-moon"></i></span>
    </button>
</div>

@code {
    private Task SelecionarAsync(PreferenciaTema preferencia) => Tema.SelecionarAsync(preferencia);
}