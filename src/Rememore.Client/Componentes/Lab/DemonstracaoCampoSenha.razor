<p class="mb-4">Use uma senha fictícia. Alterne a visibilidade e observe que a contagem só muda quando o conteúdo é editado.</p>

<div class="field">
    <label class="label" for="lab-cmp001-autocomplete">Contexto do autocomplete</label>
    <div class="control">
        <div class="select">
            <select id="lab-cmp001-autocomplete" @bind="AutocompleteSelecionado">
                <option value="current-password">Senha atual (current-password)</option>
                <option value="new-password">Nova senha (new-password)</option>
            </select>
        </div>
    </div>
    <p class="help">A seleção configura o autocomplete do único campo de senha abaixo.</p>
</div>

<div class="field">
    <div class="control">
        <label class="checkbox">
            <input type="checkbox" @bind="SimularErro" />
            Simular estado de erro
        </label>
    </div>
</div>

<div class="field">
    <CampoSenha Id="lab-cmp001-senha" Rotulo="Senha de demonstração" Autocomplete="@AutocompleteSelecionado"
                Valor="@senha" ValorChanged="SenhaAlterada" ErroId="@ErroId" />
    @if (SimularErro)
    {
        <p class="help is-danger" id="@ErroId">Mensagem de erro de demonstração.</p>
    }
    <p class="help">Alterações de conteúdo recebidas: @alteracoes. Caracteres: @senha.Length.</p>
</div>

<p class="help">Use Tab para focar o campo e o botão; acione o botão com Enter ou Espaço para mostrar ou ocultar.</p>

@code {
    private string AutocompleteSelecionado { get; set; } = "current-password";
    private bool SimularErro { get; set; }
    private string senha = string.Empty;
    private int alteracoes;
    private string? ErroId => SimularErro ? "lab-cmp001-senha-erro" : null;

    private void SenhaAlterada(string valor)
    {
        senha = valor;
        alteracoes++;
    }
}
