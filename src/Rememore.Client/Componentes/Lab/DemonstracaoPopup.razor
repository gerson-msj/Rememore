<div class="columns is-multiline">
    <div class="column is-half">
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" @bind="passarTitulo" /> Passar título
            </label>
            <label class="label" for="popup-titulo">Título</label>
            <div class="control">
                <input class="input" id="popup-titulo" @bind="titulo" @bind:event="oninput" disabled="@(!passarTitulo)" />
            </div>
        </div>
    </div>

    <div class="column is-half">
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" @bind="passarIcone" /> Passar ícone
            </label>
            <label class="label" for="popup-icone">Classe Font Awesome</label>
            <div class="control">
                <input class="input" id="popup-icone" @bind="icone" @bind:event="oninput" disabled="@(!passarIcone)" placeholder="fa-solid fa-circle-info" />
            </div>
        </div>
    </div>

    <div class="column is-full">
        <div class="field">
            <label class="label" for="popup-mensagem">Mensagem obrigatória</label>
            <div class="control">
                <textarea class="textarea" id="popup-mensagem" @bind="mensagem" @bind:event="oninput" required rows="5"></textarea>
            </div>
            <p class="help">Parágrafos separados por uma linha em branco são apresentados separadamente.</p>
        </div>
    </div>

    <div class="column is-half">
        <div class="field">
            <label class="label" for="popup-classe">Classes do popup</label>
            <div class="control">
                <input class="input" id="popup-classe" @bind="classePopup" @bind:event="oninput" placeholder="Vazio: estilo padrão" />
            </div>
            <p class="help">Teste de sombra danger sem borda: popup--sombra-danger</p>
        </div>
    </div>

    <div class="column is-half">
        <div class="field">
            <label class="label" for="popup-texto-confirmar">Texto do botão de confirmação</label>
            <div class="control">
                <input class="input" id="popup-texto-confirmar" @bind="textoConfirmar" @bind:event="oninput" placeholder="Vazio: não mostrar" />
            </div>
        </div>
        <div class="field">
            <label class="label" for="popup-classe-confirmar">Classes do botão de confirmação</label>
            <div class="control">
                <input class="input" id="popup-classe-confirmar" @bind="classeBotaoConfirmar" @bind:event="oninput" placeholder="is-primary" />
            </div>
        </div>
    </div>

    <div class="column is-half">
        <div class="field">
            <label class="label" for="popup-texto-cancelar">Texto do botão de cancelamento</label>
            <div class="control">
                <input class="input" id="popup-texto-cancelar" @bind="textoCancelar" @bind:event="oninput" placeholder="Vazio: não mostrar" />
            </div>
        </div>
        <div class="field">
            <label class="label" for="popup-classe-cancelar">Classes do botão de cancelamento</label>
            <div class="control">
                <input class="input" id="popup-classe-cancelar" @bind="classeBotaoCancelar" @bind:event="oninput" placeholder="is-danger" />
            </div>
        </div>
    </div>

    <div class="column is-full">
        <button class="button is-link" type="button" @onclick="AbrirAsync" disabled="@string.IsNullOrWhiteSpace(mensagem)">Abrir popup</button>
        @if (ultimaResposta is not null)
        {
            <p class="help" role="status">Resposta recebida pelo chamador: @ultimaResposta</p>
        }
    </div>
</div>

<Popup Aberto="aberto"
       Titulo="@(passarTitulo ? titulo : null)"
       Mensagem="@mensagem"
       Icone="@(passarIcone ? icone : null)"
       ClassePopup="@(ValorOpcional(classePopup))"
       TextoConfirmar="@(ValorOpcional(textoConfirmar))"
       TextoCancelar="@(ValorOpcional(textoCancelar))"
       ClasseBotaoConfirmar="@(ValorOpcional(classeBotaoConfirmar))"
       ClasseBotaoCancelar="@(ValorOpcional(classeBotaoCancelar))"
       AoResponder="ReceberRespostaAsync" />

@code {
    private string mensagem = """
        Este primeiro parágrafo longo serve para observar como uma mensagem de várias linhas ocupa o espaço disponível no corpo do popup e como o texto se distribui ao lado do ícone sem apertar a leitura.

        O segundo parágrafo continua o exemplo com mais detalhes e uma extensão suficiente para quebrar em várias linhas. Assim podemos conferir a separação entre parágrafos, o espaçamento aplicado pelo Bulma e o alinhamento do bloco de texto dentro do cartão.

        Este terceiro parágrafo completa a amostra visual. Ele permite verificar a continuação da leitura até o final da mensagem e se o rodapé com as ações permanece organizado quando o conteúdo fica mais extenso.
        """;

    private string titulo = "Aviso importante";
    private string icone = "fa-solid fa-circle-info";
    private string textoConfirmar = "OK";
    private string textoCancelar = "Cancelar";
    private string classePopup = "popup--sombra-danger";
    private string classeBotaoConfirmar = string.Empty;
    private string classeBotaoCancelar = string.Empty;
    private bool passarTitulo = true;
    private bool passarIcone = true;
    private bool aberto;
    private string? ultimaResposta;

    private static string? ValorOpcional(string valor) => string.IsNullOrWhiteSpace(valor) ? null : valor;

    private Task AbrirAsync()
    {
        ultimaResposta = null;
        aberto = true;
        return Task.CompletedTask;
    }

    private Task ReceberRespostaAsync(RespostaPopup resposta)
    {
        ultimaResposta = resposta == RespostaPopup.Confirmacao ? "CONFIRMAÇÃO" : "CANCELAMENTO";
        aberto = false;
        return Task.CompletedTask;
    }
}

