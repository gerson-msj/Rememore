<div class="seletor-tema" role="radiogroup" aria-label="Tema da aparência">
    @foreach (var opcao in Opcoes)
    {
        <label class="seletor-tema__opcao" title="@opcao.Nome">
            <input class="seletor-tema__radio" type="radio" name="@nomeGrupo" value="@opcao.Valor" checked="@(Preferencia == opcao.Valor)" aria-label="@opcao.Nome" @onchange="() => Selecionar(opcao.Valor)" />
            <span class="seletor-tema__icone" aria-hidden="true"><i class="@opcao.Icone"></i></span>
            <span class="seletor-tema__rotulo">@opcao.Nome</span>
        </label>
    }
</div>

@code {
    [Parameter] public PreferenciaTema Preferencia { get; set; } = PreferenciaTema.Sistema;
    [Parameter] public EventCallback<PreferenciaTema> PreferenciaChanged { get; set; }
    private readonly string nomeGrupo = $"tema-{Guid.NewGuid():N}";

    private static readonly (PreferenciaTema Valor, string Nome, string Icone)[] Opcoes =
    [
        (PreferenciaTema.Sistema, "Sistema", "fa-solid fa-display"),
        (PreferenciaTema.Claro, "Claro", "fa-solid fa-sun"),
        (PreferenciaTema.Escuro, "Escuro", "fa-solid fa-moon")
    ];

    private Task Selecionar(PreferenciaTema valor) => PreferenciaChanged.InvokeAsync(valor);

}
