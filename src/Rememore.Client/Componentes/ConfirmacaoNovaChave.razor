@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="field confirmacao-nova-chave">
    <label class="label" for="@idCampo">Chave de redefinição</label>
    <div class="control has-icons-right">
        <input id="@idCampo"
               class="input"
               type="text"
               value="@Chave"
               readonly />
        <button class="button is-ghost icon is-right icone-controle-interativo"
                type="button"
                aria-label="Copiar chave"
                aria-controls="@idCampo"
                @onclick="CopiarChaveAsync">
            <i class="fa-solid fa-copy" aria-hidden="true"></i>
        </button>
    </div>
</div>

@code {
    private static long proximoId;
    private readonly string idCampo = $"cmp002-chave-{Interlocked.Increment(ref proximoId)}";
    private IJSObjectReference? modulo;
    [Parameter, EditorRequired] public string Chave { get; set; } = string.Empty;
    [Parameter] public EventCallback<bool> AoCopiar { get; set; }
    [Parameter] public Func<string, Task<bool>>? TentativaCopiaAlternativaAsync { get; set; }

    private async Task CopiarChaveAsync()
    {
        var sucesso = false;

        try
        {
            if (TentativaCopiaAlternativaAsync is not null)
            {
                sucesso = await TentativaCopiaAlternativaAsync(Chave);
            }
            else
            {
                modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chaveClipboard.js");
                sucesso = await modulo.InvokeAsync<bool>("copiar", Chave);
            }
        }
        catch (JSException)
        {
            // Recusa ou indisponibilidade do clipboard são reportadas como falha ao chamador.
        }
        catch (InvalidOperationException)
        {
            // A falha de interop não deve bloquear o campo selecionável.
        }

        await AoCopiar.InvokeAsync(sucesso);
    }

    public async ValueTask DisposeAsync()
    {
        if (modulo is not null)
        {
            try
            {
                await modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
