@* CMP-001 mantém o valor sob controle da página; alternar visibilidade não emite edição. *@
<div class="campo-senha">
    <label class="label" for="@Id">@Rotulo</label>
    <div class="campo-senha__controle">
        <input id="@Id" class="input" type="@(visivel ? "text" : "password")" autocomplete="@Autocomplete"
               value="@Valor" @oninput="AlterarValor" aria-describedby="@DescricaoId" />
        <button class="campo-senha__alternar" type="button" aria-label="@(visivel ? "Ocultar senha" : "Mostrar senha")"
                aria-pressed="@visivel" @onclick="AlternarVisibilidade">
            <i class="fa-solid @(visivel ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
        </button>
    </div>
    <span class="is-sr-only" id="@DescricaoId">@(visivel ? "A senha está visível." : "A senha está oculta.")</span>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "senha";
    [Parameter, EditorRequired] public string Rotulo { get; set; } = "Senha";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public EventCallback<string> ValorChanged { get; set; }

    private bool visivel;
    private string DescricaoId => $"{Id}-estado";
    private Task AlternarVisibilidade() { visivel = !visivel; return Task.CompletedTask; }
    private Task AlterarValor(ChangeEventArgs args) => ValorChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
