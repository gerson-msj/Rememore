<article class="memoria @(Inativa ? "memoria--inativa" : "")" data-modo="@Modo">
    <button class="memoria__principal" type="button" disabled="@Inativa"
            aria-label="Acionar memória @Identificador"
            @onclick="() => AoAcionar.InvokeAsync(Identificador)">
        <span class="memoria__texto">
            <span class="memoria__conteudo">@Conteudo</span>
            <span class="memoria__esmaecimento" aria-hidden="true"></span>
        </span>
    </button>
    <div class="memoria__acoes" aria-label="Ordenação da memória @Identificador">
        <button class="memoria__acao" type="button" aria-label="Elevar memória @Identificador"
                title="Elevar" disabled="@(Inativa || Primeira)"
                @onclick="() => AoElevar.InvokeAsync(Identificador)">
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
        </button>
        <button class="memoria__acao" type="button" aria-label="Rebaixar memória @Identificador"
                title="Rebaixar" disabled="@(Inativa || Ultima)"
                @onclick="() => AoRebaixar.InvokeAsync(Identificador)">
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Identificador { get; set; } = "";
    [Parameter] public string Conteudo { get; set; } = "";
    [Parameter] public ModoMemoria Modo { get; set; } = ModoMemoria.Memorar;
    [Parameter] public bool Primeira { get; set; }
    [Parameter] public bool Ultima { get; set; }
    [Parameter] public bool Inativa { get; set; }
    [Parameter] public EventCallback<string> AoAcionar { get; set; }
    [Parameter] public EventCallback<string> AoElevar { get; set; }
    [Parameter] public EventCallback<string> AoRebaixar { get; set; }
}
