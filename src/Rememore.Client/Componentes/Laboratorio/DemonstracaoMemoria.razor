<div class="demonstracao-memoria">
    <div class="memoria-controles">
        <div class="field">
            <label class="label" for="memoria-amostra">Texto da amostra</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select id="memoria-amostra" value="@amostraSelecionada" @onchange="SelecionarAmostra">
                        <option value="curta">Curta</option>
                        <option value="media">Média</option>
                        <option value="longa">Longa</option>
                        <option value="paragrafos">Com parágrafos</option>
                        <option value="palavra">Palavra longa</option>
                        <option value="especial">Caracteres especiais</option>
                        <option value="manual">Texto manual</option>
                    </select>
                </div>
            </div>
        </div>
        @if (amostraSelecionada == "manual")
        {
            <div class="field memoria-controles__manual">
                <label class="label" for="memoria-texto-manual">Conteúdo</label>
                <div class="control"><textarea id="memoria-texto-manual" class="textarea" @bind="conteudoManual"></textarea></div>
            </div>
        }
        <div class="field">
            <label class="label" for="memoria-posicao">Posição no conjunto</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select id="memoria-posicao" @bind="posicao">
                        <option value="unica">Única</option>
                        <option value="primeira">Primeira</option>
                        <option value="intermediaria">Intermediária</option>
                        <option value="ultima">Última</option>
                    </select>
                </div>
            </div>
        </div>
        <label class="checkbox memoria-controles__inativa"><input type="checkbox" @bind="inativa" /> Memória inativa</label>
    </div>

    <div class="memoria-amostra">
        <Memoria Identificador="amostra-cmp030" Conteudo="@ConteudoAtual" Primeira="@(posicao is "unica" or "primeira")"
                 Ultima="@(posicao is "unica" or "ultima")" Inativa="inativa" AoAcionar="RegistrarAcionamento"
                 AoElevar="RegistrarElevacao" AoRebaixar="RegistrarRebaixamento" />
    </div>

    <div class="help memoria-diagnostico" aria-live="polite" aria-atomic="false">
        <p>Eventos recentes</p>
        @if (eventos.Count == 0)
        {
            <p>Nenhum evento acionado.</p>
        }
        else
        {
            <ul>
                @foreach (var evento in eventos)
                {
                    <li @key="evento.Id">@evento.Texto</li>
                }
            </ul>
        }
    </div>

    <section class="demonstracao-memoria__secao-lista" aria-labelledby="memoria-lista-titulo">
        <h3 id="memoria-lista-titulo">Lista demonstrativa</h3>
        <div class="field memoria-lista-controle">
            <label class="label" for="memoria-lista-quantidade">Quantidade de memórias</label>
            <div class="control">
                <div class="select">
                    <select id="memoria-lista-quantidade" value="@quantidadeLista" @onchange="AlterarQuantidadeLista">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="5">5</option>
                        <option value="15">15</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="memoria-lista" role="list" aria-label="Memórias demonstrativas">
            @for (var indice = 0; indice < memorias.Count; indice++)
            {
                var memoria = memorias[indice];
                <div role="listitem" @key="memoria.Identificador">
                    <Memoria Identificador="@memoria.Identificador" Conteudo="@memoria.Conteudo"
                             Primeira="@(indice == 0)" Ultima="@(indice == memorias.Count - 1)" Inativa="@memoria.Inativa"
                             AoAcionar="RegistrarAcionamento" AoElevar="ElevarNaLista" AoRebaixar="RebaixarNaLista" />
                </div>
            }
        </div>
        <p class="help memoria-lista__ajuda">As setas movem uma posição. A ordem existe somente nesta demonstração.</p>
    </section>
</div>

@code {
    private string amostraSelecionada = "media";
    private string posicao = "intermediaria";
    private bool inativa;
    private string conteudoManual = "Escreva aqui uma amostra de memória para conferir a apresentação.";
    private readonly List<(int Id, string Texto)> eventos = [];
    private readonly List<MemoriaDemonstrativa> memorias = [];
    private int quantidadeLista = 5;
    private int proximoEvento;
    private static readonly string[] ConteudosDemonstrativos =
    [
        "Uma lembrança breve.",
        "Depois do almoço, caminhei até a praça e encontrei uma amiga no caminho.",
        "Hoje caminhei até a praça depois do almoço. O céu estava claro e encontrei uma amiga no caminho. Conversamos sobre os planos para o fim de semana e seguimos cada uma para o seu destino.",
        "No começo da manhã, abri a janela e senti o ar fresco.\n\nMais tarde, preparei um café e organizei as ideias para o dia.",
        "A palavra extraordinariamentecomprida ajuda a verificar o ajuste de termos longos.",
        "Acentuação: ação, coração, manhã. Emojis: 🌤️ 📚 💙. Símbolos: < > & \"aspas\".",
        "À noite, anotei os detalhes que quero recordar com carinho.",
        "Uma conversa simples tornou a tarde mais leve e me fez sorrir.",
        "O cheiro do pão recém-assado me lembrou das manhãs na casa dos meus avós.",
        "Registrei uma ideia para retomar com calma em outro dia.",
        "O passeio foi longo, cheio de pequenas descobertas e boas conversas.",
        "A chuva começou devagar e mudou os planos para o fim da tarde.",
        "Guardei a fotografia e escrevi algumas linhas sobre aquele encontro.",
        "Um momento tranquilo, sem pressa, que valeu a pena guardar.",
        "Voltei para casa contente e com vontade de repetir esse caminho."
    ];
    private string ConteudoAtual => amostraSelecionada switch
    {
        "curta" => "Uma lembrança breve.",
        "media" => "Hoje caminhei até a praça depois do almoço. O céu estava claro e encontrei uma amiga no caminho.",
        "longa" => "Hoje caminhei até a praça depois do almoço. O céu estava claro e encontrei uma amiga no caminho. Conversamos por alguns minutos sobre os planos para o fim de semana e seguimos cada uma para o seu destino. Ao voltar para casa, anotei a lembrança com calma, preservando os detalhes que quero recordar mais tarde.",
        "paragrafos" => "No começo da manhã, abri a janela e senti o ar fresco.\n\nMais tarde, preparei um café e organizei as ideias para o dia.\n\nÀ noite, fiquei contente por ter encontrado um ritmo tranquilo.",
        "palavra" => "A palavra extraordinariamentecompridaapresenta um caso de teste para conferir como o conteúdo se ajusta sem transbordar para fora da memória.",
        "especial" => "Acentuação: ação, coração, manhã. Emojis: 🌤️ 📚 💙. Símbolos: < > & \"aspas\" e sinais — !?",
        _ => conteudoManual
    };

    private void SelecionarAmostra(ChangeEventArgs args) => amostraSelecionada = args.Value?.ToString() ?? "media";
    protected override void OnInitialized() => CriarLista(quantidadeLista);

    private void AlterarQuantidadeLista(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var quantidade) && quantidade is 1 or 2 or 5 or 15)
        {
            quantidadeLista = quantidade;
            CriarLista(quantidade);
        }
    }

    private void CriarLista(int quantidade)
    {
        memorias.Clear();
        for (var indice = 0; indice < quantidade; indice++)
        {
            var identificador = $"lista-memoria-{indice + 1:D2}";
            var inativa = indice == 2 && quantidade >= 5 || indice == 9 && quantidade == 15;
            memorias.Add(new MemoriaDemonstrativa(identificador, ConteudosDemonstrativos[indice], inativa));
        }
    }

    private void ElevarNaLista(string id) => MoverNaLista(id, -1);
    private void RebaixarNaLista(string id) => MoverNaLista(id, 1);

    private void MoverNaLista(string id, int deslocamento)
    {
        var indice = memorias.FindIndex(memoria => memoria.Identificador == id);
        var destino = indice + deslocamento;
        if (indice < 0 || destino < 0 || destino >= memorias.Count || memorias[indice].Inativa) return;
        (memorias[indice], memorias[destino]) = (memorias[destino], memorias[indice]);
    }

    private void RegistrarAcionamento(string id) => RegistrarEvento("Acionar memória", id);
    private void RegistrarElevacao(string id) => RegistrarEvento("Elevar", id);
    private void RegistrarRebaixamento(string id) => RegistrarEvento("Rebaixar", id);

    private void RegistrarEvento(string acao, string id)
    {
        eventos.Insert(0, (++proximoEvento, $"{acao} · {id}"));
        if (eventos.Count > 5) eventos.RemoveAt(eventos.Count - 1);
    }

    private sealed record MemoriaDemonstrativa(string Identificador, string Conteudo, bool Inativa);
}
