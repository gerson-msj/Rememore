@inject IJSRuntime JS

<div class="demonstracao-paletas">
    @if (Tema.Preferencia == PreferenciaTema.Sistema)
    {
        <div class="notification is-warning is-light">Sistema está exibindo a paleta efetiva. Escolha Claro ou Escuro para editar uma paleta específica.</div>
    }
    <div class="paleta-acoes">
        <button class="button is-small" type="button" disabled="@(Tema.Preferencia == PreferenciaTema.Sistema)" @onclick="Tema.RestaurarPaletaAsync">Restaurar paleta aprovada</button>
        <button class="button is-small" type="button" @onclick="CopiarAsync">Copiar/exportar paleta</button>
    </div>
    @if (Tema.MensagemArmazenamento.Length > 0) { <p class="help is-danger" role="status">@Tema.MensagemArmazenamento</p> }
    @if (mensagemCopia.Length > 0) { <p class="help" role="status">@mensagemCopia</p> }
    @if (mostrarExportacao) { <label class="label" for="exportacao-paleta">Conteúdo para cópia manual</label><textarea class="textarea" id="exportacao-paleta" rows="8" readonly @ref="campoExportacao">@Tema.ExportarPaleta()</textarea> }
    <div class="paleta-grade">
        @foreach (var (nome, valor) in Tema.PaletaEfetiva)
        {
            <div class="paleta-entrada">
                <div class="paleta-amostra" style="--amostra: @valor" aria-label="Amostra de @nome"></div>
                <div class="paleta-dados"><strong>@nome</strong><code>@valor</code></div>
                @if (Tema.Preferencia != PreferenciaTema.Sistema)
                {
                    <input class="paleta-cor" type="color" aria-label="Editar cor @nome" value="@valor" @onchange="args => AlterarAsync(nome, args.Value?.ToString())" />
                    <button class="paleta-restaurar" type="button" aria-label="Restaurar @nome" title="Restaurar valor aprovado" @onclick="() => Tema.RestaurarCorAsync(nome)"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
                }
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] public EstadoTema Tema { get; set; } = default!;
    [CascadingParameter] public object? Revisao { get; set; }


    private string mensagemCopia = "";
    private bool mostrarExportacao;
    private ElementReference campoExportacao;

    private async Task AlterarAsync(string nome, string? valor)
    {
        if (valor is not null) await Tema.AtualizarCorAsync(nome, valor);
    }

    private async Task CopiarAsync()
    {
        var texto = Tema.ExportarPaleta();
        try
        {
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/laboratorio.js");
            var copiado = await modulo.InvokeAsync<bool>("copiar", texto);
            mostrarExportacao = !copiado;
            mensagemCopia = copiado ? "Paleta copiada." : "Não foi possível copiar automaticamente. Selecione o conteúdo abaixo para copiar manualmente.";
            await modulo.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            mostrarExportacao = true;
            mensagemCopia = "Não foi possível copiar automaticamente. Selecione o conteúdo abaixo para copiar manualmente.";
        }
    }
}
