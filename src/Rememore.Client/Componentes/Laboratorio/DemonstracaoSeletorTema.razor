
<div class="demonstracao-seletor">
    <p>O seletor desta demonstração compartilha a preferência com a barra fixa do laboratório.</p>
    <SeletorTema_old Preferencia="Tema.Preferencia" PreferenciaChanged="Tema.SelecionarAsync" />
    <p class="help">Escolha atual: <strong>@Tema.Preferencia</strong>. Aparência efetiva: <strong>@(Tema.AparenciaEscura ? "Escuro" : "Claro")</strong>.</p>
</div>

@code {
    [CascadingParameter] public EstadoTema Tema { get; set; } = default!;
    [CascadingParameter] public object? Revisao { get; set; }
}
