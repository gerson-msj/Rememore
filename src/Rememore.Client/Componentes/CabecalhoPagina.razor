<header class="container is-max-desktop cabecalho-pagina" style="@EstiloLargura" aria-label="Cabeçalho de página">
    <div class="section py-2">
        <div class="columns is-mobile mt-2 is-gapless is-vcentered cabecalho-pagina__colunas">
            <div class="column is-1 is-flex is-align-items-center">
                @if (MostrarVoltar)
                {
                    <button class="is-flex is-align-items-center is-justify-content-center has-text-primary-35 p-0" type="button" aria-label="Voltar" @onclick="AoRetornar">
                        <span class="icon is-size-4 p-1" aria-hidden="true">
                            <i class="fa-solid fa-chevron-left"></i>
                        </span>
                    </button>
                }
                else
                {
                    <span class="icon is-size-4 p-1 has-text-info-35" aria-hidden="true">
                        <i class="fa-solid @IconeEsquerdo"></i>
                    </span>
                }
            </div>
            <div class="column is-10 has-text-left">
                <h1 class="title is-5 is-unselectable cabecalho-pagina__titulo">@Titulo</h1>
            </div>
            <div class="column is-1 has-text-right">
                @if (MostrarSair)
                {
                    <button class="is-inline-flex is-align-items-center is-justify-content-center p-0 has-text-danger-75 pl-1" type="button" aria-label="Sair" @onclick="AoSair">
                        <span class="icon is-medium" aria-hidden="true">
                            <i class="fa-solid fa-arrow-right-from-bracket fa-lg"></i>
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public string Titulo { get; set; } = string.Empty;

    [Parameter]
    public bool MostrarVoltar { get; set; }

    [Parameter]
    public string IconeEsquerdo { get; set; } = "fa-book-open";

    [Parameter]
    public bool MostrarSair { get; set; }

    [Parameter]
    public EventCallback AoRetornar { get; set; }

    [Parameter]
    public EventCallback AoSair { get; set; }

    // Omitir preserva o limite desktop do Bulma; páginas com outro contêiner podem informar seu próprio limite CSS.
    [Parameter]
    public string? LarguraMaxima { get; set; }

    private string? EstiloLargura => string.IsNullOrWhiteSpace(LarguraMaxima)
        ? null
        : $"max-width:{LarguraMaxima};";
}
