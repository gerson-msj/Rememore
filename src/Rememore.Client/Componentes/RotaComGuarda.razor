@using System.Reflection
@inject EstadoAutenticacaoProvider Autenticacao
@inject ICapacidadesAmbiente ServicoCapacidades
@inject NavigationManager Navegacao

@if (verificando || destinoRedirecionamento is not null)
{
    <main class="estado-inicializacao" aria-busy="true" aria-label="Verificando acesso"></main>
}
else
{
    <AuthorizeRouteView RouteData="RouteData" DefaultLayout="@typeof(MainLayout)">
        <Authorizing><main class="estado-inicializacao" aria-busy="true" aria-label="Verificando acesso"></main></Authorizing>
    </AuthorizeRouteView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    private string? destinoRedirecionamento;
    private bool verificando = true;

    protected override async Task OnParametersSetAsync()
    {
        verificando = true;
        destinoRedirecionamento = null;
        await Autenticacao.VerificarSessaoAsync();
        var anonima = RouteData.PageType.GetCustomAttribute<AllowAnonymousAttribute>() is not null;
        var protegida = RouteData.PageType.GetCustomAttribute<AuthorizeAttribute>() is not null;
        var caminho = Navegacao.ToBaseRelativePath(Navegacao.Uri).Split('?', 2)[0].Trim('/');

        if (anonima && Autenticacao.Autenticado) destinoRedirecionamento = "principal";
        else if (protegida && !Autenticacao.Autenticado) destinoRedirecionamento = "entrar";
        else if (protegida && string.Equals(caminho, "admin", StringComparison.OrdinalIgnoreCase))
        {
            var estado = await Autenticacao.GetAuthenticationStateAsync();
            var conta = estado.User.Identity?.Name ?? "";
            var capacidades = await ServicoCapacidades.ObterAsync(conta);
            if (!capacidades.Administracao) destinoRedirecionamento = "principal";
        }

        verificando = false;

        if (destinoRedirecionamento is not null)
        {
            var destino = new Uri(new Uri(Navegacao.BaseUri), destinoRedirecionamento);
            Navegacao.NavigateTo(destino.ToString(), replace: true);
        }
    }
}
